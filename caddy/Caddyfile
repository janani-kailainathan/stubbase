# Stubbase — production Caddyfile
# Caddy terminates TLS for all four zones (certs via Let's Encrypt, automatic).

stubbase.dev {
	# The one non-static route on the apex, and it is forced rather than
	# chosen: Google One Tap's `g_csrf_token` is a host-only cookie, so its
	# form POST has to land on the same host that rendered the prompt or the
	# cookie never arrives. No new process — this is the Dashboard API that
	# api.app.stubbase.dev already fronts.
	handle /auth/google/one-tap {
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		root * /var/www/stubbase-landing/dist
		file_server
	}
}

# Consolidate www onto the canonical apex domain (SEO + habit-typers).
www.stubbase.dev {
	redir https://stubbase.dev{uri} permanent
}

app.stubbase.dev {
	root * /var/www/stubbase-dashboard/dist
	try_files {path} /index.html
	file_server
}

api.app.stubbase.dev {
	reverse_proxy 127.0.0.1:3001
	handle_errors 502 {
		header Access-Control-Allow-Origin https://app.stubbase.dev
		root * /var/www/stubbase-error
		rewrite * /maintenance.html
		file_server
	}
}

api.stubbase.dev {
	reverse_proxy 127.0.0.1:3000
	handle_errors 502 {
		header Access-Control-Allow-Origin *
		root * /var/www/stubbase-error
		rewrite * /maintenance.html
		file_server
	}
}
