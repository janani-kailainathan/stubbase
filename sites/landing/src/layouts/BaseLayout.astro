---
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD blocks (e.g. FAQPage) appended after the base SoftwareApplication schema. */
  schema?: Record<string, unknown>[];
  /** Open Graph type. Blog posts are `article`; everything else is a page. */
  ogType?: 'website' | 'article';
  /** ISO date, emitted as article:published_time when this is an article. */
  publishedTime?: string;
}

const { title, description, schema = [], ogType = 'website', publishedTime } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const softwareApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Stubbase',
  url: Astro.site?.toString(),
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  description:
    'Stubbase generates instant mock REST APIs from JSON. Test edge cases, simulate latency, and force HTTP errors in Cypress, Playwright, and Jest pipelines.',
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: '0',
    highPrice: '29',
    priceCurrency: 'USD',
    offerCount: 3,
  },
};

const jsonLdBlocks = [softwareApplicationSchema, ...schema];
---

<!doctype html>
<html lang="en" class="bg-background">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/stubbase-logo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta id="theme-color" name="theme-color" content="#09090B" />

    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="og:site_name" content="Stubbase" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/dashboard-ui.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    {/*
      Resolves the theme before first paint, so there is no flash of the wrong
      one. Must stay `is:inline` and stay in <head>: a bundled or deferred script
      runs after the browser has already painted.

      Stored choice wins; otherwise the OS preference decides. The class is
      always stamped explicitly (never left off), so `dark:` and `light:` never
      have to interpret an absent class. The click handler is delegated from
      `document`, which already exists here, so one listener serves every toggle
      on the page.
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var stored = null;
        try {
          stored = localStorage.getItem('stubbase-theme');
        } catch (err) {
          /* Private mode or blocked storage — fall through to the OS preference. */
        }
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';

        function apply(next) {
          root.classList.remove('light', 'dark');
          root.classList.add(next);
          var meta = document.getElementById('theme-color');
          if (meta) meta.setAttribute('content', next === 'light' ? '#FAFAFA' : '#09090B');
        }

        apply(theme);

        document.addEventListener('click', function (event) {
          var target = event.target;
          if (!target || !target.closest) return;
          if (!target.closest('[data-theme-toggle]')) return;
          var next = root.classList.contains('light') ? 'dark' : 'light';
          apply(next);
          try {
            localStorage.setItem('stubbase-theme', next);
          } catch (err) {
            /* Choice will not survive a reload; the toggle still works. */
          }
        });
      })();
    </script>
  </head>
  <body class="bg-background font-sans text-muted-foreground antialiased">
    <slot />
  </body>
</html>
