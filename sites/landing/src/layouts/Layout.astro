---
// Global page wrapper: BaseLayout supplies the <head> (SEO meta + JSON-LD) and
// the html/body shell; this adds the Header and Footer chrome so a page only has
// to render its <main>.
import BaseLayout from './BaseLayout.astro';
import FloatingNav from '../components/FloatingNav.astro';
import FramedFooter from '../components/FramedFooter.astro';
import type { FooterCta } from '../lib/cta';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD blocks, appended after the base SoftwareApplication schema. */
  schema?: Record<string, unknown>[];
  active?:
    | 'use-cases'
    | 'roles'
    | 'features'
    | 'compare'
    | 'pricing'
    | 'quick-start'
    | 'faqs'
    | 'contact'
    | 'free-api';
  /** Closing call to action, rendered as the footer's cap. */
  cta?: FooterCta;
  ogType?: 'website' | 'article';
  publishedTime?: string;
}

const { title, description, schema = [], active, cta, ogType, publishedTime } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  schema={schema}
  ogType={ogType}
  publishedTime={publishedTime}
>
  <FloatingNav active={active} />
  <main>
    <slot />
  </main>
  <FramedFooter cta={cta} />
</BaseLayout>
