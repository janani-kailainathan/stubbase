---
// Global page wrapper: BaseLayout supplies the <head> (SEO meta + JSON-LD) and
// the html/body shell; this adds the Header and Footer chrome so a page only has
// to render its <main>.
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import FloatingNav from '../components/FloatingNav.astro';
import Footer from '../components/Footer.astro';
import FramedFooter from '../components/FramedFooter.astro';
import type { FooterCta } from '../lib/cta';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD blocks, appended after the base SoftwareApplication schema. */
  schema?: Record<string, unknown>[];
  active?:
    | 'use-cases'
    | 'roles'
    | 'features'
    | 'compare'
    | 'pricing'
    | 'quick-start'
    | 'faqs'
    | 'contact';
  /** Closing call to action, rendered as the footer's cap. */
  cta?: FooterCta;
  /** Header style. `floating` is the rounded, detached bar the Home page uses. */
  nav?: 'default' | 'floating';
  /** Footer style. `framed` is the xmind-style footer the Home page uses. */
  footer?: 'default' | 'framed';
  ogType?: 'website' | 'article';
  publishedTime?: string;
}

const { title, description, schema = [], active, cta, nav = 'default', footer = 'default', ogType, publishedTime } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  schema={schema}
  ogType={ogType}
  publishedTime={publishedTime}
>
  {nav === 'floating' ? <FloatingNav active={active} /> : <Nav active={active} />}
  <main>
    <slot />
  </main>
  {footer === 'framed' ? <FramedFooter cta={cta} /> : <Footer cta={cta} />}
</BaseLayout>
