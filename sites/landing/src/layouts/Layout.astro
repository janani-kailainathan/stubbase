---
// Global page wrapper: BaseLayout supplies the <head> (SEO meta + JSON-LD) and
// the html/body shell; this adds the Header and Footer chrome so a page only has
// to render its <main>.
import BaseLayout from './BaseLayout.astro';
import FloatingNav from '../components/FloatingNav.astro';
import FramedFooter from '../components/FramedFooter.astro';
import type { FooterCta } from '../lib/cta';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD blocks, appended after the base SoftwareApplication schema. */
  schema?: Record<string, unknown>[];
  active?:
    | 'use-cases'
    | 'roles'
    | 'features'
    | 'compare'
    | 'pricing'
    | 'quick-start'
    | 'faqs'
    | 'contact'
    | 'free-api';
  /** Closing call to action, rendered as the footer's cap. */
  cta?: FooterCta;
  /** Leave the footer off, for a page that stands alone (the 404). */
  hideFooter?: boolean;
  /** Extra classes for <main>, which fills the screen below the nav — `flex flex-col`
   *  lets a page's own section grow into that space (the 404 centres in it). */
  mainClass?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
}

const { title, description, schema = [], active, cta, hideFooter = false, mainClass, ogType, publishedTime } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  schema={schema}
  ogType={ogType}
  publishedTime={publishedTime}
>
  {/* At least a screen tall, with main taking up the slack, so the footer
      sits at the bottom of a page shorter than the window (the 404). The
      wrapper spans the whole page, so the sticky nav still sticks throughout. */}
  <div class="flex min-h-dvh flex-col">
    <FloatingNav active={active} />
    <main class:list={["flex-1", mainClass]}>
      <slot />
    </main>
    {!hideFooter && <FramedFooter cta={cta} />}
  </div>
</BaseLayout>
