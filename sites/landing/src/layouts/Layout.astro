---
// Global page wrapper: BaseLayout supplies the <head> (SEO meta + JSON-LD) and
// the html/body shell; this adds the Header and Footer chrome so a page only has
// to render its <main>.
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD blocks, appended after the base SoftwareApplication schema. */
  schema?: Record<string, unknown>[];
  active?:
    | 'use-cases'
    | 'roles'
    | 'features'
    | 'compare'
    | 'pricing'
    | 'quick-start'
    | 'faqs'
    | 'contact';
  /** Closing call to action, rendered as the footer's cap. */
  cta?: { title: string; body: string; label: string; href: string };
}

const { title, description, schema = [], active, cta } = Astro.props;
---

<BaseLayout title={title} description={description} schema={schema}>
  <Nav active={active} />
  <main>
    <slot />
  </main>
  <Footer cta={cta} />
</BaseLayout>
