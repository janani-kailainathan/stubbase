---
// Wraps a content-collection entry: hero (h1 + subheadline) from the frontmatter,
// then the rendered Markdown body. Emits TechArticle + BreadcrumbList JSON-LD so
// answer engines get the page's identity and its position in the hub-and-spoke tree.
import Layout from './Layout.astro';
import { NAV_GROUPS } from '../lib/nav';

interface Props {
  collection: 'features' | 'compare';
  /** Collection-entry id, i.e. the slug segment. */
  id: string;
  title: string;
  description: string;
  h1: string;
  subheadline: string;
}

const { collection, id, title, description, h1, subheadline } = Astro.props;

const group = NAV_GROUPS.find((candidate) => candidate.key === collection)!;
const path = `/${collection}/${id}`;
const siblings = group.links.filter((link) => link.href !== path);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: h1,
  name: title,
  description,
  url: new URL(path, Astro.site).toString(),
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'Stubbase', url: Astro.site?.toString() },
  publisher: { '@type': 'Organization', name: 'Stubbase', url: Astro.site?.toString() },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: group.label },
    { '@type': 'ListItem', position: 3, name: h1, item: new URL(path, Astro.site).toString() },
  ],
};
---

<Layout
  title={title}
  description={description}
  active={collection}
  schema={[articleSchema, breadcrumbSchema]}
>
  <article>
    <header>
      <div class="mx-auto max-w-3xl px-6 pt-16 pb-14">
        <h1 class="mb-5 text-4xl leading-tight font-extrabold text-foreground">{h1}</h1>
        <p class="text-lg leading-relaxed text-muted-foreground">{subheadline}</p>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-6 py-14">
      <div class="prose-stubbase">
        <slot />
      </div>
    </div>
  </article>

  {
    siblings.length > 0 && (
      <section class="border-t border-border-c bg-section">
        <div class="mx-auto max-w-3xl px-6 py-14">
          <h2 class="mb-6 text-xs font-semibold tracking-wide text-subtle uppercase">
            More in {group.label}
          </h2>
          <ul class="grid gap-4 sm:grid-cols-2">
            {siblings.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block rounded-xl border border-border-c bg-card p-5 text-sm font-medium text-foreground transition-colors hover:border-border-strong hover:bg-muted"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Layout>
