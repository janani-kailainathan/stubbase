---
import { Check, Sparkles, Minus, Plus } from 'lucide-astro';
import '../styles/showcase.css';
import Layout from '../layouts/Layout.astro';
import { APP_URL } from '../lib/urls';

/**
 * `comingSoon` strikes an item's price through, badges it "Not active yet" and
 * swaps its call to action for an inert element. Every item is shown as live
 * now; set it back on any item that has to come off sale.
 *
 * `BILLING_LIVE` is the other half, and the one that matters to a crawler: the
 * Offer JSON-LD says PreOrder for every paid item until it is true. The page
 * shows the prices as live ahead of the payment gateway; the structured data
 * must not claim they are purchasable until they are. Flip it when checkout
 * is wired.
 */
const BILLING_LIVE = false;

/**
 * A spec line is one short fact. When it needs a qualifier, the qualifier goes
 * in `hint`, shown from a small "?" on hover or focus, so the list stays one
 * scannable line per item.
 */
type Spec = string | { text: string; hint: string };

const tiers: {
  name: string;
  comingSoon: boolean;
  price: string;
  period: string;
  tagline: string;
  cta: { label: string; style: string; href: string };
  featured: boolean;
  ai: boolean;
  specs: Spec[];
}[] = [
  {
    name: 'Free',
    comingSoon: false,
    price: '$0',
    period: '/mo',
    tagline: 'For prototypes and side projects',
    cta: { label: 'Start for free', style: 'outline', href: APP_URL },
    featured: false,
    ai: true,
    specs: [
      '10,000 requests/month',
      '5 requests/second',
      {
        text: 'Bursts of 20',
        hint: 'Up to 20 requests can arrive at once, then 5 per second after that. A page load or a test run firing several calls together stays within the limit.',
      },
      { text: '1,000 AI gift credits', hint: 'Gift credits are valid for 3 months from sign-up, once per email inbox.' },
      'CRUD API from any JSON file',
      'Relations with ?_expand=',
      'Auth, roles and permissions',
      'Webhooks',
      'QA Mode chaos headers',
    ],
  },
  {
    name: 'Pro',
    comingSoon: false,
    price: '$29',
    period: '/mo',
    tagline: 'For production MVPs and CI/CD',
    cta: { label: 'Upgrade to Pro', style: 'solid', href: APP_URL },
    featured: true,
    ai: true,
    specs: [
      'Everything in Free',
      '250,000 requests/month',
      '50 requests/second',
      {
        text: 'Bursts of 150',
        hint: 'Up to 150 requests can arrive at once, then 50 per second after that. A page load or a test run firing several calls together stays within the limit.',
      },
      '5,000 AI credits every month',
      {
        text: 'Includes $10 of AI credits',
        hint: 'The same 5,000 credits as a $9.99 Starter pack. Monthly credits are spent before any pack and end with the month.',
      },
      'Request add-ons',
    ],
  },
  {
    name: 'Enterprise',
    comingSoon: false,
    price: 'Custom',
    period: '',
    tagline: 'For teams with their own requirements',
    cta: { label: "Let's talk", style: 'muted', href: '/contact' },
    featured: false,
    ai: false,
    specs: [
      'Everything in Pro',
      'Custom request limits',
      'Custom rate limits',
      'Isolated infrastructure',
    ],
  },
];

/**
 * Request packs, sold to Pro only: a Free account that needs more requests
 * needs Pro. A pack is a one-time purchase of a pool of requests, drawn on once
 * the month's plan allowance is used up and valid for 12 months. The per-second
 * limit stays the plan's. Keep the sizes in step with ADDONS
 * (apps/dashboard-api/server-app.ts).
 */
const addons = [
  { name: '+250,000 requests', price: '$9.99', perThousand: '$0.04', comingSoon: false },
  { name: '+1,000,000 requests', price: '$24.99', perThousand: '$0.025', comingSoon: false },
];

/**
 * AI credit packs, sold on any plan. Free starts with 1,000 gift credits and Pro
 * gets 5,000 a month; a pack tops either up. Credits pay for the Co-Pilot: each reply
 * spends credits in proportion to the work it did. A pack is a one-time
 * purchase, valid for 12 months, spent after a plan's own credits.
 */
const creditPacks = [
  { name: 'Starter', credits: '5,000 credits', price: '$9.99', comingSoon: false },
  { name: 'Builder', credits: '20,000 credits', price: '$34.99', comingSoon: false },
  { name: 'Scale', credits: '60,000 credits', price: '$99.99', comingSoon: false },
];

const ctaClass = {
  solid:
    'rounded-xl bg-primary py-3 text-center text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary-hover',
  outline:
    'rounded-xl border border-primary py-3 text-center text-sm font-semibold text-primary-accent transition-colors hover:bg-primary-soft',
  muted:
    'rounded-xl border border-border-strong bg-muted py-3 text-center text-sm font-semibold text-foreground transition-colors hover:bg-muted-strong',
} as const;

/**
 * Compare plans & features, after xmind.com/pricing's table. Request rows are
 * PLANS (apps/dashboard-api/server-app.ts) as the tier cards state them;
 * Enterprise has no plan id, so its numbers are "Custom". The feature rows are
 * the point of the table: every one is on every plan — plans differ by request
 * limits alone, so never put a dash in a feature row without a plan change in
 * PLANS behind it. `true` renders a tick, a string renders as written.
 */
type Cell = string | boolean;
const compare: { group: string; rows: { label: string; cells: [Cell, Cell, Cell] }[] }[] = [
  {
    group: 'Requests',
    rows: [
      { label: 'Requests a month', cells: ['10,000', '250,000', 'Custom'] },
      { label: 'Requests a second', cells: ['5', '50', 'Custom'] },
      { label: 'Burst', cells: ['20', '150', 'Custom'] },
      { label: 'Request add-ons', cells: [false, true, 'Custom'] },
    ],
  },
  {
    group: 'AI Co-Pilot',
    rows: [
      { label: 'AI credits', cells: ['1,000 at sign-up', '5,000 a month', 'Custom'] },
      { label: 'AI credit packs', cells: [true, true, true] },
    ],
  },
  {
    group: 'Every feature, on every plan',
    rows: [
      { label: 'CRUD API from any JSON file', cells: [true, true, true] },
      { label: 'Filters, sorting, paging and relations', cells: [true, true, true] },
      { label: 'Sign-up, login and password reset', cells: [true, true, true] },
      { label: 'Google and GitHub login', cells: [true, true, true] },
      { label: 'Roles and permissions', cells: [true, true, true] },
      { label: 'Webhooks, email and SMS', cells: [true, true, true] },
      { label: 'QA mode chaos headers', cells: [true, true, true] },
      { label: 'MCP with read-only SQL', cells: [true, true, true] },
      { label: 'Live request log', cells: [true, true, true] },
      { label: 'OpenAPI spec', cells: [true, true, true] },
    ],
  },
  {
    group: 'Infrastructure',
    rows: [{ label: 'Isolated infrastructure', cells: [false, false, true] }],
  },
];

/**
 * The FAQ, after xmind.com/pricing's. Every answer is the Dashboard API's or
 * the core's: what the core meters (public plane only, refusals not counted),
 * one allowance and one rate per account, a UTC calendar month, the 429 with
 * the dashboard still reachable, the credit rules (CLAUDE.md, AI credits) and
 * request packs drawn only on Pro. Nothing here may promise checkout before
 * BILLING_LIVE is true.
 */
const faqs = [
  {
    q: 'Is the Free plan really free?',
    a: 'Yes, with no credit card and no trial that ends. It has every feature, 10,000 requests a month at 5 requests a second, and 1,000 AI credits when you sign up.',
  },
  {
    q: 'What counts as a request?',
    a: 'Every response your project\'s public API sends — reads, writes, sign-ins and the OpenAPI spec alike, including requests you send from the dashboard\'s Live tab. Working in the dashboard and the AI Co-Pilot\'s changes do not count, and neither does a request turned away because a limit was reached or the API is stopped.',
  },
  {
    q: 'Is the allowance per project?',
    a: 'No — it is one pool for your account. Every project you own draws on the same monthly allowance and the same per-second rate, so a second project never buys a second allowance.',
  },
  {
    q: 'What happens when I reach my monthly limit?',
    a: 'Your projects\' public APIs answer 429 until the month resets, at the start of each calendar month (UTC), or until a request pack on Pro adds more. The dashboard keeps working, so you can always see why.',
  },
  {
    q: 'How do AI credits work?',
    a: 'One credit is 1,000 tokens of the Co-Pilot\'s work, charged once when a reply ends; a reply that fails is free. Free accounts get 1,000 credits at sign-up, valid for 3 months; Pro gets 5,000 every month, which end with the month. Packs top up any plan, last 12 months, and are spent after your plan\'s own credits.',
  },
  {
    q: 'Can I buy request packs on the Free plan?',
    a: 'No. Request packs are for Pro: on Free, the next step up in requests is Pro itself. A pack bought on Pro waits unused if you move to Free, and still lapses 12 months after you bought it.',
  },
  {
    q: 'Do request packs raise my per-second limit?',
    a: 'No. A pack adds requests for the month once your plan\'s allowance is used up; the per-second rate and burst stay your plan\'s.',
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};

// Something that cannot be bought yet is a PreOrder, not InStock. The prices
// are real and worth publishing; claiming they are purchasable is not.
const availability = (preOrder: boolean) =>
  preOrder ? 'https://schema.org/PreOrder' : 'https://schema.org/InStock';

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Stubbase',
  description:
    'Flat, predictable limits. Start mocking APIs for free, upgrade to Pro for higher limits and monthly AI credits.',
  offers: [
    // Enterprise has no list price, so it is no Offer.
    ...tiers.filter((tier) => tier.price.startsWith('$')).map((tier) => ({
      '@type': 'Offer',
      name: tier.name,
      description: tier.tagline,
      price: tier.price.replace('$', ''),
      priceCurrency: 'USD',
      availability: availability(tier.price !== '$0' && !BILLING_LIVE),
      url: new URL('/pricing', Astro.site).toString(),
    })),
    ...creditPacks.map((pack) => ({
      '@type': 'Offer',
      name: `AI credit pack: ${pack.name} (${pack.credits})`,
      description: 'One-time AI Co-Pilot credits for any plan, valid 12 months',
      price: pack.price.replace('$', ''),
      priceCurrency: 'USD',
      availability: availability(!BILLING_LIVE),
      url: new URL('/pricing#ai-credits', Astro.site).toString(),
    })),
    ...addons.map((addon) => ({
      '@type': 'Offer',
      name: `Request add-on: ${addon.name}`,
      description: 'One-time request pack for Pro, valid 12 months',
      price: addon.price.replace('$', ''),
      priceCurrency: 'USD',
      availability: availability(!BILLING_LIVE),
      url: new URL('/pricing#add-ons', Astro.site).toString(),
    })),
  ],
};
---
<Layout
  title="Transparent API Pricing for Developers and Teams — Stubbase"
  description="Flat, predictable Stubbase limits: start mocking APIs for free, then upgrade to Pro at $29/mo for 250,000 requests a month and 5,000 AI credits every month. Enterprise on request."
  active="pricing"
  schema={[offerSchema, faqSchema]}
>
  {/* Hero, after xmind.com/pricing: a centred headline with a hand-drawn
      underline under its key words. */}
  <section>
    <div class="mx-auto max-w-3xl px-6 pt-20 pb-12 text-center">
      <h1 class="hero-rise mb-6 text-4xl leading-tight font-extrabold tracking-tight text-foreground md:text-5xl">
        Transparent <span class="relative inline-block">API Pricing<svg class="absolute -bottom-3 left-0 h-3 w-full text-primary" viewBox="0 0 200 12" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M2 8 Q50 2 100 6 T198 4" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg><svg class="absolute -top-3 -right-5 h-5 w-5 text-primary" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 0 L12 8 L20 10 L12 12 L10 20 L8 12 L0 10 L8 8 Z" fill="currentColor" /></svg></span>{' '}
        for Developers and Teams
      </h1>
      <p class="hero-rise text-lg leading-relaxed text-muted-foreground [--d:0.1s]">
        Flat, predictable limits. Every feature is on every plan: start mocking APIs for free,
        upgrade to Pro for higher limits and monthly AI credits.
      </p>
    </div>
  </section>

  <section class="bg-section">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="mb-10 text-center">
        <h2 class="mb-4 text-3xl font-extrabold text-foreground">Feature Tiers</h2>
        <p class="leading-relaxed text-muted-foreground">
          Plans differ in how many requests you can make, never in what your API can do.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          tiers.map((tier) => (
            <article
              class={`relative flex flex-col rounded-2xl border bg-background p-8 ${tier.featured && !tier.comingSoon ? 'border-primary' : 'border-border-c'}`}
            >
              <div class="mb-4 flex items-center justify-between gap-2">
                <h3 class="flex items-center gap-2 text-xl font-semibold text-foreground">
                  {tier.name}
                  {tier.ai && <Sparkles class="h-5 w-5 text-primary-ink" />}
                  {tier.comingSoon && (
                    <span class="rounded-full border border-border-strong px-2 py-0.5 text-[10px] font-semibold tracking-wide text-subtle uppercase">
                      Not active yet
                    </span>
                  )}
                </h3>
                {tier.featured && !tier.comingSoon && (
                  <span class="rounded-full bg-primary-soft px-2.5 py-1 text-[11px] font-semibold text-primary-soft-ink">Most popular</span>
                )}
              </div>
              <p class="mb-1 text-4xl font-extrabold tracking-tight text-foreground">
                {/* Struck through rather than hidden: the number is the thing
                    worth remembering, and striking it says "later", where
                    removing it would say "never". */}
                <span class={tier.comingSoon ? 'text-subtle line-through decoration-2' : ''}>{tier.price}</span>
                <span class="text-base font-medium text-subtle">{tier.period}</span>
              </p>
              <p class="mb-6 text-sm font-medium text-muted-foreground">{tier.tagline}</p>

              {/* A dead <a> is worse than no <a>: it looks clickable, and a
                  crawler follows it. An inert element carries the state. */}
              {tier.comingSoon ? (
                <p
                  class="mb-8 rounded-xl border border-dashed border-border-strong py-3 text-center text-sm font-semibold text-subtle"
                  aria-disabled="true"
                >
                  Not available yet
                </p>
              ) : (
                <a href={tier.cta.href} class={`mb-8 ${ctaClass[tier.cta.style as keyof typeof ctaClass]}`}>
                  {tier.cta.label}
                </a>
              )}

              <p class="mb-3 text-xs font-semibold tracking-wide text-subtle uppercase">What's included</p>
              <ul class="space-y-3">
                {tier.specs.map((spec, i) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
                    <Check class="mt-0.5 h-4 w-4 shrink-0 text-primary-accent" />
                    {typeof spec === 'string' ? (
                      spec
                    ) : (
                      <span class="inline-flex items-center gap-1.5">
                        {spec.text}
                        {/* CSS only: the tooltip shows on hover and on keyboard
                            focus, and a tap focuses the button on touch. */}
                        <span class="relative inline-flex">
                          <button
                            type="button"
                            aria-describedby={`hint-${tier.name}-${i}`}
                            aria-label={`About ${spec.text}`}
                            class="peer inline-flex h-4 w-4 cursor-help items-center justify-center rounded-full border border-border-strong text-[10px] leading-none font-semibold text-subtle transition-colors hover:text-foreground focus-visible:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                          >
                            ?
                          </button>
                          <span
                            id={`hint-${tier.name}-${i}`}
                            role="tooltip"
                            class="pointer-events-none invisible absolute bottom-full left-1/2 z-10 mb-2 w-52 -translate-x-1/2 rounded-md border border-border-strong bg-background px-3 py-2 text-xs leading-snug text-foreground opacity-0 transition-opacity peer-hover:visible peer-hover:opacity-100 peer-focus:visible peer-focus:opacity-100"
                          >
                            {spec.hint}
                          </span>
                        </span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Compare plans & features, after xmind.com/pricing's table. Scrolls
      sideways inside its own box on a phone rather than the page. */}
  <section id="compare">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="mb-10 text-center">
        <h2 class="mb-4 text-3xl font-extrabold text-foreground">Compare Plans &amp; Features</h2>
        <p class="leading-relaxed text-muted-foreground">The numbers change from plan to plan. The features do not.</p>
      </div>
      <div class="overflow-x-auto rounded-2xl border border-border-c">
        <table class="w-full min-w-[36rem] border-collapse text-left text-sm">
          <thead>
            <tr class="bg-card">
              <th scope="col" class="w-2/5 px-5 py-4 font-semibold text-foreground"><span class="sr-only">Feature</span></th>
              {tiers.map((tier) => (
                <th scope="col" class={`px-5 py-4 text-center font-semibold ${tier.featured ? 'text-primary-ink' : 'text-foreground'}`}>{tier.name}</th>
              ))}
            </tr>
          </thead>
          {compare.map(({ group, rows }) => (
            <tbody>
              <tr>
                <th scope="colgroup" colspan="4" class="border-t border-border-c bg-section px-5 pt-5 pb-2 text-xs font-semibold tracking-wide text-subtle uppercase">{group}</th>
              </tr>
              {rows.map(({ label, cells }) => (
                <tr class="border-t border-border-c">
                  <th scope="row" class="px-5 py-3 font-normal text-muted-foreground">{label}</th>
                  {cells.map((cell) => (
                    <td class="px-5 py-3 text-center text-foreground">
                      {cell === true ? (
                        <Check class="mx-auto h-4 w-4 text-primary-accent" aria-label="Included" />
                      ) : cell === false ? (
                        <Minus class="mx-auto h-4 w-4 text-faint" aria-label="Not included" />
                      ) : (
                        cell
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>
  </section>

  <section id="ai-credits" class="bg-section">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="mb-10 text-center">
        <h2 class="mb-4 flex items-center justify-center gap-2 text-3xl font-extrabold text-foreground">
          <Sparkles class="h-6 w-6 text-primary-ink" />
          AI Credit Packs for Any Plan
        </h2>
        <p class="mx-auto max-w-3xl leading-relaxed text-muted-foreground">
          Credits pay for the AI Co-Pilot. Each reply spends credits in proportion to the work it
          does: a small schema costs a few, seeding hundreds of rows costs more. Packs work on
          Free and Pro, are spent after your plan's own credits, and last 12 months.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          creditPacks.map((pack) => (
            <article class="flex flex-col rounded-2xl border border-border-c bg-background p-8">
              <h3 class="mb-2 flex flex-wrap items-center gap-2 text-xl font-semibold text-foreground">
                {pack.name}
                {pack.comingSoon && (
                  <span class="rounded-full border border-border-strong px-2 py-0.5 text-[10px] font-semibold tracking-wide text-subtle uppercase">
                    Not active yet
                  </span>
                )}
              </h3>
              <p class="mb-6 text-sm font-medium text-muted-foreground">
                {pack.credits} &middot; valid 12 months
              </p>
              <p class="text-4xl font-extrabold tracking-tight text-foreground">
                <span class={pack.comingSoon ? 'text-subtle line-through decoration-2' : ''}>{pack.price}</span>
                <span class="text-base font-medium text-subtle"> once</span>
              </p>
              {pack.comingSoon && (
                <p
                  class="mt-6 rounded-xl border border-dashed border-border-strong py-3 text-center text-sm font-semibold text-subtle"
                  aria-disabled="true"
                >
                  Not available yet
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="add-ons">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <div class="mb-10 text-center">
        <h2 class="mb-4 text-3xl font-extrabold text-foreground">Request Add-ons for Pro</h2>
        <p class="mx-auto max-w-3xl leading-relaxed text-muted-foreground">
          Need more requests than Pro includes? Buy a request pack once and it is there when a
          month runs past your plan's allowance. Packs stack, last 12 months, and raise your
          requests only; your per-second limit stays your plan's.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {
          addons.map((addon) => (
            <article class="flex flex-col rounded-2xl border border-border-c bg-card p-8">
              <h3 class="mb-2 flex flex-wrap items-center gap-2 text-xl font-semibold text-foreground">
                {addon.name}
                {addon.comingSoon && (
                  <span class="rounded-full border border-border-strong px-2 py-0.5 text-[10px] font-semibold tracking-wide text-subtle uppercase">
                    Not active yet
                  </span>
                )}
              </h3>
              <p class="mb-6 text-sm font-medium text-muted-foreground">
                {addon.perThousand} per 1,000 requests &middot; valid 12 months
              </p>
              <p class="text-4xl font-extrabold tracking-tight text-foreground">
                <span class={addon.comingSoon ? 'text-subtle line-through decoration-2' : ''}>{addon.price}</span>
                <span class="text-base font-medium text-subtle"> once</span>
              </p>
              {/* Inert for the tiers' reason: there is nothing to buy yet. */}
              {addon.comingSoon && (
                <p
                  class="mt-6 rounded-xl border border-dashed border-border-strong py-3 text-center text-sm font-semibold text-subtle"
                  aria-disabled="true"
                >
                  Not available yet
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-6 pt-8 pb-24">
      <h2 class="mb-12 text-center text-3xl font-extrabold text-foreground">Frequently asked questions</h2>
      <div class="flex flex-col gap-3">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-border-c bg-card" name="faq">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 [&::-webkit-details-marker]:hidden">
              <h3 class="font-semibold text-foreground">{faq.q}</h3>
              <Plus class="h-5 w-5 shrink-0 text-subtle group-open:hidden" />
              <Minus class="hidden h-5 w-5 shrink-0 text-subtle group-open:block" />
            </summary>
            <p class="px-6 pb-6 text-sm leading-relaxed text-muted-foreground">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
