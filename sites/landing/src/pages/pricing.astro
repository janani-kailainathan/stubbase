---
import { Check, Sparkles } from 'lucide-astro';
import Layout from '../layouts/Layout.astro';
import { APP_URL } from '../lib/urls';

const tiers = [
  {
    name: 'Free',
    price: '$0',
    period: '/mo',
    tagline: 'For Local Prototyping',
    cta: { label: 'Start for free', style: 'outline' },
    featured: false,
    specs: [
      {
        label: 'Compute',
        value: 'Ephemeral instances (Endpoints sleep after 5 mins of inactivity).',
      },
      { label: 'Limits', value: '5,000 requests/month. Public APIs only.' },
      {
        label: 'Features',
        value: 'Basic CRUD generation, JSON upload, ?_expand= relational routing.',
      },
    ],
  },
  {
    name: 'Pro QA',
    price: '$15',
    period: '/mo',
    tagline: 'For CI/CD & Test Automation',
    cta: { label: 'Upgrade to Pro', style: 'solid' },
    featured: true,
    specs: [
      { label: 'Compute', value: 'Always-on, zero-latency endpoints.' },
      { label: 'Limits', value: '50,000 requests/month.' },
      {
        label: 'Features',
        value:
          'Unlocks ChaosGuard (Header-driven latency, HTTP status interception, fractional error rates). Includes AuthGuard for JWT testing.',
      },
    ],
  },
  {
    name: 'Pro + AI',
    price: '$29',
    period: '/mo',
    tagline: 'For Production MVPs',
    cta: { label: 'Get AI Features', style: 'muted' },
    featured: false,
    specs: [
      { label: 'Compute', value: 'High-availability, priority execution.' },
      { label: 'Limits', value: '250,000 requests/month.' },
      {
        label: 'Features',
        value:
          'Unlocks AI Data Seeding, Prompt-to-JSON generation, dynamic GET /openapi.json export, and secure Webhook routing.',
      },
    ],
  },
];

const ctaClass = {
  solid:
    'rounded-md bg-emerald-500 py-3 text-center text-sm font-semibold text-black transition-colors hover:bg-emerald-600',
  outline:
    'rounded-md border border-emerald-500 py-3 text-center text-sm font-semibold text-emerald-500 transition-colors hover:bg-emerald-500/10',
  muted:
    'rounded-md border border-zinc-700 bg-zinc-800 py-3 text-center text-sm font-semibold text-zinc-50 transition-colors hover:bg-zinc-700',
} as const;

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Stubbase',
  description:
    'Flat, predictable limits. Start mocking APIs for free, upgrade for continuous CI/CD reliability and AI features.',
  offers: tiers.map((tier) => ({
    '@type': 'Offer',
    name: tier.name,
    description: tier.tagline,
    price: tier.price.replace('$', ''),
    priceCurrency: 'USD',
    url: new URL('/pricing', Astro.site).toString(),
  })),
};
---

<Layout
  title="Transparent API Pricing for Developers and Teams — Stubbase"
  description="Flat, predictable Stubbase limits: start mocking APIs for free, then upgrade for continuous CI/CD reliability with ChaosGuard at $15/mo and AI generation at $29/mo."
  active="pricing"
  schema={[offerSchema]}
>
  <section>
    <div class="mx-auto max-w-3xl px-6 pt-20 pb-10 text-center">
      <h1 class="mb-6 text-5xl leading-tight font-extrabold text-zinc-50">
        Transparent API Pricing for Developers and Teams
      </h1>
      <p class="text-lg leading-relaxed text-zinc-400">
        Flat, predictable limits. Start mocking APIs for free, upgrade for continuous CI/CD
        reliability and AI features.
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-6 py-16">
      <h2 class="mb-10 text-center text-3xl font-extrabold text-zinc-50">Feature Tiers</h2>

      <div class="grid gap-6 md:grid-cols-3">
        {
          tiers.map((tier) => (
            <article
              class={
                tier.featured
                  ? 'relative flex flex-col overflow-hidden rounded-xl border border-emerald-500 bg-zinc-900 p-8 shadow-lg shadow-emerald-500/5'
                  : 'flex flex-col rounded-xl border border-zinc-800 bg-zinc-900 p-8'
              }
            >
              {tier.featured && (
                <p class="absolute top-0 right-0 rounded-bl-lg bg-emerald-500 px-3 py-1 text-[10px] font-bold tracking-wider text-black uppercase">
                  Most Popular
                </p>
              )}

              <h3 class="mb-2 flex items-center gap-2 text-xl font-semibold text-zinc-50">
                {tier.name}
                {tier.name === 'Pro + AI' && <Sparkles class="h-5 w-5 text-emerald-400" />}
              </h3>
              <p class="mb-6 text-sm font-medium text-zinc-400">{tier.tagline}</p>
              <p class="mb-6 text-4xl font-extrabold text-zinc-50">
                {tier.price}
                <span class="text-base font-medium text-zinc-500">{tier.period}</span>
              </p>
              <a href={APP_URL} class={`mb-8 ${ctaClass[tier.cta.style as keyof typeof ctaClass]}`}>
                {tier.cta.label}
              </a>

              <dl class="space-y-4">
                {tier.specs.map((spec) => (
                  <div class="flex gap-3">
                    <Check class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" />
                    <div>
                      <dt class="text-sm font-semibold text-zinc-50">{spec.label}</dt>
                      <dd class="text-sm leading-relaxed text-zinc-400">{spec.value}</dd>
                    </div>
                  </div>
                ))}
              </dl>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
