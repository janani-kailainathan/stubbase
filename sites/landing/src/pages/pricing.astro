---
import { Check, Sparkles } from 'lucide-astro';
import Layout from '../layouts/Layout.astro';
import { APP_URL } from '../lib/urls';

/**
 * `comingSoon` is the launch state, not a permanent one: the paid tiers are
 * shown in full — priced, spec'd, struck through — because someone should
 * arrive at launch already knowing what the paid product will be, and a page
 * that hides its plans until billing exists teaches them nothing. Free is
 * genuinely live and keeps a working call to action.
 *
 * Flip `comingSoon` to false per tier when the gateway is wired; nothing else
 * on this page needs to change.
 */
/**
 * A spec line is one short fact. When it needs a qualifier, the qualifier goes
 * in `hint`, shown from a small "?" on hover or focus, so the list stays one
 * scannable line per item.
 */
type Spec = string | { text: string; hint: string };

const tiers: {
  name: string;
  comingSoon: boolean;
  price: string;
  period: string;
  tagline: string;
  cta: { label: string; style: string; href: string };
  featured: boolean;
  ai: boolean;
  specs: Spec[];
}[] = [
  {
    name: 'Free',
    comingSoon: false,
    price: '$0',
    period: '/mo',
    tagline: 'For prototypes and side projects',
    cta: { label: 'Start for free', style: 'outline', href: APP_URL },
    featured: false,
    ai: true,
    specs: [
      '10,000 requests/month',
      '5 requests/second',
      {
        text: 'Bursts of 20',
        hint: 'Up to 20 requests can arrive at once, then 5 per second after that. A page load or a test run firing several calls together stays within the limit.',
      },
      { text: '100 AI gift credits', hint: 'Gift credits are valid for 3 months from sign-up.' },
      'CRUD API from any JSON file',
      'Relations with ?_expand=',
      'Auth, roles and permissions',
      'Webhooks',
      'QA Mode chaos headers',
    ],
  },
  {
    name: 'Pro',
    comingSoon: true,
    price: '$29',
    period: '/mo',
    tagline: 'For production MVPs and CI/CD',
    cta: { label: 'Upgrade to Pro', style: 'solid', href: APP_URL },
    featured: true,
    ai: true,
    specs: [
      'Everything in Free',
      '250,000 requests/month',
      '50 requests/second',
      {
        text: 'Bursts of 150',
        hint: 'Up to 150 requests can arrive at once, then 50 per second after that. A page load or a test run firing several calls together stays within the limit.',
      },
      '1,000 AI credits every month',
      'Request add-ons',
    ],
  },
  {
    name: 'Enterprise',
    comingSoon: false,
    price: 'Custom',
    period: '',
    tagline: 'For teams with their own requirements',
    cta: { label: "Let's talk", style: 'muted', href: '/contact' },
    featured: false,
    ai: false,
    specs: [
      'Everything in Pro',
      'Custom request limits',
      'Custom rate limits',
      'Isolated infrastructure',
    ],
  },
];

/**
 * Request packs, sold to Pro only: a Free account that needs more requests
 * needs Pro. A pack is a one-time purchase of a pool of requests, drawn on once
 * the month's plan allowance is used up and valid for 12 months. The per-second
 * limit stays the plan's. `comingSoon` for the paid tiers' reason: priced in
 * full, nothing to buy until billing opens. Keep the sizes in step with ADDONS
 * (apps/dashboard-api/server-app.ts).
 */
const addons = [
  { name: '+250,000 requests', price: '$9.99', perThousand: '$0.04', comingSoon: true },
  { name: '+1,000,000 requests', price: '$24.99', perThousand: '$0.025', comingSoon: true },
];

/**
 * AI credit packs, sold on any plan. Free starts with 100 gift credits and Pro
 * gets 1,000 a month; a pack tops either up. Credits pay for the Co-Pilot: each reply
 * spends credits in proportion to the work it did. A pack is a one-time
 * purchase, valid for 12 months, spent after a plan's own credits.
 */
const creditPacks = [
  { name: 'Starter', credits: '5,000 credits', price: '$4.99', comingSoon: true },
  { name: 'Builder', credits: '20,000 credits', price: '$14.99', comingSoon: true },
  { name: 'Scale', credits: '60,000 credits', price: '$39.99', comingSoon: true },
];

const ctaClass = {
  solid:
    'rounded-md bg-primary py-3 text-center text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary-hover',
  outline:
    'rounded-md border border-primary py-3 text-center text-sm font-semibold text-primary-accent transition-colors hover:bg-primary-soft',
  muted:
    'rounded-md border border-border-strong bg-muted py-3 text-center text-sm font-semibold text-foreground transition-colors hover:bg-muted-strong',
} as const;

/**
 * The donation control's bounds. The slider is deliberately NOT linear: on a
 * straight 5→1000 track the amounts people actually pick ($5–$50) would share
 * the first 4.5% of it and be unhittable. The scale is exponential instead, so
 * the low end gets most of the travel and the tail is still reachable. The
 * number box is the escape hatch for an exact figure.
 *
 * The bounds are not written out anywhere on the page: the slider cannot leave
 * them, the box carries them as `min`/`max`, and a typed amount outside them is
 * clamped on commit — where the button label immediately shows the corrected
 * figure. Stating them as well was saying the same thing a third time.
 */
const DONATION = { min: 5, max: 1000, default: 10 } as const;

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Stubbase',
  description:
    'Flat, predictable limits. Start mocking APIs for free, upgrade to Pro for higher limits and monthly AI credits.',
  offers: [
    // Enterprise has no list price, so it is no Offer.
    ...tiers.filter((tier) => tier.price.startsWith('$')).map((tier) => ({
      '@type': 'Offer',
      name: tier.name,
      description: tier.tagline,
      price: tier.price.replace('$', ''),
      priceCurrency: 'USD',
      // A tier that cannot be bought yet is a PreOrder, not InStock. The prices
      // are real and worth publishing; claiming they are purchasable is not.
      availability: tier.comingSoon
        ? 'https://schema.org/PreOrder'
        : 'https://schema.org/InStock',
      url: new URL('/pricing', Astro.site).toString(),
    })),
    ...addons.map((addon) => ({
      '@type': 'Offer',
      name: `Request add-on: ${addon.name}`,
      description: 'One-time request pack for Pro, valid 12 months',
      price: addon.price.replace('$', ''),
      priceCurrency: 'USD',
      availability: addon.comingSoon
        ? 'https://schema.org/PreOrder'
        : 'https://schema.org/InStock',
      url: new URL('/pricing#add-ons', Astro.site).toString(),
    })),
    ...creditPacks.map((pack) => ({
      '@type': 'Offer',
      name: `AI credit pack: ${pack.name} (${pack.credits})`,
      description: 'One-time AI Co-Pilot credits for any plan, valid 12 months',
      price: pack.price.replace('$', ''),
      priceCurrency: 'USD',
      availability: pack.comingSoon
        ? 'https://schema.org/PreOrder'
        : 'https://schema.org/InStock',
      url: new URL('/pricing#ai-credits', Astro.site).toString(),
    })),
  ],
};
---

<Layout
  title="Transparent API Pricing for Developers and Teams — Stubbase"
  description="Flat, predictable Stubbase limits: start mocking APIs for free, then upgrade to Pro at $29/mo for 250,000 requests a month and 1,000 AI credits every month. Enterprise on request."
  active="pricing"
  schema={[offerSchema]}
>
  <section>
    <div class="mx-auto max-w-3xl px-6 pt-20 pb-10 text-center">
      <h1 class="mb-6 text-5xl leading-tight font-extrabold text-foreground">
        Transparent API Pricing for Developers and Teams
      </h1>
      <p class="text-lg leading-relaxed text-muted-foreground">
        Flat, predictable limits. Every feature is on every plan: start mocking APIs for free,
        upgrade to Pro for higher limits and monthly AI credits.
      </p>
    </div>
  </section>

  <section id="support">
    <div class="mx-auto max-w-3xl px-6 pt-10 pb-16">
      <div class="mb-10 text-center">
        <h2 class="mb-4 text-3xl font-extrabold text-foreground">Free to try. Donate to keep trying.</h2>
        <p class="leading-relaxed text-muted-foreground">
          Start on the Free plan below — no card, no donation, nothing to cancel. Until
          billing opens, the servers and every AI Co-Pilot reply are paid for out of pocket.
          A donation helps keep the Free plan, and its AI credits, free for everyone trying
          Stubbase.
        </p>
      </div>

      <div class="rounded-xl border border-border-c bg-card p-8">
        <label for="donation-amount" class="mb-4 block text-sm font-semibold text-foreground">
          Choose an amount
        </label>

        {/*
          Two controls over one value. The range is for picking a number you do
          not have in mind, the box for one you do — so both are always visible
          and neither is a fallback for the other.

          With JS off both still work: the box takes a typed amount and the
          range posts its own value. They simply stop mirroring each other,
          which is a degraded page rather than a broken one.
        */}
        <div class="flex items-center gap-4">
          <input
            id="donation-range"
            type="range"
            min="0"
            max="1000"
            value="0"
            step="1"
            aria-label="Donation amount slider"
            class="donation-range h-1.5 min-w-0 flex-1 cursor-pointer appearance-none rounded-full bg-muted"
          />
          <div class="flex shrink-0 items-center gap-1 rounded-md border border-border-c bg-background px-3 py-2 focus-within:border-primary">
            <span class="font-mono text-sm text-subtle">$</span>
            <input
              id="donation-amount"
              type="number"
              inputmode="numeric"
              min={DONATION.min}
              max={DONATION.max}
              step="1"
              value={DONATION.default}
              aria-label="Donation amount in US dollars"
              class="w-20 bg-transparent font-mono text-sm text-foreground focus:outline-none"
            />
          </div>
        </div>

        {/*
          Present but inert, the same way the dashboard shows an off-plan
          control: it says what is coming and does not pretend to take money.
          No card fields live on this page — checkout will belong to whichever
          provider is chosen, and this button will hand off to it.
        */}
        <button
          id="donation-submit"
          type="button"
          disabled
          class="mt-6 w-full cursor-not-allowed rounded-md bg-primary py-3 text-center text-sm font-semibold text-primary-foreground opacity-60"
        >
          Donate <span id="donation-label">${DONATION.default}</span> &middot; opens at launch
        </button>

        <p class="mt-3 text-center text-xs text-subtle">
          Payments are not switched on yet. Nothing is charged and no card details are
          collected on this page.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-6 pt-8 pb-20">
      <div class="mb-10 text-center">
        <h2 class="mb-4 text-3xl font-extrabold text-foreground">Feature Tiers</h2>
        <p class="leading-relaxed text-muted-foreground">
          Plans differ in how many requests you can make, never in what your API can do. Free
          is live today; Pro is what billing will look like once it opens, priced here so there
          are no surprises later.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          tiers.map((tier) => (
            <article
              class={
                tier.featured && !tier.comingSoon
                  ? 'relative flex flex-col overflow-hidden rounded-xl border border-primary bg-card p-8 shadow-lg shadow-primary/5'
                  : 'relative flex flex-col overflow-hidden rounded-xl border border-border-c bg-card p-8'
              }
            >
              {tier.featured && !tier.comingSoon && (
                <p class="absolute top-0 right-0 rounded-bl-lg bg-primary px-3 py-1 text-[10px] font-bold tracking-wider text-primary-foreground uppercase">
                  Most Popular
                </p>
              )}

              <h3 class="mb-2 flex items-center gap-2 text-xl font-semibold text-foreground">
                {tier.name}
                {tier.ai && <Sparkles class="h-5 w-5 text-primary-ink" />}
                {tier.comingSoon && (
                  <span class="rounded-full border border-border-strong px-2 py-0.5 text-[10px] font-semibold tracking-wide text-subtle uppercase">
                    Not active yet
                  </span>
                )}
              </h3>
              <p class="mb-6 text-sm font-medium text-muted-foreground">{tier.tagline}</p>
              <p class="mb-6 text-4xl font-extrabold text-foreground">
                {/* Struck through rather than hidden: the number is the thing
                    worth remembering, and striking it says "later", where
                    removing it would say "never". */}
                <span class={tier.comingSoon ? 'text-subtle line-through decoration-2' : ''}>
                  {tier.price}
                </span>
                <span class="text-base font-medium text-subtle">{tier.period}</span>
              </p>

              {/* A dead <a> is worse than no <a>: it looks clickable, and a
                  crawler follows it. An inert element carries the state. */}
              {tier.comingSoon ? (
                <p
                  class="mb-8 rounded-md border border-dashed border-border-strong py-3 text-center text-sm font-semibold text-subtle"
                  aria-disabled="true"
                >
                  Not available yet
                </p>
              ) : (
                <a href={tier.cta.href} class={`mb-8 ${ctaClass[tier.cta.style as keyof typeof ctaClass]}`}>
                  {tier.cta.label}
                </a>
              )}

              <ul class="space-y-3">
                {tier.specs.map((spec, i) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
                    <Check class="mt-0.5 h-4 w-4 shrink-0 text-primary-accent" />
                    {typeof spec === 'string' ? (
                      spec
                    ) : (
                      <span class="inline-flex items-center gap-1.5">
                        {spec.text}
                        {/* CSS only: the tooltip shows on hover and on keyboard
                            focus, and a tap focuses the button on touch. */}
                        <span class="relative inline-flex">
                          <button
                            type="button"
                            aria-describedby={`hint-${tier.name}-${i}`}
                            aria-label={`About ${spec.text}`}
                            class="peer inline-flex h-4 w-4 cursor-help items-center justify-center rounded-full border border-border-strong text-[10px] leading-none font-semibold text-subtle transition-colors hover:text-foreground focus-visible:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                          >
                            ?
                          </button>
                          <span
                            id={`hint-${tier.name}-${i}`}
                            role="tooltip"
                            class="pointer-events-none invisible absolute bottom-full left-1/2 z-10 mb-2 w-52 -translate-x-1/2 rounded-md border border-border-strong bg-background px-3 py-2 text-xs leading-snug text-foreground opacity-0 transition-opacity peer-hover:visible peer-hover:opacity-100 peer-focus:visible peer-focus:opacity-100"
                          >
                            {spec.hint}
                          </span>
                        </span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="add-ons">
    <div class="mx-auto max-w-4xl px-6 pb-20">
      <div class="mb-10 text-center">
        <h2 class="mb-4 text-3xl font-extrabold text-foreground">Request Add-ons for Pro</h2>
        <p class="mx-auto max-w-3xl leading-relaxed text-muted-foreground">
          Need more requests than Pro includes? Buy a request pack once and it is there when a
          month runs past your plan's allowance. Packs stack, last 12 months, and raise your
          requests only; your per-second limit stays your plan's.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {
          addons.map((addon) => (
            <article class="flex flex-col rounded-xl border border-border-c bg-card p-8">
              <h3 class="mb-2 flex flex-wrap items-center gap-2 text-xl font-semibold text-foreground">
                {addon.name}
                {addon.comingSoon && (
                  <span class="rounded-full border border-border-strong px-2 py-0.5 text-[10px] font-semibold tracking-wide text-subtle uppercase">
                    Not active yet
                  </span>
                )}
              </h3>
              <p class="mb-6 text-sm font-medium text-muted-foreground">
                {addon.perThousand} per 1,000 requests &middot; valid 12 months
              </p>
              <p class="mb-6 text-4xl font-extrabold text-foreground">
                <span class={addon.comingSoon ? 'text-subtle line-through decoration-2' : ''}>
                  {addon.price}
                </span>
                <span class="text-base font-medium text-subtle"> once</span>
              </p>
              {/* Inert for the tiers' reason: there is nothing to buy yet. */}
              {addon.comingSoon && (
                <p
                  class="mt-auto rounded-md border border-dashed border-border-strong py-3 text-center text-sm font-semibold text-subtle"
                  aria-disabled="true"
                >
                  Not available yet
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="ai-credits">
    <div class="mx-auto max-w-6xl px-6 pb-20">
      <div class="mb-10 text-center">
        <h2 class="mb-4 flex items-center justify-center gap-2 text-3xl font-extrabold text-foreground">
          <Sparkles class="h-6 w-6 text-primary-ink" />
          AI Credit Packs for Any Plan
        </h2>
        <p class="mx-auto max-w-3xl leading-relaxed text-muted-foreground">
          Credits pay for the AI Co-Pilot. Each reply spends credits in proportion to the work it
          does: a small schema costs a few, seeding hundreds of rows costs more. Packs work on
          Free and Pro, are spent after your plan's own credits, and last 12 months.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          creditPacks.map((pack) => (
            <article class="flex flex-col rounded-xl border border-border-c bg-card p-8">
              <h3 class="mb-2 flex flex-wrap items-center gap-2 text-xl font-semibold text-foreground">
                {pack.name}
                {pack.comingSoon && (
                  <span class="rounded-full border border-border-strong px-2 py-0.5 text-[10px] font-semibold tracking-wide text-subtle uppercase">
                    Not active yet
                  </span>
                )}
              </h3>
              <p class="mb-6 text-sm font-medium text-muted-foreground">
                {pack.credits} &middot; valid 12 months
              </p>
              <p class="mb-6 text-4xl font-extrabold text-foreground">
                <span class={pack.comingSoon ? 'text-subtle line-through decoration-2' : ''}>
                  {pack.price}
                </span>
                <span class="text-base font-medium text-subtle"> once</span>
              </p>
              {pack.comingSoon && (
                <p
                  class="mt-auto rounded-md border border-dashed border-border-strong py-3 text-center text-sm font-semibold text-subtle"
                  aria-disabled="true"
                >
                  Not available yet
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  /**
   * Keeps the slider and the amount box showing one number.
   *
   * The slider position is 0–1000 and maps EXPONENTIALLY onto $5–$1000. A
   * linear track would put every amount anyone actually picks ($5–$50) inside
   * its first 4.5%, one or two pixels apart; this gives the low end most of
   * the travel while $1000 is still reachable at the far right.
   *
   * Values are snapped as they grow — dollars up to $50, fives to $200,
   * twenty-fives beyond — so dragging never lands on $327. The box stays
   * unsnapped: someone typing an exact figure means it.
   *
   * Clamping happens on `change` (commit) rather than `input` (keystroke), or
   * typing "1" on the way to "10" would fight the user and rewrite it to "5".
   */
  const MIN = 5;
  const MAX = 1000;
  const STEPS = 1000;

  const range = document.getElementById('donation-range') as HTMLInputElement | null;
  const box = document.getElementById('donation-amount') as HTMLInputElement | null;
  const label = document.getElementById('donation-label');

  if (range && box && label) {
    const ratio = Math.log(MAX / MIN);
    const toAmount = (pos: number) => MIN * Math.exp((pos / STEPS) * ratio);
    const toPosition = (amount: number) =>
      Math.round((Math.log(amount / MIN) / ratio) * STEPS);

    const snap = (n: number) => {
      if (n < 50) return Math.round(n);
      if (n < 200) return Math.round(n / 5) * 5;
      return Math.round(n / 25) * 25;
    };

    const clamp = (n: number) => Math.min(MAX, Math.max(MIN, n));

    const show = (amount: number) => {
      label.textContent = `$${amount.toLocaleString('en-US')}`;
    };

    // The slider starts at the default amount rather than at its own left edge.
    range.value = String(toPosition(Number(box.value) || MIN));
    show(clamp(Number(box.value) || MIN));

    range.addEventListener('input', () => {
      const amount = clamp(snap(toAmount(Number(range.value))));
      box.value = String(amount);
      show(amount);
    });

    // Reflect keystrokes in the button, but do not correct the number yet.
    box.addEventListener('input', () => {
      const typed = Number(box.value);
      if (Number.isFinite(typed) && typed >= MIN && typed <= MAX) {
        range.value = String(toPosition(typed));
        show(typed);
      }
    });

    // Committed: now it has to be a legal amount.
    box.addEventListener('change', () => {
      const amount = clamp(Math.round(Number(box.value)) || MIN);
      box.value = String(amount);
      range.value = String(toPosition(amount));
      show(amount);
    });
  }
</script>

<style>
  /* The range track and thumb are the one thing Tailwind cannot reach, since
     both live behind vendor pseudo-elements. Colours are theme tokens, so this
     follows light/dark like everything else. */
  .donation-range::-webkit-slider-thumb {
    appearance: none;
    height: 1.125rem;
    width: 1.125rem;
    border-radius: 9999px;
    background: var(--primary);
    border: 2px solid var(--background);
    cursor: pointer;
  }
  .donation-range::-moz-range-thumb {
    height: 1.125rem;
    width: 1.125rem;
    border-radius: 9999px;
    background: var(--primary);
    border: 2px solid var(--background);
    cursor: pointer;
  }
  .donation-range:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }
</style>
