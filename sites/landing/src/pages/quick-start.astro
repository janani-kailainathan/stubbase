---
/*
  Quick Start, in the feature pages' look (after xmind.com/ai's centred hero
  on a faint grid): four numbered steps and a FAQ. The step H2s are SEO
  targets — keep their wording.

  Simulation is header-driven only — there is no ?delay= / ?status= query
  parameter. Test logic belongs in your runner's request headers, never in the
  URLs your frontend code builds. The headers are read in chaosGuard's order:
  the delay first, then `status`, which answers every request it is sent on —
  so it and `error-rate` are two separate tools, never one rate on a status.
*/
import { Plus, Minus, ArrowRight, Database, FlaskConical, LayoutGrid } from 'lucide-astro';
import '../styles/showcase.css';
import Layout from '../layouts/Layout.astro';
import CodeBlock from '../components/CodeBlock.astro';

const DELAY_EXAMPLE = `// Wait 500ms before returning data
await fetch('https://api.stubbase.dev/<tenant>/users', {
  headers: {
    'x-stubbase-delay': '500'
  }
});`;

const FAILURE_EXAMPLE = `// Every request answers 503 — exercise the error boundary
await fetch('https://api.stubbase.dev/<tenant>/users', {
  headers: { 'x-stubbase-status': '503' }
});

// About 3 requests in 10 answer 503 — retry and backoff testing
await fetch('https://api.stubbase.dev/<tenant>/users', {
  headers: { 'x-stubbase-error-rate': '0.3' }
});`;

const EMPTY_EXAMPLE = `// A list answers [] and a single record answers null
await fetch('https://api.stubbase.dev/<tenant>/users', {
  headers: { 'x-stubbase-empty': 'true' }
});`;

const steps = [
  {
    title: 'Fetch a Public API',
    body: "Don't want to create an account? Just copy one of our public URLs directly into your React, Vue, or iOS app.",
  },
  {
    title: 'Simulate Latency (QA Mode)',
    body: 'Send the <code class="rounded bg-muted px-1 font-mono text-primary-ink">x-stubbase-delay</code> header to force the server to wait before responding. Because it\'s a header, Playwright and Cypress can inject it from the test runner — your frontend URLs stay clean.',
    code: DELAY_EXAMPLE,
    file: 'latency.test.js',
  },
  {
    title: 'Force HTTP Errors (QA Mode)',
    body: '<code class="rounded bg-muted px-1 font-mono text-primary-ink">x-stubbase-status</code> answers every request with the status code you name. For intermittent flakiness, send <code class="rounded bg-muted px-1 font-mono text-primary-ink">x-stubbase-error-rate</code> on its own instead: <code class="rounded bg-muted px-1 font-mono text-primary-ink">0.3</code> answers roughly three requests in ten with a 503, <code class="rounded bg-muted px-1 font-mono text-primary-ink">1.0</code> every one.',
    code: FAILURE_EXAMPLE,
    file: 'errors.test.js',
  },
  {
    title: 'Return an Empty List (QA Mode)',
    body: '<code class="rounded bg-muted px-1 font-mono text-primary-ink">x-stubbase-empty: true</code> answers a list with <code class="rounded bg-muted px-1 font-mono text-primary-ink">[]</code> and a single record with <code class="rounded bg-muted px-1 font-mono text-primary-ink">null</code>, without touching the stored data — the empty state UIs most often forget.',
    code: EMPTY_EXAMPLE,
    file: 'empty.test.js',
  },
];

const next = [
  { Icon: Database, title: 'Free API', body: 'Six practice resources with every field, filter and query.', href: '/free-api' },
  { Icon: FlaskConical, title: 'For QA engineers', body: 'Failure injection from Playwright, Cypress or any runner.', href: '/roles/qa-engineer' },
  { Icon: LayoutGrid, title: 'All features', body: 'Everything a project can do, on every plan.', href: '/features' },
];

const faqs = [
  {
    q: 'Do the headers work on my own project straight away?',
    a: 'Only once QA_MODE=true is in the project\'s settings and deployed. Without it every x-stubbase-* header is ignored, so nobody who guesses the names can disrupt a live API.',
  },
  {
    q: 'Can I send status and error-rate together?',
    a: 'You can, but x-stubbase-status wins on every request: it is checked first and answers each one. Use status to test the failure path every time, and error-rate on its own to test retries.',
  },
  {
    q: 'Can the headers get past authentication?',
    a: 'No. The simulation runs after authentication and permission checks, so no combination of headers returns data to a caller who was not already allowed to have it.',
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};
---

<Layout
  title="Quick Start — Stubbase"
  description="Fetch a public Stubbase API in one line of code, then simulate latency, HTTP errors and empty responses with a request header."
  active="quick-start"
  schema={[faqSchema]}
>
  <section class="relative overflow-hidden">
    <div class="feature-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-6 pt-20 pb-10 text-center lg:pt-28">
      <p class="hero-rise mb-4 text-lg font-bold text-primary-ink">API reference</p>
      <h1 class="hero-rise mb-5 text-4xl font-extrabold tracking-tight text-foreground md:text-5xl [--d:0.05s]">Quick Start</h1>
      <p class="hero-rise text-lg leading-relaxed text-muted-foreground [--d:0.1s]">
        One line to call a live API, then three headers to make it slow, broken or empty —
        whenever your tests need it.
      </p>
    </div>
  </section>

  <section>
    <ol class="mx-auto flex max-w-3xl flex-col gap-6 px-6 pb-20">
      {steps.map((step, i) => (
        <li class="reveal flex items-start gap-5 rounded-2xl border border-border-c bg-card p-6 sm:p-7">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-primary-soft-border-strong bg-primary-soft font-mono font-bold text-primary-accent">{i + 1}</span>
          <div class="min-w-0 flex-1">
            <h2 class="mb-2 font-semibold text-foreground">{step.title}</h2>
            <p class="mb-4 text-sm leading-relaxed text-muted-foreground"><Fragment set:html={step.body} /></p>
            {step.code ? (
              <CodeBlock code={step.code} lang="js" filename={step.file} />
            ) : (
              <div class="overflow-x-auto rounded-md border border-border-c bg-code-bg p-4">
                <code class="font-mono text-sm whitespace-nowrap text-emphasis">
                  <span class="text-syntax-bool">const</span> res = <span class="text-syntax-bool">await</span> fetch(<span class="text-syntax-fn">'https://api.stubbase.dev/public/users'</span>);<br />
                  <span class="text-syntax-bool">const</span> data = <span class="text-syntax-bool">await</span> res.json();
                </code>
              </div>
            )}
          </div>
        </li>
      ))}
      <li class="text-sm leading-relaxed text-subtle">
        Simulation headers only take effect once <strong class="text-emphasis">QA Mode</strong> is enabled
        on the project — that gate is what stops anyone who guesses the header names from disrupting
        a live API. Delays are capped at 10 seconds. The shared
        <code class="rounded bg-muted px-1 font-mono text-primary-ink">/public</code> demo endpoints
        serve data only and ignore these headers.
      </li>
    </ol>
  </section>

  <section class="bg-section">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <h2 class="reveal mb-10 text-center text-3xl font-bold tracking-tight text-foreground">Where to next</h2>
      <ul class="reveal grid grid-cols-1 gap-5 md:grid-cols-3">
        {next.map(({ Icon, title, body, href }) => (
          <li>
            <a href={href} class="group flex h-full flex-col rounded-2xl border border-border-c bg-background p-6 transition-colors hover:border-border-strong">
              <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-primary-soft text-primary-accent"><Icon class="h-5 w-5" /></span>
              <span class="mb-2 font-semibold text-foreground">{title}</span>
              <span class="mb-4 text-sm leading-relaxed text-muted-foreground">{body}</span>
              <span class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-primary-ink group-hover:text-primary-ink-hover">Open <ArrowRight class="h-4 w-4" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-6 py-20">
      <h2 class="reveal mb-10 text-center text-3xl font-bold tracking-tight text-foreground">Frequently asked questions</h2>
      <div class="flex flex-col gap-3">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-border-c bg-card" name="faq">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 [&::-webkit-details-marker]:hidden">
              <h3 class="font-semibold text-foreground">{faq.q}</h3>
              <Plus class="h-5 w-5 shrink-0 text-subtle group-open:hidden" />
              <Minus class="hidden h-5 w-5 shrink-0 text-subtle group-open:block" />
            </summary>
            <p class="px-6 pb-6 text-sm leading-relaxed text-muted-foreground">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
