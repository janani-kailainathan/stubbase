---
import { ArrowLeft } from 'lucide-astro';
// The same handwritten accent as Home's hero, imported here for the same reason:
// only the pages that use it download it.
import '@fontsource/sedgwick-ave/latin-400.css';
import Layout from '../layouts/Layout.astro';
---

{/*
  Built to dist/404.html; Caddy serves it for any path on the apex that has no
  file, keeping the 404 status. It is static like every page here.
*/}
<Layout
  title="Page not found — Stubbase"
  description="This page doesn't exist. Head back to the Stubbase home page."
  hideFooter
  mainClass="flex flex-col"
>
  {/* Fills the screen below the nav and centres its content in it, a little
      above true centre (more padding below than above), where it reads as centred. */}
  <section class="hero relative flex flex-1 items-center overflow-hidden">
    <div class="hero-dots pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-4xl px-6 pt-8 pb-36 text-center">
      <h1 class="hero-rise text-4xl leading-[1.08] font-extrabold tracking-tight text-foreground sm:text-5xl lg:text-6xl [--d:0.05s]">
        This route doesn't <span class="hero-accent">exist</span>
      </h1>
      <p class="hero-rise mx-auto mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground [--d:0.1s]">
        The page may have moved, or the link has a typo.
      </p>

      <div class="hero-rise mt-8 flex flex-wrap items-center justify-center gap-3 [--d:0.2s]">
        {/* A two-layer button, as on Home. */}
        <a href="/" class="group rounded-2xl bg-muted-hover p-1">
          <span class="flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-base font-semibold text-primary-foreground transition-colors group-hover:bg-primary-hover">
            <ArrowLeft class="h-4 w-4" />
            Back to home
          </span>
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Home's hero canvas, accent and entrance — repeated rather than shared,
     since Home keeps them in its own page styles. */
  .hero-dots {
    background-image: radial-gradient(var(--border-strong) 1px, transparent 1px);
    background-size: 20px 20px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 30%, transparent 75%);
    opacity: 0.6;
  }

  .hero-accent {
    display: inline-block;
    padding: 0 0.12em;
    font-family: 'Sedgwick Ave', cursive;
    font-weight: 400;
    color: var(--primary-ink);
    background: var(--primary-soft);
    rotate: -2deg;
  }

  .hero-rise {
    animation: hero-in 700ms cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both;
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      filter: blur(8px);
      translate: 0 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-rise {
      animation: none;
    }
  }
</style>
