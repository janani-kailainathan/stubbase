---
// One page of the user guide. A manual page, not an article: no byline, no
// reading time, no visible breadcrumb (the rail already says where you are) —
// a title, one line on what the page is for, the figure, the steps, and the
// way on to the next task.
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowRight } from 'lucide-astro';
import UserGuideLayout from '../../layouts/UserGuideLayout.astro';
import { CHAPTER_KEYS, GUIDE_CHAPTERS } from '../../lib/user-guide';

export async function getStaticPaths() {
  // The whole guide in reading order, so previous and next cross chapter
  // boundaries the way the rail does.
  const entries = (await getCollection('userGuide'))
    .filter((entry) => !entry.data.draft)
    .sort(
      (a, b) =>
        CHAPTER_KEYS.indexOf(a.data.chapter) - CHAPTER_KEYS.indexOf(b.data.chapter) ||
        a.data.order - b.data.order,
    );
  const link = (entry?: (typeof entries)[number]) =>
    entry && { href: `/user-guide/${entry.id}`, label: entry.data.label };
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, previous: link(entries[index - 1]), next: link(entries[index + 1]) },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const { title, description, h1, subheadline, hero, publishedAt, updatedAt, chapter } = entry.data;
const chapterLabel = GUIDE_CHAPTERS.find((candidate) => candidate.key === chapter)!.label;

const url = new URL(`/user-guide/${entry.id}`, Astro.site).toString();
const guideUrl = new URL('/user-guide', Astro.site).toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: h1,
  name: title,
  description,
  url,
  inLanguage: 'en',
  articleSection: chapterLabel,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: { '@type': 'Organization', name: 'Stubbase', url: Astro.site?.toString() },
  publisher: { '@type': 'Organization', name: 'Stubbase', url: Astro.site?.toString() },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  isPartOf: { '@type': 'CollectionPage', name: 'Stubbase User Guide', url: guideUrl },
};

// Invisible, and describes the real hierarchy; the visible trail is banned.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: 'User guide', item: guideUrl },
    { '@type': 'ListItem', position: 3, name: h1, item: url },
  ],
};
---

<UserGuideLayout
  title={title}
  description={description}
  schema={[articleSchema, breadcrumbSchema]}
  current={entry.id}
>
  <article class="max-w-3xl pb-6">
    <header class="pt-10 lg:pt-14">
      <p class="font-mono text-xs tracking-wide text-subtle uppercase">{chapterLabel}</p>
      <h1 class="mt-3 text-4xl leading-[1.1] font-extrabold tracking-tight text-balance text-foreground sm:text-[2.75rem]">
        {h1}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-pretty text-muted-foreground">{subheadline}</p>
    </header>

    {
      hero && (
        <div class="pt-10">
          <figure class:list={['shot', !hero.src && 'shot--pending']}>
            {hero.src ? (
              <img src={hero.src} alt={hero.alt} fetchpriority="high" decoding="async" />
            ) : (
              <div class="shot-frame" role="img" aria-label={`Screenshot to come: ${hero.alt}`}>
                <span class="shot-file">/user-guide/{entry.id}/hero.png</span>
              </div>
            )}
            {hero.caption && <figcaption>{hero.caption}</figcaption>}
          </figure>
        </div>
      )
    }

    <div class="prose-stubbase mt-12">
      <Content />
    </div>

    {
      (previous || next) && (
        <nav aria-label="More of the user guide" class="mt-16 grid gap-4 sm:grid-cols-2">
          {previous ? (
            <a href={previous.href} class="page-step">
              <span class="page-step-dir">
                <ArrowLeft class="h-3.5 w-3.5" />
                Previous
              </span>
              <span class="page-step-label">{previous.label}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a href={next.href} class="page-step sm:text-right">
              <span class="page-step-dir sm:justify-end">
                Next
                <ArrowRight class="h-3.5 w-3.5" />
              </span>
              <span class="page-step-label">{next.label}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</UserGuideLayout>

<style>
  .page-step {
    display: grid;
    gap: 0.375rem;
    border: 1px solid var(--border-c);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    transition: border-color 150ms ease-out;
  }
  .page-step:hover {
    border-color: var(--border-strong);
  }
  .page-step-dir {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--subtle);
  }
  .page-step-label {
    font-weight: 600;
    color: var(--foreground);
  }
  .page-step:hover .page-step-label {
    color: var(--primary-ink);
  }
</style>
