---
import { Sparkles, FileJson, Rocket, ShieldCheck, OctagonAlert, Webhook, Terminal, Play, Check, Loader } from 'lucide-astro';
import Layout from '../layouts/Layout.astro';
import { APP_URL, CORE_URL } from '../lib/urls';

const publicResources = [
  { path: '/posts', count: '100 posts' },
  { path: '/comments', count: '500 comments' },
  { path: '/albums', count: '100 albums' },
  { path: '/photos', count: '5000 photos' },
  { path: '/todos', count: '200 todos' },
  { path: '/users', count: '10 users' },
];

const capabilities = [
  {
    Icon: Sparkles,
    title: 'AI-Powered Generation',
    copy: 'Describe your schema in plain English. Our AI engine outputs a fully populated, relational database with production-ready endpoints.',
  },
  {
    Icon: FileJson,
    title: 'JSON-to-REST',
    copy: 'Upload a flat JSON file. Stubbase automatically infers relationships, mounts CRUD operations, and enables nested routing.',
  },
  {
    Icon: Rocket,
    title: 'Zero-Downtime Deployments',
    copy: 'Click "Deploy" to instantly push schema changes live without breaking existing client connections.',
  },
];

const pipeline = [
  {
    Icon: ShieldCheck,
    name: 'AuthGuard',
    copy: 'Instantly secure your endpoints. Enable Google OAuth and JWT validation without writing authentication logic.',
  },
  {
    Icon: OctagonAlert,
    name: 'ChaosGuard',
    copy: 'Inject deterministic latency, error rates, and 5xx status codes to test frontend error boundaries.',
  },
  {
    Icon: Webhook,
    name: 'Webhook Proxying',
    copy: 'Securely trigger external services (Resend, Twilio) from your client-side code without exposing secret API keys.',
  },
];
---

<Layout
  title="Stubbase — The Instant Backend for Frontend & QA Teams"
  description="Generate persistent, relational REST APIs from a JSON file or AI prompt in seconds. Zero database configuration. Built for autonomous frontend development and deterministic chaos testing."
>
  <section class="relative overflow-hidden">
    <div
      class="hero-glow pointer-events-none absolute top-0 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-primary blur-[120px]"
    >
    </div>
    <div class="relative mx-auto max-w-5xl px-6 pt-24 pb-20 text-center">
      <p class="mb-4 text-xs font-semibold tracking-wide text-primary-accent uppercase">
        No login required. Generate an endpoint in 2 seconds.
      </p>
      <h1 class="mb-6 text-5xl leading-tight font-extrabold text-foreground">
        The Instant Backend for<br />Frontend &amp; QA Teams
      </h1>
      <p class="mx-auto mb-8 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        Generate persistent, relational REST APIs from a JSON file or AI prompt in seconds. Zero
        database configuration. Built for autonomous frontend development and deterministic chaos
        testing.
      </p>

      <div class="flex items-center justify-center gap-4">
        <a
          href={APP_URL}
          class="inline-block rounded-md bg-primary px-6 py-3 font-semibold text-primary-foreground transition-colors hover:bg-primary-hover"
        >
          Generate API (Free)
        </a>
        <a
          href="#free-resources"
          class="inline-block rounded-md border border-border-c bg-card px-6 py-3 font-semibold text-foreground transition-colors hover:bg-muted"
        >
          Use Public APIs
        </a>
      </div>

      <div class="relative mx-auto mt-14 max-w-5xl">
        <div
          class="absolute -inset-1 rounded-xl bg-gradient-to-r from-primary/20 to-muted/20 opacity-50 blur-lg"
        >
        </div>
        <div
          class="relative overflow-hidden rounded-xl border border-border-c bg-background p-2 shadow-2xl"
        >
          <img
            src="/dashboard-ui.png"
            alt="Stubbase Dashboard UI"
            class="w-full rounded-lg border border-border-faint"
          />
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-5xl px-6 py-20">
      <h2 class="mb-4 text-3xl font-extrabold text-foreground">Stop Writing Boilerplate APIs</h2>
      <p class="mb-12 max-w-3xl leading-relaxed text-muted-foreground">
        Stubbase provides fully functional REST endpoints out-of-the-box, allowing frontend and
        testing teams to unblock themselves instantly.
      </p>
      <div class="grid gap-6 md:grid-cols-3">
        {
          capabilities.map(({ Icon, title, copy }) => (
            <article class="rounded-xl border border-border-c bg-card p-6">
              <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-soft">
                <Icon class="h-5 w-5 text-primary-accent" />
              </div>
              <h3 class="mb-2 font-semibold text-foreground">{title}</h3>
              <p class="text-sm leading-relaxed text-muted-foreground">{copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-5xl px-6 py-20">
      <h2 class="mb-4 text-3xl font-extrabold text-foreground">A Complete API Pipeline</h2>
      <p class="mb-12 max-w-3xl leading-relaxed text-muted-foreground">
        Every endpoint deployed on Stubbase routes through our dynamic middleware pipeline,
        controlled entirely via your dashboard.
      </p>
      <ul class="grid gap-6 md:grid-cols-3">
        {
          pipeline.map(({ Icon, name, copy }) => (
            <li class="rounded-xl border border-border-c bg-card p-6">
              <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-soft">
                <Icon class="h-5 w-5 text-primary-accent" />
              </div>
              <h3 class="mb-2 font-semibold text-foreground">{name}</h3>
              <p class="text-sm leading-relaxed text-muted-foreground">{copy}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-background">
    <div class="mx-auto max-w-3xl px-6 py-24 text-center">
      <h2 class="mb-4 text-3xl font-extrabold text-foreground">Try it live</h2>
      <p class="mb-8 text-muted-foreground">
        Run this code here, in your console, or from any frontend application.
      </p>

      <div class="mb-6 overflow-hidden rounded-xl border border-border-c bg-code-bg text-left shadow-xl">
        <div class="flex items-center gap-2 border-b border-border-c bg-chrome px-4 py-3">
          <Terminal class="h-4 w-4 text-subtle" />
          <span class="font-mono text-xs text-subtle">fetch.js</span>
        </div>
        <pre
          class="overflow-x-auto p-6 font-mono text-sm leading-relaxed text-emphasis"><code><span class="text-syntax-fn">fetch</span>(<span class="text-syntax-str">'{CORE_URL}/public/users/1'</span>)
  .<span class="text-syntax-fn">then</span>(response =&gt; response.<span class="text-syntax-fn">json</span>())
  .<span class="text-syntax-fn">then</span>(json =&gt; console.<span class="text-syntax-fn">log</span>(json))</code></pre>
      </div>

      <div class="mb-6 text-left">
        <button
          id="run-script-btn"
          class="flex items-center gap-2 rounded-md bg-contrast px-5 py-2 text-sm font-semibold text-contrast-foreground shadow-sm transition-colors hover:bg-contrast-hover"
        >
          <span class="flex items-center gap-2 data-[hidden]:hidden" data-state="idle">
            <Play class="h-4 w-4" /> Run script
          </span>
          <span class="hidden items-center gap-2 data-[hidden]:hidden" data-state="loading">
            <Loader class="h-4 w-4 animate-spin" /> Running...
          </span>
          <span class="hidden items-center gap-2 data-[hidden]:hidden" data-state="done">
            <Check class="h-4 w-4 text-primary-accent" /> Done
          </span>
        </button>
      </div>

      <div
        id="output-container"
        class="hidden overflow-hidden rounded-xl border border-border-c bg-code-bg text-left shadow-xl"
      >
        <div class="flex items-center gap-2 border-b border-border-c bg-chrome px-4 py-3">
          <FileJson class="h-4 w-4 text-subtle" />
          <span class="font-mono text-xs text-subtle">Output</span>
        </div>
        <div
          id="script-output"
          class="overflow-x-auto p-6 font-mono text-sm leading-relaxed text-emphasis"
        >
        </div>
      </div>

      <p id="success-msg" class="mt-6 hidden text-left text-sm text-muted-foreground">
        Congrats! You've made your first call to Stubbase. 🎉
      </p>
    </div>
  </section>

  <section id="free-resources">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <div class="mb-12 text-center">
        <h2 class="mb-4 text-3xl font-extrabold text-foreground">Free Resources</h2>
        <p class="text-muted-foreground">
          Stubbase comes with a set of 6 common resources for quick frontend prototyping.<br />
          No account required.
        </p>
      </div>

      <div class="mx-auto max-w-2xl">
        <div class="overflow-hidden rounded-xl border border-border-c bg-card shadow-sm">
          <div
            class="flex items-center justify-between border-b border-border-c bg-chrome-deep px-6 py-4"
          >
            <span class="text-xs font-semibold tracking-wide text-subtle uppercase">Base URL</span>
            <code class="font-mono text-sm text-emphasis">{CORE_URL}/public</code>
          </div>

          {
            publicResources.map((resource, i) => (
              <div
                class={`group flex items-center justify-between px-6 py-4 transition-colors hover:bg-muted-hover ${i < publicResources.length - 1 ? 'border-b border-border-c' : ''}`}
              >
                <a
                  href={`${CORE_URL}/public${resource.path}`}
                  class="font-mono text-sm text-primary-ink underline-offset-4 hover:text-primary-ink-hover hover:underline"
                >
                  {resource.path}
                </a>
                <span class="text-sm text-muted-foreground transition-colors group-hover:text-emphasis">
                  {resource.count}
                </span>
              </div>
            ))
          }
        </div>

        <div class="mt-8 rounded-lg border border-primary-soft-border bg-primary-soft p-4 text-center">
          <p class="text-sm text-primary-ink">
            <strong>Need custom fields?</strong> Edit these APIs in the{' '}
            <a href={APP_URL} class="font-semibold underline hover:text-primary-ink-hover">
              Stubbase Dashboard
            </a>{' '}
            to add delays, errors, or your own data.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  import { CORE_URL } from '../lib/urls';

  const btn = document.getElementById('run-script-btn') as HTMLButtonElement | null;
  const outContainer = document.getElementById('output-container');
  const outText = document.getElementById('script-output');
  const successMsg = document.getElementById('success-msg');

  const FALLBACK_USER = { id: 1, name: 'Ava Chen', role: 'admin', active: true };

  function setButtonState(state: 'idle' | 'loading' | 'done') {
    btn?.querySelectorAll<HTMLElement>('[data-state]').forEach((span) => {
      span.classList.toggle('hidden', span.dataset.state !== state);
      span.classList.toggle('flex', span.dataset.state === state);
    });
    if (state === 'done' && btn) {
      btn.classList.remove('bg-contrast', 'hover:bg-contrast-hover', 'text-contrast-foreground');
      btn.classList.add('border', 'border-border-c', 'bg-card', 'text-foreground');
    }
  }

  function highlightJson(value: unknown): string {
    const json = JSON.stringify(value, null, 2)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
    const tokenRe =
      /("(?:\\u[0-9a-fA-F]{4}|\\[^u]|[^\\"])*")(\s*:)?|\b(true|false|null)\b|(-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)|([{}[\],])/g;
    return json.replace(tokenRe, (match, str, colon, boolNull, num, punct) => {
      if (str) {
        const cls = colon ? 'text-syntax-str' : 'text-syntax-fn';
        return `<span class="${cls}">${str}</span>${colon ?? ''}`;
      }
      if (boolNull) return `<span class="text-syntax-bool">${boolNull}</span>`;
      if (num) return `<span class="text-syntax-num">${num}</span>`;
      if (punct) return `<span class="text-subtle">${punct}</span>`;
      return match;
    });
  }

  btn?.addEventListener('click', async () => {
    btn.disabled = true;
    setButtonState('loading');

    let data: unknown;
    try {
      const response = await fetch(`${CORE_URL}/public/users/1`);
      if (!response.ok) throw new Error(String(response.status));
      data = await response.json();
    } catch {
      data = FALLBACK_USER;
    }

    if (outText) outText.innerHTML = `<pre class="whitespace-pre-wrap">${highlightJson(data)}</pre>`;
    outContainer?.classList.remove('hidden');
    successMsg?.classList.remove('hidden');
    setButtonState('done');
    btn.disabled = false;
  });
</script>

<script>
  import { GOOGLE_CLIENT_ID } from '../lib/urls';

  /*
    Google One Tap.

    `ux_mode: 'redirect'` and `login_uri` do **not** apply to One Tap, however
    much they look like they should: Google's reference says ux_mode "has no
    impact on the OneTap UX", and One Tap hands its credential to `callback`.
    Configured the other way the prompt renders and the tap does nothing at all
    — the token goes to a callback that was never declared, and no POST is ever
    made. So the credential does pass through this page, and no configuration
    avoids that: under FedCM the browser mediates the prompt and returns the
    token to JavaScript.

    That costs one sentence of the original design, not the rule it protected.
    The callback immediately form-POSTs the token to /auth/google/one-tap on
    THIS origin, the Dashboard API verifies it and 302s to the SPA with the
    session in a URL fragment — so a *Stubbase session token* still never exists
    on the stubbase.dev origin. What briefly does is Google's own ID token:
    short-lived, and pinned by `aud` to our client id, which the API re-checks.

    It has to be a form submission, not fetch — fetch follows the 302 itself and
    the fragment the session rides in never reaches the address bar.

    The endpoint stays on this host because Caddy proxies that one path to the
    API and because the CSRF cookie below is host-only. The authorized redirect
    URI registered for it is now unused (Google no longer posts anything), but
    the JavaScript origin registration is what lets the prompt render at all.
  */

  /*
    Google's script is fetched from here rather than from a tag in the markup,
    so the decision not to prompt is also a decision not to call Google at all:
    a signed-in visitor, or a build with no client id, makes no third-party
    request from this page. It is the only third-party script on the site, and
    this keeps it to the visitors it is actually for.
  */
  function loadGsi(): Promise<void> {
    return new Promise((resolve, reject) => {
      const tag = document.createElement('script');
      tag.src = 'https://accounts.google.com/gsi/client';
      tag.async = true;
      tag.onload = () => resolve();
      tag.onerror = () => reject(new Error('one tap unavailable'));
      document.head.appendChild(tag);
    });
  }

  /*
    Double-submit CSRF, minted here. Google sets `g_csrf_token` itself only when
    *it* posts the credential — the button's redirect mode — and nothing sets it
    on the One Tap callback path, so this page writes the cookie and echoes the
    same value in the body. The API's check is unchanged and still means what it
    meant: only a page on this origin can set and read back a host-only cookie,
    so a matching pair proves the POST came from here and not from someone
    else's form.
  */
  function postCredential(credential: string) {
    const csrf = crypto.randomUUID();
    document.cookie =
      `g_csrf_token=${csrf}; Path=/; SameSite=Lax` +
      (location.protocol === 'https:' ? '; Secure' : '');

    const form = document.createElement('form');
    form.method = 'POST';
    form.action = new URL('/auth/google/one-tap', location.origin).toString();
    for (const [name, value] of [
      ['credential', credential],
      ['g_csrf_token', csrf],
    ]) {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = name;
      input.value = value;
      form.append(input);
    }
    document.body.append(form);
    form.submit();
  }

  async function startOneTap() {
    if (!GOOGLE_CLIENT_ID) return;

    // Someone with a session already sees the signed-in nav; prompting them to
    // sign in would be nonsense. The pre-paint script in BaseLayout stamps this
    // from the cross-origin `stubbase_session` hint before anything renders.
    if (document.documentElement.classList.contains('signed-in')) return;

    // A blocked or offline Google is not an error worth surfacing — the page
    // works, and the nav's Log in link is the path that always exists.
    try {
      await loadGsi();
    } catch {
      return;
    }

    const id = (window as any).google?.accounts?.id;
    if (!id) return;

    id.initialize({
      client_id: GOOGLE_CLIENT_ID,
      callback: (response: { credential?: string }) => {
        if (response?.credential) postCredential(response.credential);
      },
    });
    id.prompt();
  }

  void startOneTap();
</script>
