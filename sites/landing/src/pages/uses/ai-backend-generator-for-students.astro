---
/*
  The students page, on RoleLayout (after xmind.com/roles/student). This file
  holds the words, the hero drawing, the four reasons and the free practice
  APIs; the layout holds the shape. Plan figures in the FAQ are PLANS and
  GIFT_CREDITS/GIFT_VALID_MONTHS in apps/dashboard-api/server-app.ts — plans
  differ by request limits alone, so never describe a feature here as paid.
*/
import { FileJson, Sparkles, ArrowRight, ArrowUpRight, Newspaper, MessagesSquare, Disc3, Image, ListChecks, Users, Rocket, Check } from 'lucide-astro';
import RoleLayout from '../../layouts/RoleLayout.astro';
import { APP_URL, CORE_URL } from '../../lib/urls';

const publicResources = [
  { path: '/posts', count: 100, noun: 'posts', Icon: Newspaper },
  { path: '/comments', count: 500, noun: 'comments', Icon: MessagesSquare },
  { path: '/albums', count: 100, noun: 'albums', Icon: Disc3 },
  { path: '/photos', count: 5000, noun: 'photos', Icon: Image },
  { path: '/todos', count: 200, noun: 'todos', Icon: ListChecks },
  { path: '/users', count: 10, noun: 'users', Icon: Users },
];
---

<RoleLayout
  title="AI Backend Generator for Students — Stubbase"
  description="Chat with AI or write one JSON file, your data model and database in one, and get a REST API with relationships linked automatically. Built for student projects."
  eyebrow="Stubbase for students"
  h1="The AI Backend Generator for Students"
  subhead="No database to install, no server to deploy. Built for class projects, hackathons and portfolio apps."
  primary={{ label: 'Generate API (Free)', href: APP_URL }}
  secondary={{ label: 'Use Public APIs', href: '#free-resources' }}
  note="No credit card required"
  tags={[
    { label: 'You', initial: 'Y', tint: 'var(--syntax-str)' },
    { label: 'Lab partner', initial: 'L', tint: 'var(--syntax-num)' },
    { label: 'AI Co-Pilot', bot: true, tint: 'var(--syntax-bool)' },
  ]}
  clientsLabel="Works with whatever your course uses"
  clients={['React', 'Next.js', 'Vue', 'Angular', 'Svelte', 'Flutter', 'React Native', 'Android', 'SwiftUI', 'Python', 'Postman', 'curl']}
  challengesTitle="What gets in the way of a student project?"
  challenges={[
    {
      art: 'database',
      title: 'A database to set up before anything else',
      body: 'Most class projects stall before the interesting part: installing a database, writing a server, and wiring the two together. By the time it runs, the week you had for the frontend is gone.',
    },
    {
      art: 'frontend',
      title: 'A frontend with nothing real to call',
      body: 'Hard-coded arrays get a screen drawn, but they never save, never page and never fail the way a real API does. The demo works until someone refreshes it.',
    },
    {
      art: 'deadline',
      title: 'Login and hosting eat the deadline',
      body: 'Sign-up, passwords, tokens and somewhere to host it all are each a project of their own. On a hackathon clock, they are usually the part that does not ship.',
    },
  ]}
  whyTitle="Why students build on Stubbase"
  starters={{
    title: 'Starter projects to learn from',
    intro: 'Every new project offers these on its first screen, with real sample data and a query that shows what each one is for.',
    items: [
      {
        title: 'Issue tracker',
        body: 'One resource, ten tasks. The place to learn filtering, sorting and pagination on a list.',
        head: 'GET /tasks',
        accent: '?status=in_progress',
        rows: [['Wire up the log stream', 'in_progress'], ['Add pagination', 'in_progress'], ['Chase the reconnect bug', 'in_progress']],
      },
      {
        title: 'Blog',
        body: 'Posts belong to authors and comments to posts, so one query brings back a post with its author nested inside.',
        head: 'GET /posts',
        accent: '?_expand=author',
        rows: [['Why we dropped the ORM', 'Sam Reyes'], ['Argon2 in practice', 'Mira Haddad'], ['Testing without mocks', 'Sam Reyes']],
      },
      {
        title: 'Storefront',
        body: 'Products, customers and orders that point at both, with anyone able to read and only a signed-in user able to write.',
        head: 'GET /orders',
        accent: '?status=shipped',
        rows: [['#1 · 1 × product 3', 'shipped'], ['#2 · 2 × product 1', 'shipped'], ['#5 · 1 × product 4', 'shipped']],
      },
    ],
  }}
  reading={{
    title: 'More resources for learning APIs',
    items: [
      { tag: 'Reference', title: 'Call a live API in one line, then make it slow or fail', href: '/quick-start', tint: 'var(--syntax-bool)' },
      { tag: 'Guide', title: 'How to get Google and GitHub OAuth keys', href: '/guides/google-github-oauth-keys', tint: 'var(--syntax-num)' },
      { tag: 'Free API', title: 'Every field, filter and query of the practice APIs', href: '/free-api', tint: 'var(--syntax-fn)' },
    ],
  }}
  solutions={['/roles/frontend-developer', '/roles/indie-hacker', '/roles/ai-engineer']}
  faqs={[
    {
      q: 'Is Stubbase free for students?',
      a: 'Yes. The Free plan has every feature, with no credit card and no trial that runs out: 10,000 requests a month, 5 requests a second with bursts of 20, and 1,000 AI credits when you sign up, valid for 3 months. That covers a class project or a hackathon demo.',
    },
    {
      q: 'Do I need to install a database or run a server?',
      a: 'No. You describe your data as a JSON file, or in a sentence to the AI Co-Pilot, and Stubbase serves it as a REST API at a public URL. Everything happens in the browser, and every write is saved as it happens.',
    },
    {
      q: 'Can the AI build the backend for me?',
      a: 'The AI Co-Pilot turns a description like "a study planner with courses, assignments and grades" into tables, the relations between them and sample records. New tables are staged as drafts, so nothing goes live until you press Deploy.',
    },
    {
      q: 'Which languages and frameworks does it work with?',
      a: 'Anything that can make an HTTP request: React, Vue, Angular, Flutter, Android, iOS, Python, Postman or curl. Public routes send Access-Control-Allow-Origin: *, so a fetch works from localhost and from your deployed app alike.',
    },
    {
      q: 'Can I add sign-up and login to my project?',
      a: "Yes. Set AUTH_ENABLED=true in your project's .env and you get sign-up with email verification, login, refresh tokens and password reset. Google and GitHub login need their client id and secret on top.",
    },
    {
      q: 'What is the difference between the free practice APIs and my own project?',
      a: 'The practice APIs are one shared, read-only project, so everyone sees the same data and no account is needed. Your own project gives you full CRUD — GET, POST, PUT and DELETE on every resource — over data only you control.',
    },
  ]}
  cta={{
    title: 'Generate your first API in seconds.',
    body: 'Start from a JSON file, a sentence to the AI Co-Pilot, or one of the free practice APIs. No database to run, no server to deploy.',
    label: 'Generate API (Free)',
    href: APP_URL,
    secondary: { label: 'Use Public APIs', href: '#free-resources' },
    note: 'No credit card required',
  }}
>
  {/* A student, mid-thought, with the pieces of a project around them. */}
