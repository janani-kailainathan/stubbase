---
/*
  The students page, on RoleLayout (after xmind.com/roles/student) with Home's
  hero in place of the layout's: a centred headline with one handwritten word,
  on a dot grid with pieces of a student project pinned around it. This file
  holds the words, that hero, the four reasons and the free practice APIs (in
  Home's Free Resources shape); the layout holds the rest. Plan figures in the FAQ are PLANS and
  GIFT_CREDITS/GIFT_VALID_MONTHS in apps/dashboard-api/server-app.ts — plans
  differ by request limits alone, so never describe a feature here as paid.
*/
import { FileJson, Sparkles, ArrowRight, Newspaper, MessagesSquare, Disc3, Image, ListChecks, Users, Rocket, Check } from 'lucide-astro';
import RoleLayout from '../../layouts/RoleLayout.astro';
import { APP_URL, CORE_URL } from '../../lib/urls';

const publicResources = [
  { path: '/posts', count: 100, noun: 'posts', Icon: Newspaper, tint: 'var(--syntax-fn)' },
  { path: '/comments', count: 500, noun: 'comments', Icon: MessagesSquare, tint: 'var(--syntax-bool)' },
  { path: '/albums', count: 100, noun: 'albums', Icon: Disc3, tint: 'var(--syntax-num)' },
  { path: '/photos', count: 5000, noun: 'photos', Icon: Image, tint: 'var(--syntax-fn)' },
  { path: '/todos', count: 200, noun: 'todos', Icon: ListChecks, tint: 'var(--primary)' },
  { path: '/users', count: 10, noun: 'users', Icon: Users, tint: 'var(--syntax-num)' },
];

// Real records from the `public` demo project, verbatim — the same copy as
// index.astro's. Its seed (scripts/seed-public-tenant.ts) is deterministic, so
// these are exactly what the links return; reseeding means updating both.
const sampleRecords: { path: string; record: Record<string, string | number | boolean> }[] = [
  { path: '/users/1', record: { id: 1, name: 'Ivy Rossi', username: 'ivyrossi', company: 'Rossi Collective', active: true } },
  { path: '/todos/1', record: { id: 1, userId: 1, title: 'dashboard handoff payload mock sandbox', completed: true } },
  { path: '/comments/1', record: { id: 1, postId: 1, email: 'omarweber@example.com', body: 'Endpoint cursor record api schema payload.' } },
  { path: '/albums/1', record: { id: 1, userId: 1, title: 'endpoint api latency mock' } },
  { path: '/users/2', record: { id: 2, name: 'Yuki Okafor', username: 'yukiokafor', company: 'Okafor Works', active: false } },
  { path: '/photos/1', record: { id: 1, albumId: 1, title: 'draft latency response endpoint', thumbnailUrl: 'https://picsum.photos/seed/stubbase-1/150/150' } },
  { path: '/todos/2', record: { id: 2, userId: 1, title: 'payload billing billing handoff billing draft', completed: false } },
  { path: '/posts/1', record: { id: 1, userId: 1, title: 'latency fixture prototype fixture cursor shipping' } },
];
// Two rows drifting opposite ways, each repeated four times so the loop is seamless.
const recordRows = [sampleRecords.slice(0, 4), sampleRecords.slice(4)];

const subhead =
  'Describe your app to the AI Co-Pilot or write one JSON file, and get a REST API with the relations linked for you. No database to install, no server to deploy. Built for class projects, hackathons and portfolio apps.';
---

<RoleLayout
  title="AI Backend Generator for Students — Stubbase"
  description="Chat with AI or write one JSON file, your data model and database in one, and get a REST API with relationships linked automatically. Built for student projects."
  eyebrow="Stubbase for students"
  h1="AI Backend Generator for Students"
  subhead={subhead}
  primary={{ label: 'Generate API (Free)', href: APP_URL }}
  secondary={{ label: 'Use Public APIs', href: '#free-resources' }}
  note="No credit card required"
  clientsLabel="Works with whatever your course uses"
  clients={['React', 'Next.js', 'Vue', 'Angular', 'Svelte', 'Flutter', 'React Native', 'Android', 'SwiftUI', 'Python', 'Postman', 'curl']}
  challengesTitle="What gets in the way of a student project?"
  challenges={[
    {
      art: 'database',
      title: 'A database to set up before anything else',
      body: 'Most class projects stall before the interesting part: installing a database, writing a server, and wiring the two together. By the time it runs, the week you had for the frontend is gone.',
    },
    {
      art: 'frontend',
      title: 'A frontend with nothing real to call',
      body: 'Hard-coded arrays get a screen drawn, but they never save, never page and never fail the way a real API does. The demo works until someone refreshes it.',
    },
    {
      art: 'deadline',
      title: 'Login and hosting eat the deadline',
      body: 'Sign-up, passwords, tokens and somewhere to host it all are each a project of their own. On a hackathon clock, they are usually the part that does not ship.',
    },
  ]}
  whyTitle="Why students build on Stubbase"
  starters={{
    title: 'Starter projects to learn from',
    intro: 'Every new project offers these on its first screen, with real sample data and a query that shows what each one is for.',
    items: [
      {
        title: 'Issue tracker',
        body: 'One resource, ten tasks. The place to learn filtering, sorting and pagination on a list.',
        head: 'GET /tasks',
        accent: '?status=in_progress',
        rows: [['Wire up the log stream', 'in_progress'], ['Add pagination', 'in_progress'], ['Chase the reconnect bug', 'in_progress']],
      },
      {
        title: 'Blog',
        body: 'Posts belong to authors and comments to posts, so one query brings back a post with its author nested inside.',
        head: 'GET /posts',
        accent: '?_expand=author',
        rows: [['Why we dropped the ORM', 'Sam Reyes'], ['Argon2 in practice', 'Mira Haddad'], ['Testing without mocks', 'Sam Reyes']],
      },
      {
        title: 'Storefront',
        body: 'Products, customers and orders that point at both, with anyone able to read and only a signed-in user able to write.',
        head: 'GET /orders',
        accent: '?status=shipped',
        rows: [['#1 · 1 × product 3', 'shipped'], ['#2 · 2 × product 1', 'shipped'], ['#5 · 1 × product 4', 'shipped']],
      },
    ],
  }}
  reading={{
    title: 'More resources for learning APIs',
    items: [
      { tag: 'Reference', title: 'Call a live API in one line, then make it slow or fail', href: '/quick-start', tint: 'var(--syntax-bool)' },
      { tag: 'Guide', title: 'How to get Google and GitHub OAuth keys', href: '/guides/google-github-oauth-keys', tint: 'var(--syntax-num)' },
      { tag: 'Free API', title: 'Every field, filter and query of the practice APIs', href: '/free-api', tint: 'var(--syntax-fn)' },
    ],
  }}
  solutions={['/roles/frontend-developer', '/roles/indie-hacker', '/roles/ai-engineer']}
  faqs={[
    {
      q: 'Is Stubbase free for students?',
      a: 'Yes. The Free plan has every feature, with no credit card and no trial that runs out: 10,000 requests a month, 5 requests a second with bursts of 20, and 1,000 AI credits when you sign up, valid for 3 months. That covers a class project or a hackathon demo.',
    },
    {
      q: 'Do I need to install a database or run a server?',
      a: 'No. You describe your data as a JSON file, or in a sentence to the AI Co-Pilot, and Stubbase serves it as a REST API at a public URL. Everything happens in the browser, and every write is saved as it happens.',
    },
    {
      q: 'Can the AI build the backend for me?',
      a: 'The AI Co-Pilot turns a description like "a study planner with courses, assignments and grades" into tables, the relations between them and sample records. New tables are staged as drafts, so nothing goes live until you press Deploy.',
    },
    {
      q: 'Which languages and frameworks does it work with?',
      a: 'Anything that can make an HTTP request: React, Vue, Angular, Flutter, Android, iOS, Python, Postman or curl. Public routes send Access-Control-Allow-Origin: *, so a fetch works from localhost and from your deployed app alike.',
    },
    {
      q: 'Can I add sign-up and login to my project?',
      a: "Yes. Set AUTH_ENABLED=true in your project's .env and you get sign-up with email verification, login, refresh tokens and password reset. Google and GitHub login need their client id and secret on top.",
    },
    {
      q: 'What is the difference between the free practice APIs and my own project?',
      a: 'The practice APIs are one shared, read-only project, so everyone sees the same data and no account is needed. Your own project gives you full CRUD — GET, POST, PUT and DELETE on every resource — over data only you control.',
    },
  ]}
  cta={{
    title: 'Generate your first API in seconds.',
    body: 'Start from a JSON file, a sentence to the AI Co-Pilot, or one of the free practice APIs. No database to run, no server to deploy.',
    label: 'Generate API (Free)',
    href: APP_URL,
    secondary: { label: 'Use Public APIs', href: '#free-resources' },
    note: 'No credit card required',
  }}
>
  {/*
    Hero, after Home's: a centred two-line headline with one handwritten
    accent word, on a dot grid with pieces of a student project pinned around
    it and the team's cursors pointing at them. The pieces are decoration
    (aria-hidden, xl only); everything they say is also in the page's text.
    The H1 wording is the `h1` prop's — an SEO target. Each cursor is one image
    per theme, pointer and name chip together, drawn in VectorCraft (sources in
    design/): its box is the pointer's 20px, which the offsets place, and the
    image overhangs it towards the chip. No script: the entrance and the
    cursors' drift are showcase.css's hero-rise and hero-tag, and both stop
    under prefers-reduced-motion.
  */}
  <section slot="hero" class="relative overflow-hidden">
    <div class="hero-dots pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-6 pt-16 pb-16 lg:pt-24 xl:pt-28 xl:pb-36">
      {/* Only from xl: below that the headline needs the width the pieces sit in. */}
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 mx-6 hidden xl:block">
        {/* Top left: a resource file, wired to what it becomes. */}
        <div class="hero-rise absolute top-10 left-0 w-56 [--d:0.35s]">
          <div class="rounded-xl border border-border-c bg-card">
            <div class="flex items-center gap-2 border-b border-border-c px-3 py-2 font-mono text-[11px] text-subtle">
              <FileJson class="h-3.5 w-3.5 text-primary-accent" />
              assignments.json
            </div>
            <pre class="px-3 py-2.5 font-mono text-[11px] leading-relaxed text-code-fg"><span class="text-syntax-punct">[{'{'}</span>
  <span class="text-syntax-str">"id"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-num">1</span><span class="text-syntax-punct">,</span>
  <span class="text-syntax-str">"title"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-fn">"Final project"</span><span class="text-syntax-punct">,</span>
  <span class="text-syntax-str">"courseId"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-num">2</span>
<span class="text-syntax-punct">{'}'}]</span></pre>
          </div>
          <div class="ml-6 h-6 w-px border-l border-dashed border-border-strong"></div>
          <div class="ml-6 flex items-center">
            <div class="w-5 border-t border-dashed border-border-strong"></div>
            <div class="rounded-lg border border-border-c bg-muted px-3 py-2 text-xs leading-snug text-muted-foreground">
              A REST API, with<br />the course linked in
            </div>
          </div>
          <div class="hero-tag absolute h-5 w-5 top-3 -right-6 [--drift:6px]">
            <img src="/student-cursor-you-dark.webp" alt="" width="78" height="44" class="absolute -top-0.5 -left-0.5 max-w-none" data-theme-image="dark" />
            <img src="/student-cursor-you-light.webp" alt="" width="78" height="44" class="absolute -top-0.5 -left-0.5 max-w-none" data-theme-image="light" />
          </div>
        </div>

        {/* Top right: a write, and where it went. */}
        <div class="hero-rise absolute top-16 right-4 w-36 [--d:0.5s]">
          <div class="rounded-lg border border-primary-soft-border bg-primary-soft p-3">
            <p class="font-mono text-xs text-subtle">201</p>
            <p class="text-3xl font-extrabold text-foreground">POST</p>
            <p class="font-mono text-xs text-muted-foreground">/grades</p>
            <p class="font-mono text-[11px] text-subtle">[saved for good]</p>
          </div>
          <div class="ml-10 h-6 w-px bg-border-strong"></div>
          <div class="rounded-lg border border-border-c bg-muted px-3 py-2 text-xs leading-snug text-muted-foreground">
            Still there<br />after a refresh
          </div>
          <div class="hero-tag absolute h-5 w-5 top-6 -left-6 [--drift:-5px]">
            <img src="/student-cursor-lab-partner-dark.webp" alt="" width="124" height="44" class="absolute -top-0.5 -right-0.5 max-w-none" data-theme-image="dark" />
            <img src="/student-cursor-lab-partner-light.webp" alt="" width="124" height="44" class="absolute -top-0.5 -right-0.5 max-w-none" data-theme-image="light" />
          </div>
        </div>

        {/* Bottom left: the student, with Friday's deadline. Drawn in VectorCraft and
            exported once per theme (2x, transparent WebP); global.css's
            data-theme-image rules show the one matching the surface. */}
        <div class="hero-rise absolute bottom-0 left-0 w-60 [--d:0.65s]">
          <img src="/student-doodle-dark.webp" alt="" width="420" height="340" class="h-auto w-full" data-theme-image="dark" />
          <img src="/student-doodle-light.webp" alt="" width="420" height="340" class="h-auto w-full" data-theme-image="light" />
        </div>

        {/* Bottom right: one sentence to the Co-Pilot, and what it staged. */}
        <div class="hero-rise absolute right-0 bottom-6 w-64 [--d:0.8s]">
          <div class="rounded-xl border border-border-c bg-card p-3">
            <p class="mb-1.5 flex items-center gap-1.5 text-[11px] font-medium text-subtle">
              <Sparkles class="h-3.5 w-3.5 text-primary-accent" /> AI Co-Pilot
            </p>
            <p class="text-xs leading-relaxed text-foreground">A study planner with courses, assignments and grades.</p>
          </div>
          <div class="mr-12 ml-auto h-5 w-px bg-border-strong"></div>
          <div class="flex justify-end gap-1.5">
            {['courses', 'assignments', 'grades'].map((table) => (
              <span class="rounded-md border border-border-c bg-card px-2 py-1 font-mono text-[10px] text-muted-foreground">{table}</span>
            ))}
          </div>
          <p class="mt-1.5 text-right font-mono text-[10px] text-subtle">3 tables · staged until Deploy</p>
          <div class="hero-tag absolute h-5 w-5 top-3 -left-6 [--drift:4px]">
            <img src="/student-cursor-ai-co-pilot-dark.webp" alt="" width="120" height="44" class="absolute -top-0.5 -right-0.5 max-w-none" data-theme-image="dark" />
            <img src="/student-cursor-ai-co-pilot-light.webp" alt="" width="120" height="44" class="absolute -top-0.5 -right-0.5 max-w-none" data-theme-image="light" />
          </div>
        </div>
      </div>

      <div class="relative mx-auto max-w-4xl text-center">
        <h1 class="hero-rise text-4xl leading-[1.08] font-extrabold tracking-tight text-foreground sm:text-5xl lg:text-6xl 2xl:text-7xl [--d:0.05s]">
          AI Backend{' '}<br class="hidden sm:inline" />
          Generator for <span class="hero-accent">Students</span>
        </h1>
        <p class="hero-rise mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground [--d:0.1s]">{subhead}</p>

        <div class="hero-rise mt-8 flex flex-wrap items-center justify-center gap-3 [--d:0.2s]">
          <a href={APP_URL} class="flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-base font-semibold text-primary-foreground transition-colors hover:bg-primary-hover">
            <span class="hero-mark h-5 w-5 bg-current" aria-hidden="true"></span>
            Generate API (Free)
          </a>
          <a href="#free-resources" class="flex items-center rounded-xl bg-card px-5 py-2.5 text-base font-semibold text-foreground transition-colors hover:bg-muted">
            Use Public APIs
          </a>
        </div>
        <p class="hero-rise mt-4 text-sm text-subtle [--d:0.3s]">No credit card required · Every feature on the Free plan</p>
      </div>
    </div>

    <div class="hero-rise relative mx-auto max-w-5xl px-6 pb-20 [--d:0.4s]">
      <div class="rounded-2xl bg-muted-hover p-1.5">
        <div class="overflow-hidden rounded-xl border border-border-c bg-background p-2">
          <img src="/dashboard-ui.png" alt="Stubbase Dashboard UI" class="w-full rounded-lg border border-border-faint" />
        </div>
      </div>
    </div>
  </section>


  {/* Four reasons, in xmind's three shapes: one wide block with its words split
      under the picture, two cards side by side, one with the picture on its
      left. Each picture is a drawn piece of the dashboard, not a screenshot. */}
  {/* 1. JSON to REST — the wide block. */}
  <article class="reveal">
    <div aria-hidden="true" class="feature-canvas relative flex min-h-80 items-center justify-center gap-6 overflow-hidden rounded-3xl border border-border-c p-8 sm:gap-10 sm:p-12">
      <div class="w-56 shrink-0 -rotate-2 rounded-xl border border-border-c bg-background">
        <p class="flex items-center gap-2 border-b border-border-c px-3 py-2 font-mono text-xs text-subtle">
          <FileJson class="h-3.5 w-3.5 text-primary-accent" /> assignments.json
        </p>
        <pre class="px-3 py-2.5 font-mono text-xs leading-relaxed text-code-fg"><span class="text-syntax-punct">[{'{'}</span>
  <span class="text-syntax-str">"id"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-num">1</span><span class="text-syntax-punct">,</span>
  <span class="text-syntax-str">"title"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-fn">"Final project"</span><span class="text-syntax-punct">,</span>
  <span class="text-syntax-str">"courseId"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-num">2</span><span class="text-syntax-punct">,</span>
  <span class="text-syntax-str">"due"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-fn">"2026-12-04"</span>
<span class="text-syntax-punct">{'}'}]</span></pre>
      </div>
      <ArrowRight class="hidden h-8 w-8 shrink-0 text-primary-accent sm:block" />
      <div class="hidden w-80 shrink-0 rounded-xl border border-border-c bg-background p-2 sm:block">
        {
          [
            ['GET', '/assignments'],
            ['GET', '/assignments/1'],
            ['POST', '/assignments'],
            ['PUT', '/assignments/1'],
            ['DELETE', '/assignments/1'],
            ['GET', '/assignments?_expand=course'],
          ].map(([method, path]) => (
            <p class="flex items-center gap-2 rounded-md px-2 py-1.5 font-mono text-xs text-muted-foreground">
              <span class="w-14 shrink-0 rounded border border-border-c px-1 text-center text-[10px] text-subtle">{method}</span>
              <span class={path.includes('_expand') ? 'text-primary-ink' : ''}>{path}</span>
            </p>
          ))
        }
      </div>
      <span class="doodle-note absolute right-8 bottom-6 hidden -rotate-3 text-xl text-primary-ink lg:block">relations, linked for you</span>
    </div>
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-12">
      <div>
        <p class="feature-label">JSON to REST</p>
        <h3 class="text-2xl font-semibold text-foreground">One JSON file becomes a REST API</h3>
      </div>
      <div>
        <p class="mb-6 leading-relaxed text-muted-foreground">
          Write your data as a list of objects and every resource gets GET, POST, PUT and DELETE at
          a public URL. Name a field <code class="font-mono text-sm whitespace-nowrap text-emphasis">courseId</code> and
          {" "}<code class="font-mono text-sm whitespace-nowrap text-emphasis">?_expand=course</code> nests the course inside
          — the relation is the data model, with no schema to write first.
        </p>
        <a href="/use-cases/mock-apis" class="explore-btn">Explore now</a>
      </div>
    </div>
  </article>

  <div class="mt-16 grid grid-cols-1 gap-12 md:grid-cols-2 md:gap-8 [&>*]:min-w-0">
    {/* 2. AI Co-Pilot. */}
    <article class="reveal flex flex-col">
      <div aria-hidden="true" class="feature-canvas relative h-72 overflow-hidden rounded-3xl border border-border-c">
        <div class="absolute top-8 left-6 w-64 -rotate-2 rounded-2xl border border-border-c bg-background p-4">
          <p class="mb-2 flex items-center gap-2 text-xs font-medium text-subtle"><Sparkles class="h-3.5 w-3.5 text-primary-accent" /> AI Co-Pilot</p>
          <p class="text-sm leading-relaxed text-foreground">A study planner with courses, assignments and grades.</p>
          <div class="mt-3 flex items-center justify-between">
            <span class="rounded-md bg-muted px-2 py-1 font-mono text-[11px] text-subtle">3 tables</span>
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary text-primary-foreground"><ArrowRight class="h-4 w-4" /></span>
          </div>
        </div>
        <div class="absolute right-6 bottom-6 flex gap-2">
          {
            [
              { name: 'courses', fields: ['id', 'name', 'term'] },
              { name: 'assignments', fields: ['id', 'title', 'courseId'] },
              { name: 'grades', fields: ['id', 'score', 'assignmentId'] },
            ].map((table, i) => (
              <div class={`w-28 rounded-xl border border-border-c bg-background ${i === 1 ? '-translate-y-5' : ''} ${i === 0 ? 'hidden sm:block' : ''}`}>
                <p class="border-b border-border-c px-3 py-1.5 font-mono text-[11px] font-semibold text-foreground">{table.name}</p>
                <ul class="px-3 py-1.5 font-mono text-[11px] leading-5">
                  {table.fields.map((field) => (
                    <li class={field.endsWith('Id') ? 'text-primary-ink' : 'text-muted-foreground'}>{field}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
      <p class="feature-label mt-8">AI Co-Pilot</p>
      <h3 class="mb-3 text-2xl font-semibold text-foreground">Describe your app, get the backend</h3>
      <p class="mb-6 leading-relaxed text-muted-foreground">
        Tell the Co-Pilot what you are building in one sentence. It designs the tables, links
        them and fills them with sample records, staged as drafts until you press Deploy — so
        you stay in charge of what goes live.
      </p>
      <a href="/features/ai-rest-api-generation" class="explore-btn mt-auto self-start">Explore now</a>
    </article>

    {/* 3. Sign-in. */}
    <article class="reveal flex flex-col">
      <div aria-hidden="true" class="feature-canvas relative h-72 overflow-hidden rounded-3xl border border-border-c">
        <div class="absolute top-8 left-6 w-56 rounded-2xl border border-border-c bg-background p-4">
          <p class="mb-3 text-sm font-semibold text-foreground">Sign in to Study Planner</p>
          <p class="mb-2 rounded-lg border border-border-c px-3 py-1.5 text-xs text-subtle">ana@uni.edu</p>
          <p class="mb-3 rounded-lg border border-border-c px-3 py-1.5 text-xs text-subtle">••••••••••</p>
          <p class="mb-2 rounded-lg bg-primary py-1.5 text-center text-xs font-semibold text-primary-foreground">Log in</p>
          <div class="grid grid-cols-2 gap-2 text-center text-[11px] font-medium text-muted-foreground">
            <span class="rounded-lg border border-border-c py-1">Google</span>
            <span class="rounded-lg border border-border-c py-1">GitHub</span>
          </div>
        </div>
        <div class="absolute right-6 bottom-8 w-48 rotate-2 rounded-xl border border-border-c bg-background px-3 py-2.5 font-mono text-[11px] leading-relaxed">
          <span class="text-syntax-punct">POST</span> <span class="text-syntax-str">/auth/login</span><br />
          <span class="text-subtle">200 ·</span> <span class="text-syntax-fn">token</span><span class="text-syntax-punct">,</span> <span class="text-syntax-fn">refreshToken</span>
        </div>
      </div>
      <p class="feature-label mt-8">Authentication</p>
      <h3 class="mb-3 text-2xl font-semibold text-foreground">Sign-up and login, already built</h3>
