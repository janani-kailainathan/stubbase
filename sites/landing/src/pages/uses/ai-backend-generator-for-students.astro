---
/*
  The students page, on RoleLayout (after xmind.com/roles/student) with Home's
  hero in place of the layout's: a centred headline with one handwritten word,
  on a dot grid. This file
  holds the words, that hero, the five reasons, and Home's query and plans
  sections; the layout holds the rest. Plan figures in the FAQ are PLANS and
  GIFT_CREDITS/GIFT_VALID_MONTHS in apps/dashboard-api/server-app.ts — plans
  differ by request limits alone, so never describe a feature here as paid.
*/
import { FileJson, Sparkles, ArrowUpRight, KeyRound, Play, LayoutTemplate } from 'lucide-astro';
import RoleLayout from '../../layouts/RoleLayout.astro';
import HomeQuery from '../../components/home/HomeQuery.astro';
import HomePlans from '../../components/home/HomePlans.astro';
import { APP_URL } from '../../lib/urls';
import { isReleased } from '../../lib/released';

const subhead =
  'Use AI Co-Pilot to generate your backend for your class projects, hackathons and portfolio apps. No database to install, no server to deploy.';
---

<RoleLayout
  title="AI Backend Generator for Students — Stubbase"
  description="Chat with AI or write one JSON file, your data model and database in one, and get a REST API with relationships linked automatically. Built for student projects."
  eyebrow="Stubbase for students"
  h1="AI Backend Generator for Students"
  subhead={subhead}
  primary={{ label: 'Generate API', href: APP_URL }}
  note="No credit card required"
  clientsLabel="Works with whatever your course uses"
  clients={['React', 'Next.js', 'Vue', 'Angular', 'Svelte', 'Flutter', 'React Native', 'Android', 'SwiftUI', 'Python', 'Postman', 'curl']}
  whyTitle="Why students build on Stubbase"
  whyFirst
  hideFaq
  faqs={[
    {
      q: 'Is Stubbase free for students?',
      a: 'Yes. The Free plan has every feature, with no credit card and no trial that runs out: 10,000 requests a month, 5 requests a second with bursts of 20, and 1,000 AI credits when you sign up, valid for 3 months. That covers a class project or a hackathon demo. Sign up with your university email and you also get the Starter AI pack free: 5,000 more AI credits, valid for 12 months, normally $9.99.',
    },
    {
      q: 'Do I need to install a database or run a server?',
      a: 'No. You describe your data as a JSON file, or in a sentence to the AI Co-Pilot, and Stubbase serves it as a REST API at a public URL. Everything happens in the browser, and every write is saved as it happens.',
    },
    {
      q: 'Can the AI build the backend for me?',
      a: 'The AI Co-Pilot turns a description like "a study planner with courses, assignments and grades" into tables, the relations between them and sample records. New tables are staged as drafts, so nothing goes live until you press Deploy.',
    },
    {
      q: 'Which languages and frameworks does it work with?',
      a: 'Anything that can make an HTTP request: React, Vue, Angular, Flutter, Android, iOS, Python, Postman or curl. Public routes send Access-Control-Allow-Origin: *, so a fetch works from localhost and from your deployed app alike.',
    },
    {
      q: 'Can I add sign-up and login to my project?',
      a: "Yes. Set AUTH_ENABLED=true in your project's .env and you get sign-up with email verification, login, refresh tokens and password reset. Google and GitHub login need their client id and secret on top.",
    },
    {
      q: 'What is the difference between the free practice APIs and my own project?',
      a: 'The practice APIs are one shared, read-only project, so everyone sees the same data and no account is needed. Your own project gives you full CRUD — GET, POST, PUT and DELETE on every resource — over data only you control.',
    },
  ]}
  cta={{
    title: 'Generate APIs in seconds',
    body: 'Use AI Co-Pilot to generate your backend for your class projects, hackathons and portfolio apps',
    label: 'Generate API',
    href: APP_URL,
    secondary: { label: 'Login', href: `${APP_URL}/login` },
    secondaryFirst: true,
  }}
>
  {/*
    Hero, after Home's: a centred two-line headline with one handwritten
    accent word on a fading dot grid, the buttons, the dashboard below, and
    three drawn pieces floating around the headline on wide screens. The H1 wording is the `h1`
    prop's — an SEO target. No script: the entrance is showcase.css's
    hero-rise, which stops under prefers-reduced-motion.
  */}
  <section slot="hero" class="relative overflow-hidden" data-push-area>
    <div class="hero-dots pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-6 pt-24 pb-20 lg:pt-36 lg:pb-28 xl:pt-44 xl:pb-32">
      {/* Floating pieces of the Co-Pilot scene and the Test card, drawn in
          VectorCraft (design/student-copilot-chat-*, design/student-json-icons-*,
          design/student-card-starter-*, design/student-rest-client-*).
          Decoration only, and only from xl, where the headline leaves room;
          each rises in (showcase.css's hero-rise), then floats at its own tilt
          and pace (.hero-float, below). */}
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 mx-6 hidden xl:block">
        <div class="hero-rise absolute top-24 left-0 w-72 [--d:0.35s]">
          <div class="hero-float [--tilt:-5deg] [--dur:7s] [--delay:0s]"><img src="/student-copilot-chat-dark.webp" alt="" width="358" height="186" class="h-auto w-full" data-theme-image="dark" /><img src="/student-copilot-chat-light.webp" alt="" width="358" height="186" class="h-auto w-full" data-theme-image="light" /></div>
        </div>
        <div class="hero-rise absolute top-24 right-0 w-60 [--d:0.5s]">
          <div class="hero-float [--tilt:13deg] [--dur:9s] [--delay:-6s]"><img src="/student-json-icons-dark.webp" alt="" width="256" height="116" class="h-auto w-full" data-theme-image="dark" /><img src="/student-json-icons-light.webp" alt="" width="256" height="116" class="h-auto w-full" data-theme-image="light" /></div>
        </div>
        <div class="hero-rise absolute bottom-6 left-6 w-56 [--d:0.6s]">
          <div class="hero-float [--tilt:-18deg] [--dur:8.5s] [--delay:-3s]"><img src="/student-card-starter-dark.webp" alt="" width="320" height="200" class="h-auto w-full" data-theme-image="dark" /><img src="/student-card-starter-light.webp" alt="" width="320" height="200" class="h-auto w-full" data-theme-image="light" /></div>
        </div>
        <div class="hero-rise absolute right-0 bottom-8 w-48 [--d:0.65s]">
          <div class="hero-float [--tilt:5deg] [--dur:8s] [--delay:-4s]"><img src="/student-rest-client-dark.webp" alt="" width="196" height="152" class="h-auto w-full" data-theme-image="dark" /><img src="/student-rest-client-light.webp" alt="" width="196" height="152" class="h-auto w-full" data-theme-image="light" /></div>
        </div>
        {/* Two collaborators' cursors pointing at the headline from opposite
            sides — the Co-Pilot at "Generator", you at "Students": the pointer
            is a 20px box the offsets place, the name chip hangs from its tail
            (VectorCraft, design/student-cursor-*). */}
        <div class="hero-rise absolute top-[348px] left-[1016px] z-30 [--d:0.8s]" data-pushable>
          <div class="hero-nudge relative h-5 w-5 [--nx:-7px] [--ny:-7px] [--dur:4.2s]"><img src="/student-cursor-you-dark.webp" alt="" width="78" height="44" class="absolute -top-0.5 -left-0.5 max-w-none" data-theme-image="dark" /><img src="/student-cursor-you-light.webp" alt="" width="78" height="44" class="absolute -top-0.5 -left-0.5 max-w-none" data-theme-image="light" /></div>
        </div>
        <div class="hero-rise absolute top-[336px] left-[196px] z-30 [--d:0.9s]" data-pushable>
          <div class="hero-nudge relative h-5 w-5 [--nx:7px] [--ny:-7px] [--dur:4.8s]"><img src="/student-cursor-ai-co-pilot-dark.webp" alt="" width="120" height="44" class="absolute -top-0.5 -right-0.5 max-w-none" data-theme-image="dark" /><img src="/student-cursor-ai-co-pilot-light.webp" alt="" width="120" height="44" class="absolute -top-0.5 -right-0.5 max-w-none" data-theme-image="light" /></div>
        </div>
      </div>

      <div class="relative mx-auto max-w-4xl text-center">
        <h1 class="hero-rise text-4xl leading-[1.08] font-extrabold tracking-tight text-foreground sm:text-5xl lg:text-6xl 2xl:text-7xl [--d:0.05s]">
          AI Backend{' '}<br class="hidden sm:inline" />
          Generator for <span class="hero-accent">Students</span>
        </h1>
        <p class="hero-rise mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground [--d:0.1s]">{subhead}</p>

        <div class="hero-rise mt-8 flex flex-wrap items-center justify-center gap-3 [--d:0.2s]">
          <a href={`${APP_URL}/login`} class="flex min-w-32 items-center justify-center rounded-xl bg-card px-5 py-2.5 text-base font-semibold text-foreground transition-colors hover:bg-muted">
            Login
          </a>
          <a href={APP_URL} class="flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-base font-semibold text-primary-foreground transition-colors hover:bg-primary-hover">
            <span class="hero-mark h-5 w-5 bg-current" aria-hidden="true"></span>
            Generate API
          </a>
        </div>
        <p class="hero-rise mt-4 text-sm text-subtle [--d:0.3s]">No credit card required</p>
      </div>
    </div>

    <div class="hero-rise relative mx-auto max-w-5xl px-6 pb-20 [--d:0.4s]">
      <div class="rounded-2xl bg-muted-hover p-1.5">
        <div class="overflow-hidden rounded-xl border border-border-c bg-background p-2">
          <img src="/dashboard-ui.png" alt="Stubbase Dashboard UI" class="w-full rounded-lg border border-border-faint" />
        </div>
      </div>
    </div>
  </section>


  {/*
    The reasons, in Home's "Stop Writing Boilerplate APIs" shape: two large
    cards for the two ways a project's tables are born, then three small ones
    for what a student does with them. Drawings are aria-hidden; each card's
    text carries its claim.
  */}
  <div class="grid grid-cols-1 gap-5 md:grid-cols-2 [&>*]:min-w-0">
    {/* AI Co-Pilot */}
    <article class="bento reveal relative overflow-hidden rounded-3xl border border-border-c p-7 sm:p-9 [--tint:var(--primary)]">
      <h3 class="mb-2 flex items-center gap-3 text-xl font-semibold text-foreground">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary-soft text-primary-accent"><Sparkles class="h-4.5 w-4.5" /></span>
        AI Co-Pilot guides you along the way
      </h3>
      <p class="leading-relaxed text-muted-foreground">
        Ask your AI Co-Pilot friend about what you are building, and it designs the tables and links
        them. Ask it to fill them with sample records. Ask it to start or stop the server.
      </p>
      {/* Drawn in VectorCraft (design/student-card-copilot-*.vectorcraft), one per theme. */}
      <div aria-hidden="true" class="mt-8 mb-6">
        <img src="/student-card-copilot-dark.webp" alt="" width="520" height="224" loading="lazy" class="h-auto w-full" data-theme-image="dark" />
        <img src="/student-card-copilot-light.webp" alt="" width="520" height="224" loading="lazy" class="h-auto w-full" data-theme-image="light" />
      </div>
      {/* Each arrow shows once the page it opens is released (src/lib/released.ts). */}
      {isReleased('/features/ai-rest-api-generation') && <a href="/features/ai-rest-api-generation" class="bento-link" aria-label="AI Co-Pilot: read more"><ArrowUpRight class="h-4 w-4" /></a>}
    </article>

    {/* JSON to REST */}
    <article class="bento reveal relative overflow-hidden rounded-3xl border border-border-c p-7 sm:p-9 [--tint:var(--syntax-fn)]">
      <h3 class="mb-2 flex items-center gap-3 text-xl font-semibold text-foreground">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-(--tint)/15 text-(--tint)"><FileJson class="h-4.5 w-4.5" /></span>
        JSON to REST API
      </h3>
      <p class="leading-relaxed text-muted-foreground">
        Every JSON file you add gets its own REST API, with CRUD endpoints for its records.
      </p>
      {/* Drawn in VectorCraft (design/student-card-json-*.vectorcraft), one per theme. */}
      <div aria-hidden="true" class="mt-8 mb-6">
        <img src="/student-card-json-dark.webp" alt="" width="540" height="236" loading="lazy" class="h-auto w-full" data-theme-image="dark" />
        <img src="/student-card-json-light.webp" alt="" width="540" height="236" loading="lazy" class="h-auto w-full" data-theme-image="light" />
      </div>
      {isReleased('/use-cases/mock-apis') && <a href="/use-cases/mock-apis" class="bento-link" aria-label="JSON to REST API: read more"><ArrowUpRight class="h-4 w-4" /></a>}
    </article>
  </div>

  <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-3 [&>*]:min-w-0">
    {/* Sign-in */}
    <article class="reveal relative rounded-3xl border border-border-c bg-card p-7">
      <h3 class="mb-2 flex items-center gap-3 text-lg font-semibold text-foreground">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-(--syntax-bool)/15 text-syntax-bool"><KeyRound class="h-4.5 w-4.5" /></span>
        Built-in authentication
      </h3>
      <p class="mb-6 text-sm leading-relaxed text-muted-foreground">
        Ask your AI Co-Pilot to add authentication, or enable it yourself with a feature flag.
        Need Google or GitHub sign-in? Enable them as well.
      </p>
      {/* Drawn in VectorCraft (design/student-card-signin-*.vectorcraft), one per theme. */}
      <div aria-hidden="true">
        <img src="/student-card-signin-dark.webp" alt="" width="320" height="200" loading="lazy" class="h-auto w-full" data-theme-image="dark" />
        <img src="/student-card-signin-light.webp" alt="" width="320" height="200" loading="lazy" class="h-auto w-full" data-theme-image="light" />
      </div>
    </article>

    {/* Starters, after Home's card (components/home/HomeStart.astro). */}
    <article class="reveal relative rounded-3xl border border-border-c bg-card p-7">
      <h3 class="mb-2 flex items-center gap-3 text-lg font-semibold text-foreground">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-(--syntax-num)/15 text-syntax-num"><LayoutTemplate class="h-4.5 w-4.5" /></span>
        Start from a starter
      </h3>
      <p class="mb-6 text-sm leading-relaxed text-muted-foreground">
        No need to build everything from scratch: use a starter template and build your backend on
        top of it.
      </p>
      {/* Drawn in VectorCraft (design/student-card-starter-*.vectorcraft), one per theme. */}
      <div aria-hidden="true">
        <img src="/student-card-starter-dark.webp" alt="" width="320" height="200" loading="lazy" class="h-auto w-full" data-theme-image="dark" />
        <img src="/student-card-starter-light.webp" alt="" width="320" height="200" loading="lazy" class="h-auto w-full" data-theme-image="light" />
      </div>
    </article>

    {/* Playground */}
    <article class="reveal relative rounded-3xl border border-border-c bg-card p-7">
      <h3 class="mb-2 flex items-center gap-3 text-lg font-semibold text-foreground">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary-soft text-primary-accent"><Play class="h-4.5 w-4.5" /></span>
        Test it in the browser
      </h3>
      <p class="mb-6 text-sm leading-relaxed text-muted-foreground">
        Test your API using the built-in REST client, or debug it using live logs.
      </p>
      {/* Drawn in VectorCraft (design/student-card-live-*.vectorcraft), one per theme. */}
      <div aria-hidden="true">
        <img src="/student-card-live-dark.webp" alt="" width="320" height="200" loading="lazy" class="h-auto w-full" data-theme-image="dark" />
        <img src="/student-card-live-light.webp" alt="" width="320" height="200" loading="lazy" class="h-auto w-full" data-theme-image="light" />
      </div>
    </article>
  </div>

  {/* Home's "Query it like a real backend" and "Every feature on every plan",
      shared, both reworded for students. */}
  <Fragment slot="extra">
    <HomeQuery
      title="What APIs can do"
      lead={'Plain APIs are no use, here are filters, sorting, relationships and so on.\nNothing to switch on, and they all combine.'}
      rewrite={{
        filter: {
          body: 'Add a query parameter with a field name and value (`?brand=Samsung`), and you get back only the records that match. You can also use operators such as `?brand[contains]=sam`, which ignores case. The others are `gt`, `gte`, `lt` and `lte`, for comparing numbers and dates.',
          url: '/acme/products?brand=Samsung',
        },
        sort: {
          body: 'Add `?_sort=` with a field name to put the records in order, such as `?_sort=price`. `?_sort=created` lists the newest first, and `_direction=asc` or `desc` sets the order yourself.',
        },
        page: {
          body: 'Add `?_page=2&_limit=10` to get the second page of 10 records. The `X-Total-Count` header tells you how many records there are in all, so you can show page numbers.',
        },
        expand: {
          body: 'Give a record a `userId` field and add `?_expand=users`, and the matching user comes back inside the record. One request, instead of one per record.',
        },
        time: {
          body: 'Every record you create gets `createdAt` and `updatedAt`, and every update moves `updatedAt` on. The server sets them, so whatever your app sends for them is replaced.',
        },
        openapi: {
          body: 'Open `/<project>/openapi.json` for a description of every live endpoint in your API. Load it into Swagger UI or Postman to try it out, or to generate client code.',
        },
      }}
    />
    <HomePlans
      title="Student friendly pricing"
      alignTop
      hideMore
      lead="Start free, with every feature and no credit card. Sign up with your university email and the Starter AI pack is free too."
      included={[]}
      cards={[
        {
          name: 'Free',
          price: '$0',
          per: '',
          rows: [
            '10,000 requests per month',
            '5 requests per second',
            'Bursts of 20',
            { text: 'Sign up bonus 1,000 AI credits', note: 'Valid for 3 months' },
          ],
          featured: false,
        },
        {
          name: 'Starter AI pack',
          was: '$9.99',
          price: '',
          per: '',
          rows: ['5,000 AI credits', 'Valid for 12 months', 'Free with your university email', 'Works on the Free plan'],
          featured: true,
          badge: 'Student offer',
        },
      ]}
    />
  </Fragment>
</RoleLayout>

<script>
  /*
    The hero's two cursors are physical objects. They move only when the
    mouse runs into one — its pointer or its name chip — and the hit carries
    the mouse's direction and a small share of its speed, capped, so a
    collision nudges a cursor rather than launching it. An off-centre hit spins it, and it rights
    itself as it slows. It glides with drag, bounces off the hero's edges
    losing some energy each time, the two can knock into each other, and a
    second after its last hit a cursor eases back to its spot.
    Decoration only: with JS off, on a screen too narrow to show them, or with
    reduced motion, they stay where they are. The motion is a `transform`,
    never `translate`, which the entrance animation owns on the same element,
    and the loop runs only while something is moving.
  */
  const area = document.querySelector<HTMLElement>('[data-push-area]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-pushable]')];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (area && items.length && !reduced) {
    const DRAG = 0.94; // velocity kept per frame (at 60fps)
    const SPIN_DRAG = 0.93; // angular velocity kept per frame
    const RIGHTING = 0.012; // how strongly a tilted cursor turns back upright
    const BOUNCE = 0.72; // energy kept when hitting an edge
    const HIT = 0.18; // share of the mouse's speed a hit passes on
    const MAX_SPEED = 3; // px per frame — a collision is a nudge, never a launch
    const TORQUE = 0.0025; // spin per unit of off-centre hit
    const PAD = 6; // gap kept from the hero's edges
    const HOME = 0.0006; // spring pulling a resting cursor back to its spot
    const SETTLE_MS = 1000; // how long after its last hit a cursor heads home

    type Body = { el: HTMLElement; x: number; y: number; vx: number; vy: number; a: number; va: number; inside: boolean; hit: number };
    const bodies: Body[] = items.map((el) => ({ el, x: 0, y: 0, vx: 0, vy: 0, a: 0, va: 0, inside: false, hit: 0 }));
    let frame = 0;
    let last = 0;
    let mouse = { x: 0, y: 0, t: 0, vx: 0, vy: 0 };

    const visible = (b: Body) => getComputedStyle(b.el.parentElement!).display !== 'none';

    // A cursor's drawn extent: its pointer box and the name chip it carries.
    const extent = (el: HTMLElement) => {
      let { left, top, right, bottom } = el.getBoundingClientRect();
      for (const img of el.querySelectorAll('img')) {
        if (getComputedStyle(img).display === 'none') continue;
        const r = img.getBoundingClientRect();
        left = Math.min(left, r.left); top = Math.min(top, r.top);
        right = Math.max(right, r.right); bottom = Math.max(bottom, r.bottom);
      }
      return { left, top, right, bottom, cx: (left + right) / 2, cy: (top + bottom) / 2, w: right - left, h: bottom - top };
    };

    // Spin about the cursor's middle (pointer and chip), not its pointer box —
    // measured at its first hit, once the entrance animation has settled.
    const pivot = (b: Body) => {
      if (b.el.style.transformOrigin) return;
      const box = b.el.getBoundingClientRect();
      const e = extent(b.el);
      b.el.style.transformOrigin = `${e.cx - box.left}px ${e.cy - box.top}px`;
    };

    const apply = (b: Body) => {
      b.el.style.transform = `translate(${b.x}px, ${b.y}px) rotate(${b.a}deg)`;
    };

    const step = (now: number) => {
      const k = last ? Math.min((now - last) / 16.7, 3) : 1; // frames elapsed
      last = now;
      const bounds = area.getBoundingClientRect();
      let moving = false;

      for (const b of bodies) {
        // Left alone for a moment, a cursor eases back to its spot by the
        // headline: a soft spring, with the drag below keeping it from
        // overshooting.
        if (!b.inside && now - b.hit > SETTLE_MS) {
          b.vx -= b.x * HOME * k;
          b.vy -= b.y * HOME * k;
        }
        b.x += b.vx * k;
        b.y += b.vy * k;
        b.a += b.va * k;
        b.vx *= DRAG ** k;
        b.vy *= DRAG ** k;
        b.va = (b.va - b.a * RIGHTING * k) * SPIN_DRAG ** k;
        apply(b);
        // Bounce off the hero's edges, keeping the whole cursor inside.
        const e = extent(b.el);
        if (e.left < bounds.left + PAD) { b.x += bounds.left + PAD - e.left; b.vx = Math.abs(b.vx) * BOUNCE; b.va *= -0.6; }
        if (e.right > bounds.right - PAD) { b.x -= e.right - (bounds.right - PAD); b.vx = -Math.abs(b.vx) * BOUNCE; b.va *= -0.6; }
        if (e.top < bounds.top + PAD) { b.y += bounds.top + PAD - e.top; b.vy = Math.abs(b.vy) * BOUNCE; }
        if (e.bottom > bounds.bottom - PAD) { b.y -= e.bottom - (bounds.bottom - PAD); b.vy = -Math.abs(b.vy) * BOUNCE; }
        apply(b);
        if (Math.hypot(b.vx, b.vy) > 0.03 || Math.abs(b.va) > 0.03 || Math.abs(b.a) > 0.2 || Math.hypot(b.x, b.y) > 0.5) moving = true;
      }

      // The two cursors knock into each other, as circles of equal mass.
      if (bodies.length === 2 && bodies.every(visible)) {
        const [p, q] = bodies;
        const ep = extent(p.el), eq = extent(q.el);
        const dx = eq.cx - ep.cx, dy = eq.cy - ep.cy;
        const dist = Math.hypot(dx, dy) || 1;
        const reach = (Math.min(ep.w, ep.h) + Math.min(eq.w, eq.h)) / 2;
        if (dist < reach) {
          const nx = dx / dist, ny = dy / dist;
          const overlap = (reach - dist) / 2;
          p.x -= nx * overlap; p.y -= ny * overlap;
          q.x += nx * overlap; q.y += ny * overlap;
          const rel = (q.vx - p.vx) * nx + (q.vy - p.vy) * ny;
          if (rel < 0) {
            p.vx += rel * nx; p.vy += rel * ny;
            q.vx -= rel * nx; q.vy -= rel * ny;
            p.va += rel * 0.4; q.va -= rel * 0.4;
          }
          apply(p); apply(q);
        }
      }

      if (moving) {
        frame = requestAnimationFrame(step);
      } else {
        frame = 0;
        last = 0;
      }
    };

    const wake = () => {
      if (!frame) frame = requestAnimationFrame(step);
    };

    area.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const t = event.timeStamp;
      const dt = Math.max(t - mouse.t, 1);
      // The mouse's speed, in px per frame, smoothed a little.
      const vx = ((event.clientX - mouse.x) / dt) * 16.7;
      const vy = ((event.clientY - mouse.y) / dt) * 16.7;
      mouse = { x: event.clientX, y: event.clientY, t, vx: mouse.vx * 0.3 + vx * 0.7, vy: mouse.vy * 0.3 + vy * 0.7 };
      if (dt > 100) return; // the first move after a pause has no speed to give

      for (const b of bodies) {
        if (!visible(b)) continue;
        const e = extent(b.el);
        const inside = mouse.x >= e.left && mouse.x <= e.right && mouse.y >= e.top && mouse.y <= e.bottom;
        // A collision: the mouse moving into the cursor, or through it.
        if (inside) {
          const speed = Math.hypot(mouse.vx, mouse.vy);
          if (speed > 0.2) {
            pivot(b);
            b.hit = performance.now();
            const share = b.inside ? HIT * 0.35 : HIT; // the first contact hits hardest
            b.vx += mouse.vx * share;
            b.vy += mouse.vy * share;
            const v = Math.hypot(b.vx, b.vy);
            if (v > MAX_SPEED) { b.vx *= MAX_SPEED / v; b.vy *= MAX_SPEED / v; }
            // Off-centre hits spin: the cross product of lever and push.
            const rx = mouse.x - e.cx, ry = mouse.y - e.cy;
            b.va += (rx * mouse.vy - ry * mouse.vx) * TORQUE * share;
            wake();
          }
        }
        b.inside = inside;
      }
    });
  }
</script>

<script>
  import { GOOGLE_CLIENT_ID } from '../../lib/urls';

  /*
    Google One Tap.

    `ux_mode: 'redirect'` and `login_uri` do **not** apply to One Tap, however
    much they look like they should: Google's reference says ux_mode "has no
    impact on the OneTap UX", and One Tap hands its credential to `callback`.
    Configured the other way the prompt renders and the tap does nothing at all
    — the token goes to a callback that was never declared, and no POST is ever
    made. So the credential does pass through this page, and no configuration
    avoids that: under FedCM the browser mediates the prompt and returns the
    token to JavaScript.

    That costs one sentence of the original design, not the rule it protected.
    The callback immediately form-POSTs the token to /auth/google/one-tap on
    THIS origin, the Dashboard API verifies it and 302s to the SPA with the
    session in a URL fragment — so a *Stubbase session token* still never exists
    on the stubbase.dev origin. What briefly does is Google's own ID token:
    short-lived, and pinned by `aud` to our client id, which the API re-checks.

    It has to be a form submission, not fetch — fetch follows the 302 itself and
    the fragment the session rides in never reaches the address bar.

    The endpoint stays on this host because Caddy proxies that one path to the
    API and because the CSRF cookie below is host-only. The authorized redirect
    URI registered for it is now unused (Google no longer posts anything), but
    the JavaScript origin registration is what lets the prompt render at all.
  */

  /*
    Google's script is fetched from here rather than from a tag in the markup,
    so the decision not to prompt is also a decision not to call Google at all:
    a signed-in visitor, or a build with no client id, makes no third-party
    request from this page. It is the only third-party script on the site, and
    this keeps it to the visitors it is actually for.
  */
  function loadGsi(): Promise<void> {
    return new Promise((resolve, reject) => {
      const tag = document.createElement('script');
      tag.src = 'https://accounts.google.com/gsi/client';
      tag.async = true;
      tag.onload = () => resolve();
      tag.onerror = () => reject(new Error('one tap unavailable'));
      document.head.appendChild(tag);
    });
  }

  /*
    Double-submit CSRF, minted here. Google sets `g_csrf_token` itself only when
    *it* posts the credential — the button's redirect mode — and nothing sets it
    on the One Tap callback path, so this page writes the cookie and echoes the
    same value in the body. The API's check is unchanged and still means what it
    meant: only a page on this origin can set and read back a host-only cookie,
    so a matching pair proves the POST came from here and not from someone
    else's form.
  */
  function postCredential(credential: string) {
    const csrf = crypto.randomUUID();
    document.cookie =
      `g_csrf_token=${csrf}; Path=/; SameSite=Lax` +
      (location.protocol === 'https:' ? '; Secure' : '');

    const form = document.createElement('form');
    form.method = 'POST';
    form.action = new URL('/auth/google/one-tap', location.origin).toString();
    for (const [name, value] of [
      ['credential', credential],
      ['g_csrf_token', csrf],
    ]) {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = name;
      input.value = value;
      form.append(input);
    }
    document.body.append(form);
    form.submit();
  }

  async function startOneTap() {
    if (!GOOGLE_CLIENT_ID) return;

    // Someone with a session already sees the signed-in nav; prompting them to
    // sign in would be nonsense. The pre-paint script in BaseLayout stamps this
    // from the cross-origin `stubbase_session` hint before anything renders.
    if (document.documentElement.classList.contains('signed-in')) return;

    // A blocked or offline Google is not an error worth surfacing — the page
    // works, and the nav's Log in link is the path that always exists.
    try {
      await loadGsi();
    } catch {
      return;
    }

    const id = (window as any).google?.accounts?.id;
    if (!id) return;

    id.initialize({
      client_id: GOOGLE_CLIENT_ID,
      callback: (response: { credential?: string }) => {
        if (response?.credential) postCredential(response.credential);
      },
    });
    id.prompt();
  }

  void startOneTap();
</script>

