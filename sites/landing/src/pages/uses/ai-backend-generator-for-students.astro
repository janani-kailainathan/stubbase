  {/*
    The public demo project's six resources, in Home's Free Resources shape: a
    row of big numbers, each opening its live endpoint, then a wall of real
    records drifting past, labelled with the request that returns them.
    The hero's and the footer's "Use Public APIs" land here — keep the id.
  */}
  <section slot="extra" id="free-resources" class="scroll-mt-24">
    <div class="mx-auto max-w-6xl px-6 pt-24 pb-12">
      <div class="reveal mx-auto mb-10 max-w-2xl text-center">
        <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Free APIs to practise with</h2>
        <p class="font-medium text-muted-foreground">
          Six ready-made endpoints full of sample data, for practising fetch, lists and detail
          pages. Filter, search, sort, page and expand them with query parameters. No account, no
          API key.
        </p>
        <p class="mt-6 inline-flex max-w-full items-center gap-3 rounded-2xl border border-border-c bg-card py-2 pr-4 pl-2">
          <span class="shrink-0 rounded-lg bg-muted px-2 py-1 text-[11px] font-semibold tracking-wide whitespace-nowrap text-subtle uppercase">Base URL</span>
          <code class="truncate font-mono text-sm text-emphasis">{CORE_URL}/public</code>
        </p>
      </div>

      <ul class="free-stats reveal grid grid-cols-2 gap-y-10 lg:grid-cols-3 lg:gap-y-14">
        {
          publicResources.map(({ path, count, noun, Icon, tint }) => (
            <li class="free-stat relative flex justify-center">
              <a href={`${CORE_URL}/public${path}`} class="group flex flex-col items-center text-center" style={`--tint: ${tint}`}>
                <span class="flex items-center gap-3">
                  <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-(--tint)/15 text-(--tint) sm:h-12 sm:w-12">
                    <Icon class="h-5 w-5 sm:h-6 sm:w-6" />
