    <path d="M138 84 L192 62 L246 84 L192 104 Z" fill="currentColor" />
    <path d="M192 83 L238 90 L240 116" stroke-width="2.5" />
    <rect x="235" y="114" width="10" height="14" rx="2" class="fill-primary" stroke-width="2" />
    {/* Other arm, holding a laptop that shows a request. */}
