              <li class="w-full max-w-72 sm:w-72" style={`--tint: ${FEATURE_TINTS[i % FEATURE_TINTS.length]}`}>
                <a href={link.href} class="group flex flex-col items-center text-center">
                  <span class="feature-badge relative mb-6 block h-44 w-36 transition-transform duration-200 group-hover:-translate-y-1">
                    <span class="feature-shield absolute inset-0 bg-border-strong"></span>
                    <span class="feature-shield absolute inset-px flex flex-col items-center bg-card pt-4">
                      <span class="flex items-center gap-1 text-[10px] font-semibold tracking-wide text-subtle uppercase">
