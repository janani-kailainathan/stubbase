                      <span class="mt-3 flex h-11 w-11 items-center justify-center rounded-xl bg-(--tint)/15 text-(--tint)">
                        <Icon class="h-6 w-6" />
                      </span>
                    </span>
                    <span class="absolute inset-x-[-10px] top-[62%] flex h-7 items-center justify-center rounded-sm bg-(--tint) text-[11px] font-bold tracking-widest text-background uppercase">
                      Feature
                    </span>
                  </span>
                  <h3 class="mb-2 font-semibold text-foreground">{link.label}</h3>
                  <p class="mb-4 text-sm leading-relaxed text-muted-foreground">{link.blurb}</p>
                  <span class="inline-flex items-center gap-1.5 text-sm font-medium text-primary-ink transition-colors group-hover:text-primary-ink-hover">
                    Read more
                    <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
