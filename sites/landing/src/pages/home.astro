---
import { Sparkles, FileJson, Terminal, Play, Check, Loader, ArrowRight, ArrowLeft, ArrowUpRight, MousePointer2, Bot, KeyRound, LockOpen, Globe, Newspaper, MessagesSquare, Disc3, Image, ListChecks, Users, Zap } from 'lucide-astro';
// The handwritten accent in the hero headline. Latin only, and imported here so
// no other page downloads it.
import '@fontsource/sedgwick-ave/latin-400.css';
import Layout from '../layouts/Layout.astro';
import HomeStart from '../components/home/HomeStart.astro';
import HomeQuery from '../components/home/HomeQuery.astro';
import HomePipeline from '../components/home/HomePipeline.astro';
import HomeAuth from '../components/home/HomeAuth.astro';
import HomeAgents from '../components/home/HomeAgents.astro';
import HomeWorkspace from '../components/home/HomeWorkspace.astro';
import HomePlans from '../components/home/HomePlans.astro';
import { APP_URL, CORE_URL } from '../lib/urls';
import { NAV_GROUPS } from '../lib/nav';

const publicResources = [
  { path: '/posts', count: 100, noun: 'posts', Icon: Newspaper, tint: 'var(--syntax-fn)' },
  { path: '/comments', count: 500, noun: 'comments', Icon: MessagesSquare, tint: 'var(--syntax-bool)' },
  { path: '/albums', count: 100, noun: 'albums', Icon: Disc3, tint: 'var(--syntax-num)' },
  { path: '/photos', count: 5000, noun: 'photos', Icon: Image, tint: 'var(--syntax-fn)' },
  { path: '/todos', count: 200, noun: 'todos', Icon: ListChecks, tint: 'var(--primary)' },
  { path: '/users', count: 10, noun: 'users', Icon: Users, tint: 'var(--syntax-num)' },
];

// Real records from the `public` demo project, verbatim. Its seed
// (scripts/seed-public-tenant.ts) is deterministic, so these are exactly what
// the links above return; reseeding with a new seed means updating them.
const sampleRecords: { path: string; record: Record<string, string | number | boolean> }[] = [
  { path: '/users/1', record: { id: 1, name: 'Ivy Rossi', username: 'ivyrossi', company: 'Rossi Collective', active: true } },
  { path: '/todos/1', record: { id: 1, userId: 1, title: 'dashboard handoff payload mock sandbox', completed: true } },
  { path: '/comments/1', record: { id: 1, postId: 1, email: 'omarweber@example.com', body: 'Endpoint cursor record api schema payload.' } },
  { path: '/albums/1', record: { id: 1, userId: 1, title: 'endpoint api latency mock' } },
  { path: '/users/2', record: { id: 2, name: 'Yuki Okafor', username: 'yukiokafor', company: 'Okafor Works', active: false } },
  { path: '/photos/1', record: { id: 1, albumId: 1, title: 'draft latency response endpoint', thumbnailUrl: 'https://picsum.photos/seed/stubbase-1/150/150' } },
  { path: '/todos/2', record: { id: 2, userId: 1, title: 'payload billing billing handoff billing draft', completed: false } },
  { path: '/posts/1', record: { id: 1, userId: 1, title: 'latency fixture prototype fixture cursor shipping' } },
];
// Two rows drifting opposite ways. Each is repeated four times and slides by
// half its width, so the loop is seamless and a half still spans a wide screen.
const recordRows = [sampleRecords.slice(0, 4), sampleRecords.slice(4)];

// Read straight from the nav rather than restating the three spokes here: nav.ts
// is the single source of truth, so a new feature page shows up in this section
// the moment it is added there, with no second list to keep in step.
const features = NAV_GROUPS.find((group) => group.key === 'features')!;
// Presentation only, like the nav's icons: a feature added to nav.ts without an
// entry here still renders, with the fallback arrow.
const FEATURE_ICONS: Record<string, typeof ArrowRight> = {
  '/features/ai-rest-api-generation': Sparkles,
  '/features/google-github-social-login': KeyRound,
  '/features/instant-api-deployments': Zap,
};
const FEATURE_TINTS = ['var(--primary)', 'var(--syntax-fn)', 'var(--syntax-bool)'];

---

<Layout
  nav="floating"
  footer="framed"
  cta={{
    title: 'Generate your first API in seconds.',
    body: 'Start from a JSON file, a sentence to the AI Co-Pilot, or one of the free resources. No database to run, no server to deploy.',
    label: 'Generate API (Free)',
    href: APP_URL,
    secondary: { label: 'Use Public APIs', href: '#free-resources' },
    note: 'No login required · Generate an endpoint in 2 seconds',
  }}
  title="Stubbase — The Instant Backend for Frontend & QA Teams"
  description="Generate persistent, relational REST APIs from a JSON file or AI prompt in seconds. Zero database configuration. Built for autonomous frontend development and deterministic chaos testing."
>
  {/*
    Hero, after xmind.com's: a centred two-line headline with one handwritten
    accent word, on a dot-grid canvas with pieces of a working project pinned
    around it and teammates' cursors pointing at them. The pieces are
    decoration (aria-hidden, desktop only); everything they say is also said
    in the page's own text. The H1 wording is unchanged — it is an SEO target.
    No script: the entrance and the cursors' drift are CSS, and both stop
    under prefers-reduced-motion.
  */}
  <section class="hero relative overflow-hidden">
    <div class="hero-dots pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-6 pt-16 pb-16 lg:pt-24 xl:pt-32 xl:pb-40">
      {/* Only from xl: below that the headline needs the width the pieces sit in. */}
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 mx-6 hidden xl:block">
        {/* Top left: a resource file, wired to what it becomes. */}
        <div class="hero-piece absolute top-12 left-0 w-56 [--d:0.35s]">
          <div class="rounded-xl border border-border-c bg-card">
            <div class="flex items-center gap-2 border-b border-border-c px-3 py-2 font-mono text-[11px] text-subtle">
              <FileJson class="h-3.5 w-3.5 text-primary-accent" />
              artists.json
            </div>
            <pre class="px-3 py-2.5 font-mono text-[11px] leading-relaxed text-code-fg"><span class="text-syntax-punct">[{"{"}</span>
  <span class="text-syntax-str">"id"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-num">1</span><span class="text-syntax-punct">,</span>
  <span class="text-syntax-str">"name"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-fn">"Ava Chen"</span><span class="text-syntax-punct">,</span>
  <span class="text-syntax-str">"albumIds"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-punct">[</span><span class="text-syntax-num">3</span><span class="text-syntax-punct">,</span> <span class="text-syntax-num">7</span><span class="text-syntax-punct">]</span>
<span class="text-syntax-punct">{"}"}]</span></pre>
          </div>
          <div class="ml-6 h-6 w-px border-l border-dashed border-border-strong"></div>
          <div class="ml-6 flex items-center">
            <div class="w-5 border-t border-dashed border-border-strong"></div>
            <div class="rounded-lg border border-border-c bg-muted px-3 py-2 text-xs leading-snug text-muted-foreground">
              A relational REST API,<br />live in 2 seconds
            </div>
          </div>
          <div class="hero-cursor absolute top-3 -right-20 [--c:var(--syntax-str)] [--drift:6px]">
            <MousePointer2 class="h-5 w-5 fill-current text-(--c)" />
            <span class="mt-0.5 ml-3 inline-flex items-center gap-1.5 rounded-full border border-border-c bg-card py-0.5 pr-2.5 pl-0.5 text-xs font-medium whitespace-nowrap text-(--c)">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-(--c) text-[10px] font-bold text-background">F</span>
              Frontend dev
            </span>
          </div>
        </div>

        {/* Top right: a write, and where it went. */}
        <div class="hero-piece absolute top-20 right-4 w-36 [--d:0.5s]">
          <div class="rounded-lg border border-primary-soft-border bg-primary-soft p-3">
            <p class="font-mono text-xs text-subtle">201</p>
            <p class="text-3xl font-extrabold text-foreground">POST</p>
            <p class="font-mono text-xs text-muted-foreground">/artists</p>
            <p class="font-mono text-[11px] text-subtle">[written to disk]</p>
          </div>
          <div class="ml-10 h-6 w-px bg-border-strong"></div>
          <div class="rounded-lg border border-border-c bg-muted px-3 py-2 text-xs leading-snug text-muted-foreground">
            Persistent,<br />not a mock
          </div>
          <div class="hero-cursor absolute -top-10 -left-32 flex flex-col items-end [--c:var(--syntax-num)] [--drift:-5px]">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border-c bg-card py-0.5 pr-2.5 pl-0.5 text-xs font-medium whitespace-nowrap text-(--c)">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-(--c) text-[10px] font-bold text-background">Q</span>
              QA engineer
            </span>
            <MousePointer2 class="mt-0.5 mr-1 h-5 w-5 -scale-x-100 rotate-180 fill-current text-(--c)" />
          </div>
        </div>

        {/* Bottom left: a read, with a loose curve back towards the buttons. */}
        <div class="hero-piece absolute bottom-6 left-10 flex items-end gap-2 [--d:0.65s]">
          <div class="w-32 rounded-lg border border-border-c bg-card p-3">
            <p class="font-mono text-xs text-subtle">200</p>
            <p class="text-3xl font-extrabold text-foreground">GET</p>
            <p class="font-mono text-xs text-muted-foreground">/albums</p>
            <p class="font-mono text-[11px] text-subtle">[100 records]</p>
          </div>
          <svg class="mb-6 h-14 w-24 text-border-strong" viewBox="0 0 96 56" fill="none">
            <path d="M4 48 H44 Q72 48 76 24 V10" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4" stroke-linecap="round" />
            <path d="M70 16 L76 8 L82 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        {/* Bottom right: a failure, on purpose. */}
        <div class="hero-piece absolute right-0 bottom-4 [--d:0.8s]">
          <div class="ml-auto w-fit rounded-lg border border-border-c bg-muted px-3 py-2 text-xs leading-snug text-muted-foreground">
            Deterministic<br />chaos testing
          </div>
          <div class="mr-12 ml-auto h-5 w-px bg-border-strong"></div>
          <div class="flex items-stretch gap-2">
            <div class="rounded-lg border border-border-c bg-card px-3 py-2 font-mono text-[11px] leading-relaxed">
              <span class="text-syntax-str">x-stubbase-delay</span><span class="text-syntax-punct">:</span> <span class="text-syntax-num">800</span><br />
              <span class="text-syntax-str">x-stubbase-status</span><span class="text-syntax-punct">:</span> <span class="text-syntax-num">503</span>
            </div>
            <div class="flex flex-col justify-center rounded-lg border border-border-c bg-card px-3 text-center">
              <p class="text-xl font-extrabold text-foreground">503</p>
              <p class="font-mono text-[10px] text-subtle">after 800 ms</p>
            </div>
          </div>
          <div class="hero-cursor absolute top-2 -left-24 [--c:var(--syntax-bool)] [--drift:4px]">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border-c bg-card py-0.5 pr-2.5 pl-0.5 text-xs font-medium whitespace-nowrap text-(--c)">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-(--c) text-background"><Bot class="h-3 w-3" /></span>
              AI agent
            </span>
            <MousePointer2 class="mt-0.5 ml-auto h-5 w-5 -scale-x-100 fill-current text-(--c)" />
          </div>
        </div>
      </div>

      <div class="relative mx-auto max-w-4xl text-center">
        <h1 class="hero-rise text-4xl leading-[1.08] font-extrabold tracking-tight text-foreground sm:text-5xl lg:text-6xl 2xl:text-7xl">
          The <span class="hero-accent">Instant</span> Backend{' '}<br class="hidden sm:inline" />
          for Frontend &amp; QA Teams
        </h1>
        <p class="hero-rise mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground [--d:0.1s]">
          Generate persistent, relational REST APIs from a JSON file or AI prompt in seconds. Zero
          database configuration. Built for autonomous frontend development and deterministic chaos
          testing.
        </p>

        <div class="hero-rise mt-8 flex flex-wrap items-center justify-center gap-3 [--d:0.2s]">
          {/* Two-layer buttons, as xmind's: a faint outer ring around the button itself. */}
          <a href={APP_URL} class="group rounded-2xl bg-muted-hover p-1">
            <span class="flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-base font-semibold text-primary-foreground transition-colors group-hover:bg-primary-hover">
              <span class="hero-mark h-5 w-5 bg-current" aria-hidden="true"></span>
              Generate API (Free)
            </span>
          </a>
          <a href="#free-resources" class="group rounded-2xl bg-muted-hover p-1">
            <span class="flex items-center rounded-xl border border-border-c bg-card px-5 py-2.5 text-base font-semibold text-foreground transition-colors group-hover:bg-muted">
              Use Public APIs
            </span>
          </a>
        </div>
        <p class="hero-rise mt-4 text-sm text-subtle [--d:0.3s]">
          No login required · Generate an endpoint in 2 seconds
        </p>
      </div>
    </div>

    <div class="hero-rise relative mx-auto max-w-5xl px-6 pb-20 [--d:0.4s]">
      <div class="rounded-2xl bg-muted-hover p-1.5">
        <div class="overflow-hidden rounded-xl border border-border-c bg-background p-2">
          <img
            src="/dashboard-ui.png"
            alt="Stubbase Dashboard UI"
            class="w-full rounded-lg border border-border-faint"
          />
        </div>
      </div>
    </div>
  </section>

  <HomeStart />

  <HomeQuery />

  {/*
    Try it live, after xmind's "Global security & privacy" grid: white cards
    around one tall dark card. Here the tall card is the terminal the Run
    button fills, so the answer lands where the eye already is. The runner
    script below owns #run-script-btn, #output-container, #script-output,
    #success-msg and #output-placeholder — keep the ids.
  */}
  <section>
    <div class="mx-auto max-w-6xl px-6 py-24">
      <div class="reveal mx-auto mb-12 max-w-2xl text-center">
        <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Try it live</h2>
        <p class="font-medium text-muted-foreground">
          Run this code here, in your console, or from any frontend application.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-5 lg:grid-cols-3 lg:grid-rows-[auto_1fr] [&>*]:min-w-0">
        {/* The request. */}
        <div class="reveal flex flex-col rounded-3xl border border-border-c bg-card p-6 sm:p-8 lg:col-span-2">
          <h3 class="mb-2 text-xl font-semibold text-foreground">One call to a live API</h3>
          <p class="mb-6 max-w-lg text-muted-foreground">
            A real request to the public demo project, answered by the same engine that serves yours.
          </p>
          <div class="overflow-hidden rounded-2xl border border-border-c bg-code-bg text-left">
            <div class="flex items-center gap-2 border-b border-border-c bg-chrome px-4 py-3">
              <Terminal class="h-4 w-4 text-subtle" />
              <span class="font-mono text-xs text-subtle">fetch.js</span>
            </div>
            <pre
              class="overflow-x-auto p-5 font-mono text-sm leading-relaxed text-emphasis"><code><span class="text-syntax-fn">fetch</span>(<span class="text-syntax-str">'{CORE_URL}/public/users/1'</span>)
  .<span class="text-syntax-fn">then</span>(response =&gt; response.<span class="text-syntax-fn">json</span>())
  .<span class="text-syntax-fn">then</span>(json =&gt; console.<span class="text-syntax-fn">log</span>(json))</code></pre>
          </div>
          <div class="mt-6">
            <span class="inline-block rounded-2xl bg-muted-hover p-1">
              <button
                id="run-script-btn"
                class="flex items-center gap-2 rounded-xl bg-contrast px-5 py-2.5 text-sm font-semibold text-contrast-foreground transition-colors hover:bg-contrast-hover"
              >
                <span class="flex items-center gap-2 data-[hidden]:hidden" data-state="idle">
                  <Play class="h-4 w-4" /> Run script
                </span>
                <span class="hidden items-center gap-2 data-[hidden]:hidden" data-state="loading">
                  <Loader class="h-4 w-4 animate-spin" /> Running...
                </span>
                <span class="hidden items-center gap-2 data-[hidden]:hidden" data-state="done">
                  <Check class="h-4 w-4 text-primary-accent" /> Done
                </span>
              </button>
            </span>
          </div>
        </div>

        {/* The answer: the tall dark card. */}
        <div class="reveal try-terminal relative flex min-h-96 flex-col overflow-hidden rounded-3xl border border-border-c p-6 sm:p-8 lg:row-span-2">
          <h3 class="relative mb-2 text-xl font-semibold text-foreground">The response</h3>
          <p class="relative mb-6 text-muted-foreground">Straight from the API, highlighted as it lands.</p>

          <div id="output-placeholder" class="relative flex flex-1 flex-col items-center justify-center text-center">
            <div class="try-badge relative mb-5 flex h-28 w-28 items-center justify-center rounded-full">
              <span class="flex h-16 w-16 items-center justify-center rounded-2xl border border-primary-soft-border bg-primary-soft text-primary-accent">
                <Play class="h-7 w-7" />
              </span>
            </div>
            <p class="font-mono text-xs text-subtle">GET /public/users/1</p>
            <p class="mt-1 text-sm text-muted-foreground">Press Run script to call it.</p>
          </div>

          <div
            id="output-container"
            class="relative hidden overflow-hidden rounded-2xl border border-border-c bg-code-bg text-left"
          >
            <div class="flex items-center gap-2 border-b border-border-c bg-chrome px-4 py-3">
              <FileJson class="h-4 w-4 text-subtle" />
              <span class="font-mono text-xs text-subtle">Output</span>
            </div>
            <div
              id="script-output"
              class="overflow-x-auto p-5 font-mono text-xs leading-relaxed text-emphasis"
            >
            </div>
          </div>

          <p id="success-msg" class="relative mt-5 hidden text-sm text-muted-foreground">
            Congrats! You've made your first call to Stubbase. 🎉
          </p>
        </div>

        {/* Two small cards: why that call works from anywhere. */}
        <div class="reveal rounded-3xl border border-border-c bg-card p-6 sm:p-8">
          <span class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-primary-soft text-primary-accent">
            <LockOpen class="h-6 w-6" />
          </span>
          <h3 class="mb-2 text-lg font-semibold text-foreground">No login, no API key</h3>
          <p class="text-sm leading-relaxed text-muted-foreground">
            The demo project is public, so this call needs nothing from you. Paste it into your
            console and it answers there too.
          </p>
        </div>
        <div class="reveal rounded-3xl border border-border-c bg-card p-6 sm:p-8">
          <span class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-(--syntax-fn)/15 text-syntax-fn">
            <Globe class="h-6 w-6" />
          </span>
          <h3 class="mb-2 text-lg font-semibold text-foreground">Open to every origin</h3>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Public routes answer with <code class="font-mono text-xs text-emphasis">Access-Control-Allow-Origin: *</code>,
            so the same fetch runs from localhost or your deployed app.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/*
    Free Resources, after xmind's "Join millions who think with Xmind": a row
    of big numbers, then a wall of cards drifting past. Xmind's cards are
    testimonials; these are real records from the demo project, labelled with
    the request that returns them, so nothing here reads as a quote.
  */}
  <section id="free-resources">
    <div class="mx-auto max-w-6xl px-6 pt-24 pb-12">
      <div class="reveal mx-auto mb-10 max-w-2xl text-center">
        <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Free Resources</h2>
        <p class="font-medium text-muted-foreground">
          Stubbase comes with a set of 6 common resources for quick frontend prototyping.<br />
          No account required.
        </p>
        <p class="mt-6 inline-flex max-w-full items-center gap-3 rounded-2xl border border-border-c bg-card py-2 pr-4 pl-2">
          <span class="shrink-0 rounded-lg bg-muted px-2 py-1 text-[11px] font-semibold tracking-wide whitespace-nowrap text-subtle uppercase">Base URL</span>
          <code class="truncate font-mono text-sm text-emphasis">{CORE_URL}/public</code>
        </p>
      </div>

      <ul class="free-stats reveal grid grid-cols-2 gap-y-10 lg:grid-cols-3 lg:gap-y-14">
        {
          publicResources.map(({ path, count, noun, Icon, tint }) => (
            <li class="free-stat relative flex justify-center">
              <a href={`${CORE_URL}/public${path}`} class="group flex flex-col items-center text-center" style={`--tint: ${tint}`}>
                <span class="flex items-center gap-3">
                  <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-(--tint)/15 text-(--tint) sm:h-12 sm:w-12">
                    <Icon class="h-5 w-5 sm:h-6 sm:w-6" />
                  </span>
                  <span class="text-4xl font-bold tracking-tight text-foreground tabular-nums sm:text-5xl">
                    {count.toLocaleString('en-US')}
                  </span>
                </span>
                <span class="mt-2 font-mono text-sm text-primary-ink underline-offset-4 group-hover:text-primary-ink-hover group-hover:underline">
                  {path}
                </span>
                <span class="sr-only">{count} {noun}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div role="group" aria-label="Sample records from the demo project" class="free-marquee reveal space-y-4 pb-10">
      {
        recordRows.map((row, r) => (
          <div class="free-track flex w-max gap-4" data-direction={r === 0 ? 'left' : 'right'}>
            {[...row, ...row, ...row, ...row].map(({ path, record }, i) => (
              <article aria-hidden={i >= row.length ? 'true' : undefined} class="w-72 shrink-0 rounded-2xl border border-border-c bg-card p-4 sm:w-80">
                <p class="mb-3 flex items-center justify-between border-b border-border-c pb-3 font-mono text-xs">
                  <span><span class="text-subtle">GET</span> <span class="text-foreground">/public{path}</span></span>
                  <span class="font-semibold text-primary-ink">200</span>
                </p>
                <pre class="font-mono text-[11px] leading-5 text-code-fg"><span class="text-syntax-punct">{'{'}</span>{Object.entries(record).map(([key, value]) => (
  <span class="block truncate pl-3"><span class="text-syntax-str">"{key}"</span><span class="text-syntax-punct">: </span>{typeof value === 'string' ? <span class="text-syntax-fn">"{value}"</span> : typeof value === 'boolean' ? <span class="text-syntax-bool">{String(value)}</span> : <span class="text-syntax-num">{value}</span>}</span>
))}<span class="text-syntax-punct">{'}'}</span></pre>
              </article>
            ))}
          </div>
        ))
      }
    </div>

    <p class="reveal mx-auto max-w-2xl px-6 pb-24 text-center text-sm text-muted-foreground">
      <strong class="font-semibold text-foreground">Need custom fields?</strong> Edit these APIs in the{' '}
      <a href={APP_URL} class="font-semibold text-primary-ink underline underline-offset-4 hover:text-primary-ink-hover">
        Stubbase Dashboard
      </a>{' '}
      to add delays, errors, or your own data.
    </p>
  </section>

  <HomePipeline />

  <HomeAuth />

  <HomeAgents />

  <HomeWorkspace />

  <HomePlans />

  {/*
