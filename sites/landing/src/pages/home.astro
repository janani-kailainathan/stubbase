</Layout>

<script>
  import { CORE_URL } from '../lib/urls';

  const btn = document.getElementById('run-script-btn') as HTMLButtonElement | null;
  const outContainer = document.getElementById('output-container');
  const outText = document.getElementById('script-output');
  const successMsg = document.getElementById('success-msg');
  const placeholder = document.getElementById('output-placeholder');

  const FALLBACK_USER = { id: 1, name: 'Ava Chen', role: 'admin', active: true };

  function setButtonState(state: 'idle' | 'loading' | 'done') {
    btn?.querySelectorAll<HTMLElement>('[data-state]').forEach((span) => {
      span.classList.toggle('hidden', span.dataset.state !== state);
      span.classList.toggle('flex', span.dataset.state === state);
    });
    if (state === 'done' && btn) {
      btn.classList.remove('bg-contrast', 'hover:bg-contrast-hover', 'text-contrast-foreground');
      btn.classList.add('border', 'border-border-c', 'bg-card', 'text-foreground');
    }
  }

  function highlightJson(value: unknown): string {
    const json = JSON.stringify(value, null, 2)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
    const tokenRe =
      /("(?:\\u[0-9a-fA-F]{4}|\\[^u]|[^\\"])*")(\s*:)?|\b(true|false|null)\b|(-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)|([{}[\],])/g;
    return json.replace(tokenRe, (match, str, colon, boolNull, num, punct) => {
      if (str) {
        const cls = colon ? 'text-syntax-str' : 'text-syntax-fn';
        return `<span class="${cls}">${str}</span>${colon ?? ''}`;
      }
      if (boolNull) return `<span class="text-syntax-bool">${boolNull}</span>`;
      if (num) return `<span class="text-syntax-num">${num}</span>`;
      if (punct) return `<span class="text-subtle">${punct}</span>`;
      return match;
    });
  }

  btn?.addEventListener('click', async () => {
    btn.disabled = true;
    setButtonState('loading');

    let data: unknown;
    try {
      const response = await fetch(`${CORE_URL}/public/users/1`);
      if (!response.ok) throw new Error(String(response.status));
      data = await response.json();
    } catch {
      data = FALLBACK_USER;
    }

    if (outText) outText.innerHTML = `<pre class="whitespace-pre-wrap">${highlightJson(data)}</pre>`;
    placeholder?.classList.add('hidden');
    outContainer?.classList.remove('hidden');
    successMsg?.classList.remove('hidden');
    setButtonState('done');
    btn.disabled = false;
  });
</script>

<script>
  import { GOOGLE_CLIENT_ID } from '../lib/urls';

  /*
    Google One Tap.

    `ux_mode: 'redirect'` and `login_uri` do **not** apply to One Tap, however
    much they look like they should: Google's reference says ux_mode "has no
    impact on the OneTap UX", and One Tap hands its credential to `callback`.
    Configured the other way the prompt renders and the tap does nothing at all
    — the token goes to a callback that was never declared, and no POST is ever
    made. So the credential does pass through this page, and no configuration
    avoids that: under FedCM the browser mediates the prompt and returns the
    token to JavaScript.

    That costs one sentence of the original design, not the rule it protected.
    The callback immediately form-POSTs the token to /auth/google/one-tap on
    THIS origin, the Dashboard API verifies it and 302s to the SPA with the
    session in a URL fragment — so a *Stubbase session token* still never exists
    on the stubbase.dev origin. What briefly does is Google's own ID token:
    short-lived, and pinned by `aud` to our client id, which the API re-checks.

    It has to be a form submission, not fetch — fetch follows the 302 itself and
    the fragment the session rides in never reaches the address bar.

    The endpoint stays on this host because Caddy proxies that one path to the
    API and because the CSRF cookie below is host-only. The authorized redirect
    URI registered for it is now unused (Google no longer posts anything), but
    the JavaScript origin registration is what lets the prompt render at all.
  */

  /*
    Google's script is fetched from here rather than from a tag in the markup,
    so the decision not to prompt is also a decision not to call Google at all:
    a signed-in visitor, or a build with no client id, makes no third-party
    request from this page. It is the only third-party script on the site, and
    this keeps it to the visitors it is actually for.
  */
  function loadGsi(): Promise<void> {
    return new Promise((resolve, reject) => {
      const tag = document.createElement('script');
      tag.src = 'https://accounts.google.com/gsi/client';
      tag.async = true;
      tag.onload = () => resolve();
      tag.onerror = () => reject(new Error('one tap unavailable'));
      document.head.appendChild(tag);
    });
  }

  /*
    Double-submit CSRF, minted here. Google sets `g_csrf_token` itself only when
    *it* posts the credential — the button's redirect mode — and nothing sets it
    on the One Tap callback path, so this page writes the cookie and echoes the
    same value in the body. The API's check is unchanged and still means what it
    meant: only a page on this origin can set and read back a host-only cookie,
    so a matching pair proves the POST came from here and not from someone
    else's form.
  */
  function postCredential(credential: string) {
    const csrf = crypto.randomUUID();
    document.cookie =
      `g_csrf_token=${csrf}; Path=/; SameSite=Lax` +
      (location.protocol === 'https:' ? '; Secure' : '');

    const form = document.createElement('form');
    form.method = 'POST';
    form.action = new URL('/auth/google/one-tap', location.origin).toString();
    for (const [name, value] of [
      ['credential', credential],
      ['g_csrf_token', csrf],
    ]) {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = name;
      input.value = value;
      form.append(input);
    }
    document.body.append(form);
    form.submit();
  }

  async function startOneTap() {
    if (!GOOGLE_CLIENT_ID) return;

    // Someone with a session already sees the signed-in nav; prompting them to
    // sign in would be nonsense. The pre-paint script in BaseLayout stamps this
    // from the cross-origin `stubbase_session` hint before anything renders.
    if (document.documentElement.classList.contains('signed-in')) return;

    // A blocked or offline Google is not an error worth surfacing — the page
    // works, and the nav's Log in link is the path that always exists.
    try {
      await loadGsi();
    } catch {
      return;
    }

    const id = (window as any).google?.accounts?.id;
    if (!id) return;

    id.initialize({
      client_id: GOOGLE_CLIENT_ID,
      callback: (response: { credential?: string }) => {
        if (response?.credential) postCredential(response.credential);
      },
    });
    id.prompt();
  }

  void startOneTap();
</script>

{/*
  Global, not scoped: the sections in components/home/ share these classes
  (reveal, bento, the pipeline tabs, the cursors). The page is the only one that
  imports them, so they load on /home alone.
*/}
<style is:global>
  /* The canvas: a dot grid that fades out towards the edges. */
  .hero-dots {
    background-image: radial-gradient(var(--border-strong) 1px, transparent 1px);
    background-size: 20px 20px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 30%, transparent 75%);
    opacity: 0.6;
  }

  /* The one handwritten word, on a tinted card like a sticky note. */
  .hero-accent {
    display: inline-block;
    padding: 0 0.12em;
    font-family: 'Sedgwick Ave', cursive;
    font-weight: 400;
    color: var(--primary-ink);
    background: var(--primary-soft);
    rotate: -2deg;
  }

  /* The logo mark in the button's own text colour, whatever the theme. */
  .hero-mark {
    mask: url('/stubbase-logo.svg') center / contain no-repeat;
  }

  /* Entrance: the text rises out of a blur, then the canvas pieces follow.
     `--d` staggers them. */
  .hero-rise,
  .hero-piece {
    animation: hero-in 700ms cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both;
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      filter: blur(8px);
      translate: 0 12px;
    }
  }

  /* Teammates' cursors drift a few pixels, as if someone were holding them. */
  .hero-cursor {
    animation: hero-drift 5s ease-in-out infinite alternate;
  }
  @keyframes hero-drift {
    to {
      translate: var(--drift, 5px) calc(var(--drift, 5px) * -0.6);
    }
  }

  /* Capability cards: the card surface with a wash of its own colour rising
     from the bottom right, where the drawing sits. */
  .bento {
    background:
      radial-gradient(90% 80% at 100% 100%, color-mix(in oklab, var(--tint) 16%, transparent), transparent 70%),
      var(--card);
  }
  .bento-link {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 10;
    display: flex;
    height: 2.25rem;
    width: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--contrast);
    color: var(--contrast-foreground);
    transition: background-color 150ms ease;
  }
  .bento-link:hover {
    background: var(--contrast-hover);
  }
  .bento-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  /* Pipeline tabs. The checked radio picks its tab's look and its panel; the
     first panel is also the fallback if nothing is checked. */
  .pipe-panel {
    display: none;
    background: color-mix(in oklab, var(--tint) 9%, var(--card));
    border: 1px solid color-mix(in oklab, var(--tint) 18%, var(--border-c));
  }
  .pipeline:has(input[value='auth']:checked) [data-stage='auth'],
  .pipeline:has(input[value='chaos']:checked) [data-stage='chaos'],
  .pipeline:has(input[value='validation']:checked) [data-stage='validation'],
  .pipeline:has(input[value='hooks']:checked) [data-stage='hooks'],
  .pipeline:has(input[value='notify']:checked) [data-stage='notify'] {
    display: block;
  }

  /* Query section: the open item picks the preview; with every item closed,
     the first preview stays up rather than leaving an empty frame. */
  .q-preview {
    display: none;
  }
  .query:has(details[data-q='filter'][open]) .q-preview[data-q='filter'],
  .query:has(details[data-q='sort'][open]) .q-preview[data-q='sort'],
  .query:has(details[data-q='page'][open]) .q-preview[data-q='page'],
  .query:has(details[data-q='expand'][open]) .q-preview[data-q='expand'],
  .query:has(details[data-q='time'][open]) .q-preview[data-q='time'],
  .query:has(details[data-q='openapi'][open]) .q-preview[data-q='openapi'],
  .query:not(:has(details[open])) .q-preview[data-q='filter'] {
    display: flex;
  }
  .q-item[open] {
    border-color: var(--border-strong);
  }

  /* Agent cards: a picture on a wash of the card's own colour, as xmind's
     integration cards sit on their brand colours. */
  .agent-art {
    background:
      radial-gradient(90% 90% at 100% 0%, color-mix(in oklab, var(--tint) 22%, transparent), transparent 70%),
      color-mix(in oklab, var(--tint) 7%, var(--card));
  }
  .pipe-tab:has(:checked) {
    background: var(--card);
    border-color: var(--border-c);
    color: var(--foreground);
  }
  .pipe-tab:has(:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  /* The held-open request: a striped bar that fills to the delay. */
  .chaos-wait {
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in oklab, var(--syntax-num) 45%, transparent) 0 4px,
      color-mix(in oklab, var(--syntax-num) 20%, transparent) 4px 8px
    );
  }

  /* Try it live's tall card: the code surface with an emerald glow rising
     behind the badge, as xmind's dark certificate card. */
  .try-terminal {
    background:
      radial-gradient(70% 55% at 50% 60%, color-mix(in oklab, var(--primary) 16%, transparent), transparent 70%),
      var(--code-bg);
  }
  /* Two soft rings around the badge, breathing slowly. */
  .try-badge {
    border: 1px solid color-mix(in oklab, var(--primary) 25%, transparent);
    box-shadow: 0 0 0 14px color-mix(in oklab, var(--primary) 6%, transparent);
    animation: try-breathe 3.2s ease-in-out infinite;
  }
  @keyframes try-breathe {
    50% {
      box-shadow: 0 0 0 22px color-mix(in oklab, var(--primary) 3%, transparent);
    }
  }

  /* Free Resources: soft vertical rules between the numbers, fading at both
     ends like xmind's, drawn only where a column has a neighbour. */
  .free-stat + .free-stat::before {
    content: '';
    position: absolute;
    top: 10%;
    bottom: 10%;
    left: 0;
    width: 1px;
    background: linear-gradient(transparent, var(--border-strong), transparent);
  }
  .free-stats .free-stat:nth-child(2n + 1)::before {
    display: none;
  }
  @media (min-width: 1024px) {
    .free-stats .free-stat:nth-child(2n + 1)::before {
      display: block;
    }
    .free-stats .free-stat:nth-child(3n + 1)::before {
      display: none;
    }
  }

  /* The record wall drifts, row against row, fading out at the edges. */
  .free-marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }
  .free-track {
    animation: free-drift 60s linear infinite;
  }
  .free-track[data-direction='right'] {
    animation-direction: reverse;
  }
  .free-marquee:hover .free-track {
    animation-play-state: paused;
  }
  @keyframes free-drift {
    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }

  /* Feature badges: a shield, drawn twice — the outer copy is the border, the
     inner one inset by a pixel is the face — so the outline follows the point. */
  .feature-shield {
    clip-path: polygon(0 0, 100% 0, 100% 80%, 50% 100%, 0 80%);
  }

  /* Blocks below the fold rise in as they scroll into view. Scroll-driven, so
     no script; a browser without view timelines shows them as they are. */
  @supports (animation-timeline: view()) {
    .reveal {
      animation: hero-in linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 40%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .free-track {
      animation: none;
    }
    .free-marquee {
      overflow-x: auto;
    }
    .try-badge,
    .reveal,
    .hero-rise,
    .hero-piece,
    .hero-cursor {
      animation: none;
    }
  }
</style>
