---
import { Sparkles, FileJson, Rocket, ShieldCheck, OctagonAlert, Webhook, Terminal, Play, Check, Loader, ArrowRight, ArrowLeft, ArrowUpRight, MousePointer2, Bot, KeyRound } from 'lucide-astro';
// The handwritten accent in the hero headline. Latin only, and imported here so
// no other page downloads it.
import '@fontsource/sedgwick-ave/latin-400.css';
import Layout from '../layouts/Layout.astro';
import { APP_URL, CORE_URL } from '../lib/urls';
import { NAV_GROUPS } from '../lib/nav';

const publicResources = [
  { path: '/posts', count: '100 posts' },
  { path: '/comments', count: '500 comments' },
  { path: '/albums', count: '100 albums' },
  { path: '/photos', count: '5000 photos' },
  { path: '/todos', count: '200 todos' },
  { path: '/users', count: '10 users' },
];

const capabilities = [
  {
    Icon: Sparkles,
    title: 'AI-Powered Generation',
    href: '/features/ai-rest-api-generation',
    copy: 'Describe your schema in plain English. Our AI engine outputs a fully populated, relational database with production-ready endpoints.',
  },
  {
    Icon: FileJson,
    title: 'JSON-to-REST',
    href: '/use-cases/mock-apis',
    copy: 'Upload a flat JSON file. Stubbase automatically infers relationships, mounts CRUD operations, and enables nested routing.',
  },
  {
    Icon: Rocket,
    title: 'Zero-Downtime Deployments',
    href: '/features/instant-api-deployments',
    copy: 'Click "Deploy" to instantly push schema changes live without breaking existing client connections.',
  },
];
const [generation, jsonToRest, deployments] = capabilities;

// Read straight from the nav rather than restating the three spokes here: nav.ts
// is the single source of truth, so a new feature page shows up in this section
// the moment it is added there, with no second list to keep in step.
const features = NAV_GROUPS.find((group) => group.key === 'features')!;

const pipeline = [
  {
    key: 'auth',
    tint: 'var(--syntax-fn)',
    Icon: ShieldCheck,
    name: 'AuthGuard',
    copy: 'Instantly secure your endpoints. Enable Google OAuth and JWT validation without writing authentication logic.',
  },
  {
    key: 'chaos',
    tint: 'var(--syntax-num)',
    Icon: OctagonAlert,
    name: 'ChaosGuard',
    copy: 'Inject deterministic latency, error rates, and 5xx status codes to test frontend error boundaries.',
  },
  {
    key: 'webhook',
    tint: 'var(--syntax-bool)',
    Icon: Webhook,
    name: 'Webhook Proxying',
    copy: 'Securely trigger external services (Resend, Twilio) from your client-side code without exposing secret API keys.',
  },
];
---

<Layout
  nav="floating"
  title="Stubbase — The Instant Backend for Frontend & QA Teams"
  description="Generate persistent, relational REST APIs from a JSON file or AI prompt in seconds. Zero database configuration. Built for autonomous frontend development and deterministic chaos testing."
>
  {/*
    Hero, after xmind.com's: a centred two-line headline with one handwritten
    accent word, on a dot-grid canvas with pieces of a working project pinned
    around it and teammates' cursors pointing at them. The pieces are
    decoration (aria-hidden, desktop only); everything they say is also said
    in the page's own text. The H1 wording is unchanged — it is an SEO target.
    No script: the entrance and the cursors' drift are CSS, and both stop
    under prefers-reduced-motion.
  */}
  <section class="hero relative overflow-hidden">
    <div class="hero-dots pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-6 pt-16 pb-16 lg:pt-24 xl:pt-32 xl:pb-40">
      {/* Only from xl: below that the headline needs the width the pieces sit in. */}
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 mx-6 hidden xl:block">
        {/* Top left: a resource file, wired to what it becomes. */}
        <div class="hero-piece absolute top-12 left-0 w-56 [--d:0.35s]">
          <div class="rounded-xl border border-border-c bg-card">
            <div class="flex items-center gap-2 border-b border-border-c px-3 py-2 font-mono text-[11px] text-subtle">
              <FileJson class="h-3.5 w-3.5 text-primary-accent" />
              artists.json
            </div>
            <pre class="px-3 py-2.5 font-mono text-[11px] leading-relaxed text-code-fg"><span class="text-syntax-punct">[{"{"}</span>
  <span class="text-syntax-str">"id"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-num">1</span><span class="text-syntax-punct">,</span>
  <span class="text-syntax-str">"name"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-fn">"Ava Chen"</span><span class="text-syntax-punct">,</span>
  <span class="text-syntax-str">"albumIds"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-punct">[</span><span class="text-syntax-num">3</span><span class="text-syntax-punct">,</span> <span class="text-syntax-num">7</span><span class="text-syntax-punct">]</span>
<span class="text-syntax-punct">{"}"}]</span></pre>
          </div>
          <div class="ml-6 h-6 w-px border-l border-dashed border-border-strong"></div>
          <div class="ml-6 flex items-center">
            <div class="w-5 border-t border-dashed border-border-strong"></div>
            <div class="rounded-lg border border-border-c bg-muted px-3 py-2 text-xs leading-snug text-muted-foreground">
              A relational REST API,<br />live in 2 seconds
            </div>
          </div>
          <div class="hero-cursor absolute top-3 -right-20 [--c:var(--syntax-str)] [--drift:6px]">
            <MousePointer2 class="h-5 w-5 fill-current text-(--c)" />
            <span class="mt-0.5 ml-3 inline-flex items-center gap-1.5 rounded-full border border-border-c bg-card py-0.5 pr-2.5 pl-0.5 text-xs font-medium whitespace-nowrap text-(--c)">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-(--c) text-[10px] font-bold text-background">F</span>
              Frontend dev
            </span>
          </div>
        </div>

        {/* Top right: a write, and where it went. */}
        <div class="hero-piece absolute top-20 right-4 w-36 [--d:0.5s]">
          <div class="rounded-lg border border-primary-soft-border bg-primary-soft p-3">
            <p class="font-mono text-xs text-subtle">201</p>
            <p class="text-3xl font-extrabold text-foreground">POST</p>
            <p class="font-mono text-xs text-muted-foreground">/artists</p>
            <p class="font-mono text-[11px] text-subtle">[written to disk]</p>
          </div>
          <div class="ml-10 h-6 w-px bg-border-strong"></div>
          <div class="rounded-lg border border-border-c bg-muted px-3 py-2 text-xs leading-snug text-muted-foreground">
            Persistent,<br />not a mock
          </div>
          <div class="hero-cursor absolute -top-10 -left-32 flex flex-col items-end [--c:var(--syntax-num)] [--drift:-5px]">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border-c bg-card py-0.5 pr-2.5 pl-0.5 text-xs font-medium whitespace-nowrap text-(--c)">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-(--c) text-[10px] font-bold text-background">Q</span>
              QA engineer
            </span>
            <MousePointer2 class="mt-0.5 mr-1 h-5 w-5 -scale-x-100 rotate-180 fill-current text-(--c)" />
          </div>
        </div>

        {/* Bottom left: a read, with a loose curve back towards the buttons. */}
        <div class="hero-piece absolute bottom-6 left-10 flex items-end gap-2 [--d:0.65s]">
          <div class="w-32 rounded-lg border border-border-c bg-card p-3">
            <p class="font-mono text-xs text-subtle">200</p>
            <p class="text-3xl font-extrabold text-foreground">GET</p>
            <p class="font-mono text-xs text-muted-foreground">/albums</p>
            <p class="font-mono text-[11px] text-subtle">[100 records]</p>
          </div>
          <svg class="mb-6 h-14 w-24 text-border-strong" viewBox="0 0 96 56" fill="none">
            <path d="M4 48 H44 Q72 48 76 24 V10" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4" stroke-linecap="round" />
            <path d="M70 16 L76 8 L82 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        {/* Bottom right: a failure, on purpose. */}
        <div class="hero-piece absolute right-0 bottom-4 [--d:0.8s]">
          <div class="ml-auto w-fit rounded-lg border border-border-c bg-muted px-3 py-2 text-xs leading-snug text-muted-foreground">
            Deterministic<br />chaos testing
          </div>
          <div class="mr-12 ml-auto h-5 w-px bg-border-strong"></div>
          <div class="flex items-stretch gap-2">
            <div class="rounded-lg border border-border-c bg-card px-3 py-2 font-mono text-[11px] leading-relaxed">
              <span class="text-syntax-str">x-stubbase-delay</span><span class="text-syntax-punct">:</span> <span class="text-syntax-num">800</span><br />
              <span class="text-syntax-str">x-stubbase-status</span><span class="text-syntax-punct">:</span> <span class="text-syntax-num">503</span>
            </div>
            <div class="flex flex-col justify-center rounded-lg border border-border-c bg-card px-3 text-center">
              <p class="text-xl font-extrabold text-foreground">503</p>
              <p class="font-mono text-[10px] text-subtle">after 800 ms</p>
            </div>
          </div>
          <div class="hero-cursor absolute top-2 -left-24 [--c:var(--syntax-bool)] [--drift:4px]">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border-c bg-card py-0.5 pr-2.5 pl-0.5 text-xs font-medium whitespace-nowrap text-(--c)">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-(--c) text-background"><Bot class="h-3 w-3" /></span>
              AI agent
            </span>
            <MousePointer2 class="mt-0.5 ml-auto h-5 w-5 -scale-x-100 fill-current text-(--c)" />
          </div>
        </div>
      </div>

      <div class="relative mx-auto max-w-4xl text-center">
        <h1 class="hero-rise text-4xl leading-[1.08] font-extrabold tracking-tight text-foreground sm:text-5xl lg:text-6xl 2xl:text-7xl">
          The <span class="hero-accent">Instant</span> Backend{' '}<br class="hidden sm:inline" />
          for Frontend &amp; QA Teams
        </h1>
        <p class="hero-rise mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground [--d:0.1s]">
          Generate persistent, relational REST APIs from a JSON file or AI prompt in seconds. Zero
          database configuration. Built for autonomous frontend development and deterministic chaos
          testing.
        </p>

        <div class="hero-rise mt-8 flex flex-wrap items-center justify-center gap-3 [--d:0.2s]">
          {/* Two-layer buttons, as xmind's: a faint outer ring around the button itself. */}
          <a href={APP_URL} class="group rounded-2xl bg-muted-hover p-1">
            <span class="flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-base font-semibold text-primary-foreground transition-colors group-hover:bg-primary-hover">
              <span class="hero-mark h-5 w-5 bg-current" aria-hidden="true"></span>
              Generate API (Free)
            </span>
          </a>
          <a href="#free-resources" class="group rounded-2xl bg-muted-hover p-1">
            <span class="flex items-center rounded-xl border border-border-c bg-card px-5 py-2.5 text-base font-semibold text-foreground transition-colors group-hover:bg-muted">
              Use Public APIs
            </span>
          </a>
        </div>
        <p class="hero-rise mt-4 text-sm text-subtle [--d:0.3s]">
          No login required · Generate an endpoint in 2 seconds
        </p>
      </div>
    </div>

    <div class="hero-rise relative mx-auto max-w-5xl px-6 pb-20 [--d:0.4s]">
      <div class="rounded-2xl bg-muted-hover p-1.5">
        <div class="overflow-hidden rounded-xl border border-border-c bg-background p-2">
          <img
            src="/dashboard-ui.png"
            alt="Stubbase Dashboard UI"
            class="w-full rounded-lg border border-border-faint"
          />
        </div>
      </div>
    </div>
  </section>

  {/*
    Capabilities, after xmind's "Tools that think with you": a centred heading,
    then one wide card and two half cards, each with its title top left, a
    drawn slice of the product below it, and a round link to its page in the
    corner. The drawings are aria-hidden: the card's own text carries the
    claim. Each card tints itself with one syntax colour (`--tint`), so the
    three read apart without leaving the palette.
  */}
  <section>
    <div class="mx-auto max-w-6xl px-6 py-24">
      <div class="reveal mx-auto mb-12 max-w-2xl text-center">
        <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Stop Writing Boilerplate APIs</h2>
        <p class="font-medium leading-relaxed text-muted-foreground">
          Stubbase provides fully functional REST endpoints out-of-the-box, allowing frontend and
          testing teams to unblock themselves instantly.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        {/* Wide: a sentence becomes tables. */}
        <article class="bento reveal relative overflow-hidden rounded-3xl border border-border-c p-8 sm:p-10 md:col-span-2 [--tint:var(--primary)]">
          <div class="relative z-10 max-w-md">
            <h3 class="mb-3 flex items-center gap-3 text-xl font-semibold text-foreground">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary-soft text-primary-accent">
                <Sparkles class="h-4.5 w-4.5" />
              </span>
              {generation.title}
            </h3>
            <p class="leading-relaxed text-muted-foreground">{generation.copy}</p>
          </div>

          <div aria-hidden="true" class="pointer-events-none relative mt-8 mb-10 h-44 lg:mx-8 lg:-mb-16 lg:mt-10 lg:h-64">
            <div class="absolute top-0 left-0 w-64 -rotate-2 rounded-2xl border border-border-c bg-background p-4 sm:w-72">
              <p class="mb-3 flex items-center gap-2 text-xs font-medium text-subtle">
                <Sparkles class="h-3.5 w-3.5 text-primary-accent" /> AI Co-Pilot
              </p>
              <p class="text-sm leading-relaxed text-foreground">
                A music app with artists, albums and reviews. Reviews belong to an album.
              </p>
              <div class="mt-4 flex items-center justify-between">
                <span class="rounded-md bg-muted px-2 py-1 font-mono text-[11px] text-subtle">3 tables</span>
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                  <ArrowRight class="h-4 w-4" />
                </span>
              </div>
            </div>

            <svg class="absolute top-16 left-76 hidden h-16 w-28 text-border-strong lg:block" viewBox="0 0 112 64" fill="none">
              <path d="M4 8 Q56 4 70 30 T106 54" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4" stroke-linecap="round" />
              <path d="M97 52 L106 54 L102 45" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>

            <div class="absolute top-10 right-0 hidden items-start gap-4 lg:flex">
              {[
                { name: 'artists', count: 12, fields: ['id', 'name', 'country', 'createdAt'] },
                { name: 'albums', count: 30, fields: ['id', 'title', 'artistId', 'createdAt'] },
                { name: 'reviews', count: 64, fields: ['id', 'rating', 'albumId', 'createdAt'] },
              ].map((table, i) => (
                <div class={`w-40 rounded-xl border border-border-c bg-background ${i === 1 ? 'mt-10' : ''}`}>
                  <p class="flex items-center justify-between border-b border-border-c px-3 py-2 font-mono text-xs font-semibold text-foreground">
                    {table.name}
                    <span class="font-normal text-subtle">{table.count}</span>
                  </p>
                  <ul class="px-3 py-2 font-mono text-[11px] leading-6">
                    {table.fields.map((field) => (
                      <li class={field.endsWith('Id') ? 'text-syntax-fn' : 'text-muted-foreground'}>{field}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>

          <a href={generation.href} class="bento-link" aria-label={`${generation.title}: read more`}>
            <ArrowUpRight class="h-4 w-4" />
          </a>
        </article>

        {/* Half: a file becomes routes. */}
        <article class="bento reveal relative overflow-hidden rounded-3xl border border-border-c p-8 sm:p-10 [--tint:var(--syntax-fn)]">
          <h3 class="mb-3 flex items-center gap-3 text-xl font-semibold text-foreground">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-(--tint)/15 text-(--tint)">
              <FileJson class="h-4.5 w-4.5" />
            </span>
            {jsonToRest.title}
          </h3>
          <p class="leading-relaxed text-muted-foreground">{jsonToRest.copy}</p>

          <div aria-hidden="true" class="pointer-events-none relative mt-8 h-56">
            <div class="absolute top-2 left-0 hidden w-44 rotate-[-3deg] rounded-xl border border-border-c bg-background sm:block">
              <p class="flex items-center gap-2 border-b border-border-c px-3 py-2 font-mono text-[11px] text-subtle">
                <FileJson class="h-3.5 w-3.5 text-(--tint)" /> albums.json
              </p>
              <pre class="px-3 py-2 font-mono text-[11px] leading-relaxed text-code-fg"><span class="text-syntax-punct">[{"{"}</span>
  <span class="text-syntax-str">"id"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-num">3</span><span class="text-syntax-punct">,</span>
  <span class="text-syntax-str">"title"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-fn">"Neon"</span><span class="text-syntax-punct">,</span>
  <span class="text-syntax-str">"artistId"</span><span class="text-syntax-punct">:</span> <span class="text-syntax-num">1</span>
<span class="text-syntax-punct">{"}"}]</span></pre>
            </div>
            <div class="absolute top-0 right-0 w-60 rounded-xl border border-border-c bg-background p-2 sm:right-2">
              {[
                ['GET', '/albums'],
                ['GET', '/albums/3'],
                ['POST', '/albums'],
                ['PUT', '/albums/3'],
                ['DELETE', '/albums/3'],
                ['GET', '/albums?_expand=artist'],
              ].map(([method, path]) => (
                <p class="flex items-center gap-2 rounded-md px-2 py-1.5 font-mono text-[11px] text-muted-foreground">
                  <span class="w-12 shrink-0 rounded border border-border-c px-1 text-center text-[10px] text-subtle">{method}</span>
                  <span class={path.includes('_expand') ? 'text-(--tint)' : ''}>{path}</span>
                </p>
              ))}
            </div>
          </div>

          <a href={jsonToRest.href} class="bento-link" aria-label={`${jsonToRest.title}: read more`}>
            <ArrowUpRight class="h-4 w-4" />
          </a>
        </article>

        {/* Half: a staged change, then Deploy. */}
        <article class="bento reveal relative overflow-hidden rounded-3xl border border-border-c p-8 sm:p-10 [--tint:var(--syntax-bool)]">
          <h3 class="mb-3 flex items-center gap-3 text-xl font-semibold text-foreground">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-(--tint)/15 text-(--tint)">
              <Rocket class="h-4.5 w-4.5" />
            </span>
            {deployments.title}
          </h3>
          <p class="leading-relaxed text-muted-foreground">{deployments.copy}</p>

          <div aria-hidden="true" class="pointer-events-none relative mt-8 h-56">
            <div class="absolute inset-x-0 top-0 rounded-xl border border-border-c bg-background p-4 sm:inset-x-4">
              <div class="mb-3 flex items-center justify-between">
                <span class="font-mono text-xs text-subtle">acme-api</span>
                <span class="inline-flex items-center gap-1.5 rounded-md bg-primary px-2.5 py-1 text-xs font-semibold text-primary-foreground">
                  <Rocket class="h-3.5 w-3.5" /> Deploy
                </span>
              </div>
              <ul class="space-y-2 text-xs">
                <li class="flex items-center justify-between rounded-lg border border-border-c px-3 py-2">
                  <span class="font-mono text-foreground">reviews.json</span>
                  <span class="rounded bg-(--tint)/15 px-1.5 py-0.5 text-[10px] font-medium text-(--tint)">new table</span>
                </li>
                <li class="flex items-center justify-between rounded-lg border border-border-c px-3 py-2">
                  <span class="font-mono text-foreground">.env</span>
                  <span class="rounded bg-(--tint)/15 px-1.5 py-0.5 text-[10px] font-medium text-(--tint)">AUTH_ENABLED=true</span>
                </li>
                <li class="flex items-center justify-between rounded-lg border border-border-c px-3 py-2">
                  <span class="font-mono text-muted-foreground">albums.json</span>
                  <span class="flex items-center gap-1 text-[10px] text-subtle"><Check class="h-3 w-3 text-primary-accent" /> live</span>
                </li>
              </ul>
            </div>
            <div class="absolute right-0 bottom-2 rotate-2 rounded-lg border border-border-c bg-background px-3 py-2 text-xs text-muted-foreground sm:right-8">
              <span class="mr-1.5 inline-block h-2 w-2 rounded-full bg-primary"></span>
              Live — the API kept serving
            </div>
          </div>

          <a href={deployments.href} class="bento-link" aria-label={`${deployments.title}: read more`}>
            <ArrowUpRight class="h-4 w-4" />
          </a>
        </article>
      </div>
    </div>
  </section>

  {/*
    The pipeline, after xmind's "For the way you think": a row of tabs over one
    large tinted panel holding a window from the product. The tabs are radio
    buttons and CSS picks the panel through :has(), so switching needs no
    script and arrow keys move between stages. Every stage's copy is in the
    HTML whichever tab is open. The windows are aria-hidden drawings; the
    copy beside them carries the claim.
  */}
  <section class="pipeline">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <div class="reveal mx-auto mb-10 max-w-2xl text-center">
        <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">A Complete API Pipeline</h2>
        <p class="font-medium leading-relaxed text-muted-foreground">
          Every endpoint deployed on Stubbase routes through our dynamic middleware pipeline,
          controlled entirely via your dashboard.
        </p>
      </div>

      <div role="radiogroup" aria-label="Pipeline stage" class="reveal mb-6 flex flex-wrap justify-center gap-2 sm:gap-3">
        {
          pipeline.map(({ key, tint, Icon, name }, i) => (
            <label class="pipe-tab flex cursor-pointer items-center gap-2.5 rounded-xl border border-transparent bg-muted py-2 pr-4 pl-2 text-base font-medium text-muted-foreground transition-colors hover:text-foreground sm:text-lg" style={`--tint: ${tint}`}>
              <input type="radio" name="pipeline-stage" value={key} checked={i === 0} class="sr-only" />
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-(--tint)/15 text-(--tint) sm:h-9 sm:w-9">
                <Icon class="h-4.5 w-4.5" />
              </span>
              {name}
            </label>
          ))
        }
      </div>

      {/* AuthGuard */}
      <div data-stage="auth" class="pipe-panel reveal rounded-3xl p-5 sm:p-10" style="--tint: var(--syntax-fn)">
        <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[2fr_3fr] [&>*]:min-w-0">
          <div>
            <h3 class="mb-3 text-2xl font-semibold text-foreground">{pipeline[0].name}</h3>
            <p class="mb-5 leading-relaxed text-muted-foreground">{pipeline[0].copy}</p>
