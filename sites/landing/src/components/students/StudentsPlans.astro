---
// Pricing for students: the Free plan and the add-ons a Free account can buy.
// Figures are PLANS, AI_PACKS and the gift in apps/dashboard-api/server-app.ts
// and the prices /pricing shows; /pricing stays the full page, with Pro and
// structured data. Request packs are left out on purpose: they are Pro only
// (ADDONS), so offering one beside Free would sell a student something their
// account cannot use. Plans differ by request limits alone — never gate a
// feature here.
import { Check, ArrowRight, Sparkles } from 'lucide-astro';
import { APP_URL } from '../../lib/urls';

const included = [
  'Auth, sessions and verified sign-up',
  'Google and GitHub login',
  'Roles and permissions',
  'Schema validation and webhooks',
  'QA mode and chaos headers',
  'MCP with read-only SQL',
  'The AI Co-Pilot',
];

const free = [
  '10,000 requests a month',
  '5 requests a second, bursts of 20',
  '1,000 AI credits when you sign up, for 3 months',
  'Every feature, nothing held back',
];

// One AI credit pack, the smallest: one-time, any plan, valid 12 months, spent
// after the sign-up credits. "Student Starter" is this page's name for the
// Starter pack (credits_5k in AI_PACKS), not a pack of its own — the price and
// credits must stay the Starter pack's.
const pack = { name: 'Student Starter', credits: '5,000', price: '$9.99' };
---

<section>
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-6 py-24 lg:grid-cols-[5fr_7fr] [&>*]:min-w-0">
    <div class="reveal">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Free for your class projects</h2>
      <p class="mb-8 font-medium leading-relaxed text-muted-foreground">
        The Free plan has every feature, with no credit card and no trial that runs out. It covers a
        class project or a hackathon demo, and if you lean on the AI Co-Pilot, top up with a one-time
        credit pack. No subscription.
      </p>
      <ul class="grid grid-cols-1 gap-2.5 text-sm text-muted-foreground sm:grid-cols-2 lg:grid-cols-1">
        {
          included.map((item) => (
            <li class="flex items-center gap-2.5">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary-accent"><Check class="h-3.5 w-3.5" /></span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="reveal grid grid-cols-1 gap-5 sm:grid-cols-2">
      <article class="flex flex-col rounded-3xl border border-primary-soft-border-strong bg-card p-7">
        <p class="mb-4 flex items-center justify-between">
          <span class="text-lg font-semibold text-foreground">Free</span>
          <span class="rounded-full bg-primary-soft px-2.5 py-0.5 text-xs font-medium text-primary-ink">No credit card</span>
        </p>
        <p class="mb-6">
          <span class="text-4xl font-bold tracking-tight text-foreground">$0</span>
          <span class="text-sm text-subtle">/month</span>
        </p>
        <ul class="space-y-2.5 text-sm text-muted-foreground">
          {
            free.map((row) => (
              <li class="flex gap-2.5">
                <Check class="mt-0.5 h-4 w-4 shrink-0 text-primary-accent" />
                {row}
              </li>
            ))
          }
        </ul>
      </article>

      <article class="flex flex-col rounded-3xl border border-border-c bg-card p-7">
        <p class="mb-4 flex items-center gap-2">
          <Sparkles class="h-4 w-4 text-primary-accent" />
          <span class="rounded-full bg-muted px-2 py-0.5 text-[11px] font-medium text-subtle">Add-on</span>
        </p>
        <p class="mb-1 text-lg font-semibold text-foreground">{pack.name} add-on</p>
        <p class="mb-6">
          <span class="text-4xl font-bold tracking-tight text-foreground">{pack.price}</span>
          <span class="text-sm text-subtle"> once</span>
        </p>
        <ul class="space-y-2.5 text-sm text-muted-foreground">
          <li class="flex gap-2.5"><Check class="mt-0.5 h-4 w-4 shrink-0 text-primary-accent" />{pack.credits} AI credits</li>
          <li class="flex gap-2.5"><Check class="mt-0.5 h-4 w-4 shrink-0 text-primary-accent" />Works on Free</li>
          <li class="flex gap-2.5"><Check class="mt-0.5 h-4 w-4 shrink-0 text-primary-accent" />Valid 12 months</li>
          <li class="flex gap-2.5"><Check class="mt-0.5 h-4 w-4 shrink-0 text-primary-accent" />No subscription</li>
        </ul>
      </article>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-3 sm:col-span-2">
        <a href={APP_URL} class="rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary-hover">
          Start for free
        </a>
        <p class="text-sm text-muted-foreground">
          Need more requests than Free gives? That's Pro.
          <a href="/pricing" class="ml-1 inline-flex items-center gap-1 font-medium text-primary-ink hover:text-primary-ink-hover">
            See pricing <ArrowRight class="h-4 w-4" />
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
