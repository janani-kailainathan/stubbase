---
/*
  The small line drawings on the audience pages (RoleLayout): one per challenge
  and one per role card. Strokes are currentColor and accents the emerald
  tokens, so a drawing follows the theme with no second copy. Decoration only
  (aria-hidden) — the text beside each one says everything it does.
*/
export type DoodleName =
  // students
  | 'database'
  | 'frontend'
  | 'deadline'
  // frontend developers
  | 'waiting'
  | 'fixture'
  | 'states'
  // QA engineers
  | 'flaky'
  | 'unplugged'
  | 'collision'
  // AI engineers
  | 'pages'
  | 'guess'
  | 'drop'
  // indie hackers and MVPs
  | 'stack'
  | 'calendar'
  | 'bill'
  | 'lock'
  | 'key'
  // learning REST
  | 'terminal'
  | 'portfolio'
  // mock APIs
  | 'reset'
  | 'unlinked'
  | 'server'
  // role cards
  | 'browser'
  | 'bug'
  | 'rocket'
  | 'robot'
  | 'cap'
  | 'braces'
  | 'layers';

interface Props {
  name: DoodleName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 120 100"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'database' && (
    <>
      <ellipse cx="52" cy="24" rx="30" ry="9" />
      <path d="M22 24 V72 Q52 86 82 72 V24" />
      <path d="M22 40 Q52 52 82 40" />
      <path d="M22 56 Q52 68 82 56" />
      <circle cx="90" cy="74" r="14" class="fill-background stroke-primary" />
      <path d="M90 66 V74 L96 78" class="stroke-primary" />
    </>
  )}
  {name === 'frontend' && (
    <>
      <rect x="10" y="20" width="62" height="46" rx="4" />
      <path d="M4 74 H78" />
      <text x="41" y="51" text-anchor="middle" class="doodle-mono" fill="currentColor" stroke="none" font-size="16">[ ]</text>
      <path d="M76 42 Q92 40 96 30" stroke-dasharray="3 5" class="stroke-primary" />
      <circle cx="102" cy="22" r="12" class="stroke-primary" />
      <text x="102" y="28" text-anchor="middle" class="doodle-note fill-primary" stroke="none" font-size="16">?</text>
    </>
  )}
  {name === 'deadline' && (
    <>
      <circle cx="48" cy="52" r="32" />
      <path d="M48 32 V52 L62 60" />
      <path d="M30 14 L22 22 M66 14 L74 22" />
      <rect x="78" y="56" width="28" height="24" rx="4" class="fill-background stroke-primary" />
      <path d="M84 56 V48 Q92 38 100 48 V56" class="stroke-primary" />
    </>
  )}

  {/* An hourglass running beside an API that is only an outline. */}
  {name === 'waiting' && (
    <>
      <path d="M22 12 H66 M22 88 H66" />
      <path d="M27 12 Q27 38 44 50 Q61 38 61 12" />
      <path d="M27 88 Q27 62 44 50 Q61 62 61 88" />
      <path d="M35 82 Q44 70 53 82 Z" class="fill-primary stroke-primary" stroke-width="1.5" />
      <path d="M44 52 V66" stroke-dasharray="2 4" class="stroke-primary" />
      <rect x="76" y="34" width="36" height="28" rx="5" stroke-dasharray="4 4" class="stroke-primary" />
      <text x="94" y="53" text-anchor="middle" class="doodle-mono fill-primary" stroke="none" font-size="11">API</text>
    </>
  )}
  {/* A mock file with a "fake" stamp across its corner. */}
  {name === 'fixture' && (
    <>
      <path d="M22 10 H64 L80 26 V88 H22 Z" class="fill-background" />
      <path d="M64 10 V26 H80" />
      <path d="M32 42 H68 M32 54 H62 M32 66 H56" />
      <g transform="rotate(-14 88 72)">
        <rect x="66" y="60" width="46" height="24" rx="5" class="fill-background stroke-primary" />
        <text x="89" y="78" text-anchor="middle" class="doodle-note fill-primary" stroke="none" font-size="17">fake</text>
      </g>
    </>
  )}
  {/* Three screens: loading, failed, empty. */}
  {name === 'states' && (
    <>
      <rect x="4" y="24" width="34" height="44" rx="4" />
      <rect x="43" y="24" width="34" height="44" rx="4" />
      <rect x="82" y="24" width="34" height="44" rx="4" />
      <path d="M15 46 A6 6 0 1 1 21 52" class="stroke-primary" />
      <path d="M60 36 L69 54 H51 Z" />
      <path d="M60 42 V47 M60 50.5 V51" />
      <rect x="90" y="36" width="18" height="20" rx="2" stroke-dasharray="3 3" class="stroke-primary" />
      <path d="M2 80 H118" stroke-dasharray="1 7" />
    </>
  )}

  {/* Runs that pass and fail with nothing changed between them. */}
  {name === 'flaky' && (
    <>
      {[14, 37, 60, 83, 106].map((cx, i) =>
        i === 1 || i === 4 ? (
          <>
            <circle cx={cx} cy="38" r="10" />
            <path d={`M${cx - 4} 34 L${cx + 4} 42 M${cx + 4} 34 L${cx - 4} 42`} />
          </>
        ) : (
          <>
            <circle cx={cx} cy="38" r="10" class="stroke-primary" />
            <path d={`M${cx - 4.5} 38 L${cx - 1} 42 L${cx + 5} 34`} class="stroke-primary" />
          </>
        ),
      )}
      <path d="M6 78 L24 66 L42 82 L60 62 L78 80 L96 64 L114 74" />
    </>
  )}
  {/* A plug pulled out of its socket: the failure nobody can trigger. */}
  {name === 'unplugged' && (
    <>
      <rect x="14" y="40" width="26" height="22" rx="4" class="fill-background" />
      <path d="M40 46 H50 M40 56 H50" />
      <path d="M14 51 Q4 51 4 68 Q4 86 22 88" />
      <rect x="74" y="32" width="36" height="38" rx="7" class="fill-background" />
      <path d="M86 46 V54 M98 46 V54" />
      <path d="M64 26 L58 40 H66 L60 54" class="stroke-primary" />
    </>
  )}
  {/* Two tests aimed at one shared server. */}
  {name === 'collision' && (
    <>
      <rect x="40" y="34" width="40" height="46" rx="5" class="fill-background" />
      <path d="M48 46 H72 M48 58 H72" />
      <circle cx="50" cy="70" r="1.5" fill="currentColor" />
      <path d="M6 30 L34 46 M26 46 H34 V38" />
      <path d="M114 30 L86 46 M94 46 H86 V38" />
      <path d="M60 6 L63 16 L72 12 L66 20 L74 26 L64 26 L62 32 L57 25 L48 28 L53 20 L46 12 L56 15 Z" class="stroke-primary" stroke-width="2" />
      <text x="8" y="94" class="doodle-note" fill="currentColor" stroke="none" font-size="12">test A</text>
      <text x="80" y="94" class="doodle-note" fill="currentColor" stroke="none" font-size="12">test B</text>
    </>
  )}

  {name === 'browser' && (
    <>
      <rect x="12" y="14" width="92" height="70" rx="6" class="fill-background" />
      <path d="M12 30 H104" />
      <circle cx="22" cy="22" r="1.5" fill="currentColor" />
      <circle cx="30" cy="22" r="1.5" fill="currentColor" />
      <rect x="22" y="40" width="34" height="34" rx="3" class="fill-primary" />
      <path d="M66 44 H94 M66 54 H88 M66 64 H92" />
      <path d="M80 70 L80 94 L86 88 L92 98 L96 96 L90 86 L98 84 Z" class="fill-background" stroke-width="2" />
    </>
  )}
  {name === 'bug' && (
    <>
      <path d="M42 48 L28 42 M42 60 L26 60 M42 72 L28 80 M74 48 L88 42 M74 60 L90 60 M74 72 L88 80" />
      <ellipse cx="58" cy="62" rx="17" ry="23" class="fill-primary" />
      <path d="M58 42 V84" />
      <circle cx="58" cy="34" r="10" class="fill-background" />
      <path d="M53 26 L46 16 M63 26 L70 16" />
      <circle cx="94" cy="30" r="15" class="fill-background" stroke-width="3" />
      <path d="M84 41 L72 54" stroke-width="4" />
    </>
  )}
  {name === 'rocket' && (
    <>
      <path d="M50 84 Q44 96 40 100 Q56 98 64 90" class="fill-primary" />
      <path d="M88 14 Q60 18 46 46 L62 62 Q90 48 94 20 Z" class="fill-background" />
      <circle cx="74" cy="34" r="7" class="fill-primary" />
      <path d="M46 46 L32 44 L22 56 L38 58" class="fill-background" />
      <path d="M62 62 L64 76 L52 86 L50 70" class="fill-background" />
      <path d="M14 30 L22 30 M18 26 L18 34 M100 70 L108 70 M104 66 L104 74" class="stroke-primary" />
    </>
  )}
  {name === 'robot' && (
    <>
      <path d="M60 10 V22" />
      <circle cx="60" cy="8" r="4" class="fill-primary" />
      <rect x="28" y="22" width="64" height="50" rx="12" class="fill-background" />
      <circle cx="46" cy="44" r="6" class="fill-primary" />
      <circle cx="74" cy="44" r="6" class="fill-primary" />
      <path d="M46 60 H74" />
      <path d="M28 44 H20 M92 44 H100" />
      <path d="M40 72 V86 H80 V72" class="fill-background" />
    </>
  )}
  {name === 'cap' && (
    <>
      <path d="M36 46 V60 Q60 72 84 60 V46" fill="currentColor" />
      <path d="M16 38 L60 20 L104 38 L60 56 Z" fill="currentColor" />
      <path d="M60 38 L96 44 L98 70" />
      <rect x="93" y="68" width="10" height="14" rx="2" class="fill-primary" stroke-width="2" />
      <path d="M20 84 H70" class="stroke-primary" />
    </>
  )}
  {/* A stack of pages: an agent paging through REST to answer one question. */}
  {name === 'pages' && (
    <>
      <rect x="26" y="10" width="50" height="62" rx="4" class="fill-background" />
      <rect x="18" y="18" width="50" height="62" rx="4" class="fill-background" />
      <rect x="10" y="26" width="50" height="62" rx="4" class="fill-background" />
      <path d="M20 42 H50 M20 54 H46 M20 66 H48" />
      <text x="80" y="56" class="doodle-note fill-primary" stroke="none" font-size="19">×200</text>
      <path d="M74 70 Q92 88 110 72" class="stroke-primary" />
      <path d="M102 70 L110 72 L108 80" class="stroke-primary" />
    </>
  )}
  {/* A table, and a model asking which columns it has. */}
  {name === 'guess' && (
    <>
      <rect x="8" y="34" width="70" height="52" rx="4" class="fill-background" />
      <path d="M8 48 H78 M31 34 V86 M54 34 V86" />
      <path d="M8 62 H78 M8 74 H78" stroke-dasharray="2 5" />
      <circle cx="96" cy="26" r="17" class="fill-background stroke-primary" />
      <path d="M86 40 L80 50 L92 42" class="stroke-primary" />
      <text x="96" y="33" text-anchor="middle" class="doodle-note fill-primary" stroke="none" font-size="20">?</text>
    </>
  )}
  {/* A database with a destructive statement stamped across it. */}
  {name === 'drop' && (
    <>
      <ellipse cx="44" cy="22" rx="28" ry="8" />
      <path d="M16 22 V74 Q44 88 72 74 V22" class="fill-background" />
      <path d="M16 40 Q44 52 72 40 M16 58 Q44 70 72 58" />
      <g transform="rotate(-12 82 60)">
        <rect x="56" y="48" width="56" height="24" rx="5" class="fill-background stroke-primary" />
        <text x="84" y="65" text-anchor="middle" class="doodle-mono fill-primary" stroke="none" font-size="12">DROP</text>
      </g>
    </>
  )}

  {/* The infrastructure phase: a database, an ORM and auth, piled up. */}
  {name === 'stack' && (
    <>
      <rect x="18" y="64" width="70" height="22" rx="4" class="fill-background" />
      <rect x="24" y="40" width="58" height="22" rx="4" class="fill-background" />
      <rect x="30" y="16" width="46" height="22" rx="4" class="fill-background" />
      <text x="53" y="79" text-anchor="middle" class="doodle-mono" fill="currentColor" stroke="none" font-size="10">database</text>
      <text x="53" y="55" text-anchor="middle" class="doodle-mono" fill="currentColor" stroke="none" font-size="10">ORM</text>
      <text x="53" y="31" text-anchor="middle" class="doodle-mono" fill="currentColor" stroke="none" font-size="10">auth</text>
      <path d="M100 30 V46 M92 38 H108" class="stroke-primary" />
      <path d="M100 62 V78 M92 70 H108" class="stroke-primary" />
    </>
  )}
  {/* A weekend, crossed off. */}
  {name === 'calendar' && (
    <>
      <rect x="14" y="20" width="74" height="66" rx="6" class="fill-background" />
      <path d="M14 36 H88 M34 12 V26 M68 12 V26" />
      <text x="32" y="58" text-anchor="middle" class="doodle-mono" fill="currentColor" stroke="none" font-size="10">SAT</text>
      <text x="70" y="58" text-anchor="middle" class="doodle-mono" fill="currentColor" stroke="none" font-size="10">SUN</text>
      <path d="M22 66 L42 80 M42 66 L22 80 M60 66 L80 80 M80 66 L60 80" class="stroke-primary" />
      <circle cx="104" cy="70" r="12" />
      <path d="M104 62 V70 L110 74" />
    </>
  )}
  {/* A bill that keeps running overnight. */}
  {name === 'bill' && (
    <>
      <path d="M26 10 H78 V86 L71 80 L64 86 L57 80 L50 86 L43 80 L36 86 L26 80 Z" class="fill-background" />
      <path d="M36 28 H68 M36 40 H62 M36 52 H66" />
      <text x="52" y="74" text-anchor="middle" class="doodle-note" fill="currentColor" stroke="none" font-size="18">$$$</text>
      <path d="M100 18 A14 14 0 1 0 112 40 A11 11 0 1 1 100 18 Z" class="stroke-primary" />
    </>
  )}
  {/* A record with a lock on it. */}
  {name === 'lock' && (
    <>
      <rect x="12" y="18" width="62" height="68" rx="5" class="fill-background" />
      <path d="M22 34 H62 M22 46 H56 M22 58 H60" />
      <text x="22" y="76" class="doodle-mono" fill="currentColor" stroke="none" font-size="9">userId</text>
      <path d="M80 58 V48 Q90 34 100 48 V58" class="stroke-primary" />
      <rect x="74" y="58" width="32" height="26" rx="4" class="fill-primary" />
      <path d="M90 68 V74" />
    </>
  )}
  {/* A secret key hanging out of a browser window. */}
  {name === 'key' && (
    <>
      <rect x="8" y="16" width="72" height="58" rx="5" class="fill-background" />
      <path d="M8 30 H80" />
      <circle cx="17" cy="23" r="1.5" fill="currentColor" />
      <circle cx="25" cy="23" r="1.5" fill="currentColor" />
      <circle cx="96" cy="58" r="12" class="fill-background stroke-primary" />
      <path d="M86 64 L52 84 M60 79 L56 72 M68 74 L64 68" class="stroke-primary" />
      <text x="18" y="52" class="doodle-mono" fill="currentColor" stroke="none" font-size="9">sk_live_…</text>
    </>
  )}

  {/* An install that failed in the terminal. */}
  {name === 'terminal' && (
    <>
      <rect x="8" y="16" width="86" height="64" rx="6" class="fill-background" />
      <path d="M8 30 H94" />
      <text x="16" y="48" class="doodle-mono" fill="currentColor" stroke="none" font-size="9">$ install db</text>
      <text x="16" y="64" class="doodle-mono fill-primary" stroke="none" font-size="9">ERR! port 5432</text>
      <circle cx="102" cy="76" r="12" class="fill-background stroke-primary" />
      <path d="M102 70 V77 M102 81 V81.5" class="stroke-primary" />
    </>
  )}
  {/* A portfolio folder with nothing in it yet. */}
  {name === 'portfolio' && (
    <>
      <path d="M10 26 H42 L50 34 H104 V84 H10 Z" class="fill-background" />
      <rect x="30" y="46" width="54" height="28" rx="3" stroke-dasharray="4 4" class="stroke-primary" />
      <text x="57" y="64" text-anchor="middle" class="doodle-note fill-primary" stroke="none" font-size="13">demo?</text>
    </>
  )}

  {/* A mock whose data goes back to the start. */}
  {name === 'reset' && (
    <>
      <rect x="36" y="30" width="44" height="42" rx="4" class="fill-background" />
      <text x="58" y="57" text-anchor="middle" class="doodle-mono" fill="currentColor" stroke="none" font-size="14">{'{ }'}</text>
      <path d="M96 30 A40 40 0 1 0 100 62" class="stroke-primary" />
      <path d="M88 26 L97 30 L95 40" class="stroke-primary" />
    </>
  )}
  {/* Two records that should point at each other, and a broken link. */}
  {name === 'unlinked' && (
    <>
      <rect x="6" y="26" width="40" height="48" rx="4" class="fill-background" />
      <rect x="74" y="26" width="40" height="48" rx="4" class="fill-background" />
      <path d="M14 40 H38 M14 52 H32 M82 40 H106 M82 52 H100" />
      <rect x="44" y="45" width="14" height="10" rx="5" />
      <rect x="62" y="45" width="14" height="10" rx="5" />
      <path d="M58 34 L62 40 M60 66 L56 60" class="stroke-primary" />
    </>
  )}
  {/* A mock server, and the wrench it keeps needing. */}
  {name === 'server' && (
    <>
      <rect x="14" y="18" width="62" height="28" rx="4" class="fill-background" />
      <rect x="14" y="52" width="62" height="28" rx="4" class="fill-background" />
      <circle cx="26" cy="32" r="2" fill="currentColor" />
      <circle cx="26" cy="66" r="2" fill="currentColor" />
      <path d="M38 32 H64 M38 66 H64" />
      <circle cx="92" cy="40" r="10" class="stroke-primary" />
      <path d="M99 47 L112 84" class="stroke-primary" stroke-width="4" />
    </>
  )}

  {name === 'braces' && (
    <>
      <rect x="14" y="14" width="92" height="72" rx="8" class="fill-background" />
      <text x="60" y="62" text-anchor="middle" class="doodle-mono fill-primary" stroke="none" font-size="34">{'{ }'}</text>
      <path d="M26 26 H44" />
    </>
  )}
  {name === 'layers' && (
    <>
      <path d="M16 66 L60 86 L104 66" />
      <path d="M16 52 L60 72 L104 52" />
      <path d="M60 18 L104 38 L60 58 L16 38 Z" class="fill-primary" />
    </>
  )}
</svg>
