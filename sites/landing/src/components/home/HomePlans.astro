---
// Plans, in brief. Figures are PLANS in apps/dashboard-api/server-app.ts and
// the prices /pricing shows; /pricing stays the full page, with packs and
// structured data. Plans differ by request limits alone, so the list of what
// is included is the same for both — never gate a feature here.
import { Check, ArrowRight } from 'lucide-astro';

interface Card {
  name: string;
  price: string;
  /** A struck-through price before `price`, for something given away; with
   *  an empty `price` it stands alone, at full size. */
  was?: string;
  per: string;
  /** A row is a line with a tick; `note` adds a quieter line under it, without one. */
  rows: (string | { text: string; note: string })[];
  featured: boolean;
  badge?: string;
}

interface Props {
  /** Another page sharing this section may reword it for its readers: the
   *  heading, the line under it, the included list and the cards. The figures
   *  must still be PLANS', ADDONS' and AI_PACKS'. */
  title?: string;
  lead?: string;
  included?: string[];
  cards?: Card[];
  /** Align the text with the top of the cards rather than their middle. */
  alignTop?: boolean;
  /** Leave out the line under the cards. */
  hideMore?: boolean;
}

const defaultIncluded = [
  'Auth, sessions and verified sign-up',
  'Google and GitHub login',
  'Roles and permissions',
  'Schema validation and webhooks',
  'QA mode and chaos headers',
  'MCP with read-only SQL',
  'The AI Co-Pilot',
];

const {
  title = 'Every feature on every plan',
  lead = 'Plans differ in requests alone: a monthly allowance and a per-second rate, shared by all your projects. Nothing you switch on in a project is held back.',
  included = defaultIncluded,
} = Astro.props;

const defaultCards: Card[] = [
  {
    name: 'Free',
    price: '$0',
    per: '',
    rows: ['10,000 requests a month', '5 requests a second, bursts of 20', '1,000 AI credits when you sign up'],
    featured: false,
  },
  {
    name: 'Pro',
    price: '$29',
    per: '/month',
    rows: ['250,000 requests a month', '50 requests a second, bursts of 150', '5,000 AI credits every month', 'Request packs when you need more'],
    featured: true,
    badge: 'Most Popular',
  },
];
const plans = Astro.props.cards ?? defaultCards;
---

<section>
  <div class:list={["mx-auto grid max-w-6xl grid-cols-1 gap-12 px-6 py-24 lg:grid-cols-[5fr_7fr] [&>*]:min-w-0", Astro.props.alignTop ? "items-start" : "items-center"]}>
    <div class="reveal">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{title}</h2>
      <p class={`font-medium leading-relaxed text-muted-foreground ${included.length > 0 ? 'mb-8' : ''}`}>{lead}</p>
      {included.length > 0 && (
        <ul class="grid grid-cols-1 gap-2.5 text-sm text-muted-foreground sm:grid-cols-2 lg:grid-cols-1">
          {
            included.map((item) => (
              <li class="flex items-center gap-2.5">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary-accent"><Check class="h-3.5 w-3.5" /></span>
                {item}
              </li>
            ))
          }
        </ul>
      )}
    </div>

    <div class="reveal grid grid-cols-1 gap-5 sm:grid-cols-2">
      {
        plans.map((plan) => (
          <article class={`flex flex-col rounded-3xl border p-7 ${plan.featured ? 'border-primary-soft-border-strong bg-card' : 'border-border-c bg-card'}`}>
            <p class="mb-4 flex items-center justify-between">
              <span class="text-lg font-semibold text-foreground">{plan.name}</span>
              {plan.badge && <span class="rounded-full bg-primary-soft px-2.5 py-0.5 text-xs font-medium text-primary-ink">{plan.badge}</span>}
            </p>
            <p class="mb-6">
              {plan.was && <s class={plan.price ? 'mr-1.5 text-xl font-semibold text-subtle' : 'text-4xl font-bold tracking-tight text-subtle'}>{plan.was}</s>}
              {plan.price && <span class="text-4xl font-bold tracking-tight text-foreground">{plan.price}</span>}
              {plan.per && <span class="text-sm text-subtle">{plan.per}</span>}
            </p>
            <ul class="space-y-2.5 text-sm text-muted-foreground">
              {plan.rows.map((row) => (
                <li class="flex gap-2.5">
                  <Check class="mt-0.5 h-4 w-4 shrink-0 text-primary-accent" />
                  {typeof row === 'string' ? row : (
                    <span>
                      {row.text}
                      <span class="block text-subtle">{row.note}</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
      {!Astro.props.hideMore && (
        <p class="text-sm text-muted-foreground sm:col-span-2">
          Need more than Pro? <a href="/contact" class="font-medium text-primary-ink hover:text-primary-ink-hover">Enterprise is a conversation</a>.
          <a href="/pricing" class="ml-2 inline-flex items-center gap-1 font-medium text-primary-ink hover:text-primary-ink-hover">
            See pricing <ArrowRight class="h-4 w-4" />
          </a>
        </p>
      )}
    </div>
  </div>
</section>
