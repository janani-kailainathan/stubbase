---
// "Query it like a real backend", after xmind.com/ai's "Edit and refine with
// AI": a stack of expanding items on the left, one large preview on the right
// that follows whichever is open. The items are <details name="query">, so the
// browser keeps one open at a time, and CSS picks the preview through :has() —
// no script. Every request and response below is the real shape: ids are
// UUIDs, timestamps are server-set, and the spec header is what the core writes.
import { Filter, ArrowDownWideNarrow, ListOrdered, Link2, Clock, FileCode2, ChevronDown } from 'lucide-astro';

type Json = null | boolean | number | string | Json[] | { [key: string]: Json };

interface Item {
  key: string;
  Icon: typeof Filter;
  title: string;
  body: string;
  method: 'GET' | 'POST';
  url: string;
  sent?: Json;
  status: number;
  headers?: [string, string][];
  response: Json | string;
}

const items: Item[] = [
  {
    key: 'filter',
    Icon: Filter,
    title: 'Filter by any field',
    body: 'field=value is an exact match. Brackets add operators: contains ignores case and accents, and gt, gte, lt and lte compare numbers and dates. A misspelt operator is a 400, never silently ignored.',
    method: 'GET',
    url: '/acme/products?brand[contains]=sams&price[gte]=100',
    status: 200,
    response: [
      { id: 'a41c…', brand: 'Samsung', model: 'Galaxy S24', price: 799 },
      { id: '0b7e…', brand: 'Samsung', model: 'Galaxy A55', price: 449 },
    ],
  },
  {
    key: 'sort',
    Icon: ArrowDownWideNarrow,
    title: 'Sort, newest first',
    body: '_sort takes any field, and created or updated sort by the timestamps Stubbase keeps for you. _direction is asc or desc, one per field or one for all.',
    method: 'GET',
    url: '/acme/posts?_sort=created',
    status: 200,
    response: [
      { id: '9d2f…', title: 'Launch notes', createdAt: '2026-09-26T09:14:00.000Z' },
      { id: '5c80…', title: 'Changelog', createdAt: '2026-09-24T16:02:00.000Z' },
    ],
  },
  {
    key: 'page',
    Icon: ListOrdered,
    title: 'Pages and totals',
    body: '_page and _limit page through a list, _offset counts raw rows, and the X-Total-Count header carries the total before paging.',
    method: 'GET',
    url: '/acme/posts?_page=2&_limit=10',
    status: 200,
    headers: [['x-total-count', '100']],
    response: '[ …records 11 to 20… ]',
  },
  {
    key: 'expand',
    Icon: Link2,
    title: 'Relations with _expand',
    body: 'Name a field userId and _expand=users nests the whole user inside the record. One request, instead of one per row.',
    method: 'GET',
    url: '/acme/posts/1?_expand=users',
    status: 200,
    response: { id: '1', title: 'Hello world', userId: '7', user: { id: '7', name: 'Ada', email: 'ada@example.com' } },
  },
  {
    key: 'time',
    Icon: Clock,
    title: 'Server-owned timestamps',
    body: 'Every write through your API sets createdAt and updatedAt, and replaces whatever the client sent for them, so an echoed record can never freeze updatedAt.',
    method: 'POST',
    url: '/acme/posts',
    sent: { title: 'Draft', updatedAt: '2020-01-01' },
    status: 201,
    response: { id: '3f9c…', title: 'Draft', createdAt: '2026-09-27T10:02:11.000Z', updatedAt: '2026-09-27T10:02:11.000Z' },
  },
  {
    key: 'openapi',
    Icon: FileCode2,
    title: 'An OpenAPI spec, generated',
    body: 'GET /<project>/openapi.json describes every deployed resource as OpenAPI 3.0, ready for Swagger UI, Postman or a client generator.',
    method: 'GET',
    url: '/acme/openapi.json',
    status: 200,
    response: {
      openapi: '3.0.3',
      info: { title: 'acme API', description: 'Auto-generated by Stubbase', version: '1.0.0' },
      paths: { '/posts': { get: '…', post: '…' }, '/posts/{id}': { get: '…', put: '…', delete: '…' } },
    },
  },
];

// Build-time highlighting for the static previews, in the same colours the
// Try it live runner uses. The input is our own literals, never user data.
const escape = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
function highlight(value: Json | string): string {
  if (typeof value === 'string' && value.startsWith('[ …')) return `<span class="text-subtle">${escape(value)}</span>`;
  const json = escape(JSON.stringify(value, null, 2));
  return json.replace(
    /("(?:\\.|[^\\"])*")(\s*:)?|\b(true|false|null)\b|(-?\d+(?:\.\d+)?)|([{}[\],])/g,
    (match, str, colon, bool, num, punct) => {
      if (str) return `<span class="${colon ? 'text-syntax-str' : 'text-syntax-fn'}">${str}</span>${colon ?? ''}`;
      if (bool) return `<span class="text-syntax-bool">${bool}</span>`;
      if (num) return `<span class="text-syntax-num">${num}</span>`;
      if (punct) return `<span class="text-syntax-punct">${punct}</span>`;
      return match;
    },
  );
}
---

<section class="query bg-section">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="reveal mx-auto mb-12 max-w-2xl text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Query it like a real backend</h2>
      <p class="font-medium leading-relaxed text-muted-foreground">
        Filters, sorting, pages and relations work on every resource from its first request.
        Nothing to switch on, and they all combine.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-[5fr_7fr] [&>*]:min-w-0">
      <div class="reveal space-y-3">
        {
          items.map(({ key, Icon, title, body }, i) => (
            <details name="query" data-q={key} open={i === 0} class="q-item group rounded-2xl border border-border-c bg-background">
              <summary class="flex cursor-pointer list-none items-center gap-3 px-5 py-4 [&::-webkit-details-marker]:hidden">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-muted text-muted-foreground transition-colors group-open:bg-primary-soft group-open:text-primary-accent">
                  <Icon class="h-4 w-4" />
                </span>
                <span class="flex-1 font-semibold text-muted-foreground transition-colors group-open:text-foreground">{title}</span>
                <ChevronDown class="h-4 w-4 text-subtle transition-transform group-open:rotate-180" />
              </summary>
              <p class="px-5 pb-5 pl-16 text-sm leading-relaxed text-muted-foreground">{body}</p>
            </details>
          ))
        }
      </div>

      <div aria-hidden="true" class="reveal q-stage relative min-h-[26rem] overflow-hidden rounded-3xl border border-border-c bg-code-bg">
        {
          items.map(({ key, method, url, sent, status, headers, response }) => (
            <div class="q-preview absolute inset-0 flex flex-col" data-q={key}>
              <div class="flex items-center gap-3 border-b border-border-c bg-chrome px-5 py-3.5 font-mono text-xs">
                <span class="rounded border border-border-c px-1.5 py-0.5 text-[10px] font-semibold text-subtle">{method}</span>
                <span class="truncate text-emphasis">{url}</span>
              </div>
              {sent !== undefined && (
                <pre class="border-b border-border-c px-5 py-3 font-mono text-xs leading-relaxed" set:html={`<span class="text-subtle">body </span>${highlight(sent)}`} />
              )}
              <div class="flex items-center gap-3 px-5 pt-4 font-mono text-xs">
                <span class="font-semibold text-primary-ink">{status}</span>
                {headers?.map(([name, value]) => (
                  <span class="text-subtle">
                    {name}: <span class="text-syntax-num">{value}</span>
                  </span>
                ))}
              </div>
              <pre class="flex-1 overflow-hidden px-5 py-3 font-mono text-xs leading-relaxed text-code-fg" set:html={highlight(response)} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
