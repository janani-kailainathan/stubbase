---
import { CORE_URL } from '../lib/urls';
import { NAV_GROUPS, RESOURCE_LINKS, LEGAL_LINKS } from '../lib/nav';

const [solutions, features, compare] = NAV_GROUPS;

// Product merges the Solutions and Features spokes into one column.
const productLinks = [...solutions.links, ...features.links];

// "OpenAPI Docs" points at a real, live endpoint: every tenant (including the
// seeded `public` demo) serves GET /<tenant>/openapi.json from the core engine.
const resourceLinks = [
  ...RESOURCE_LINKS,
  { href: `${CORE_URL}/public/openapi.json`, label: 'OpenAPI Docs' },
];

const columns = [
  { heading: 'Product', links: productLinks },
  { heading: 'Compare', links: compare.links },
  { heading: 'Resources', links: resourceLinks },
];
---

<footer class="border-t border-zinc-800 bg-zinc-950">
  <div class="mx-auto max-w-7xl px-6 py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <img src="/stubbase-logo-text-dark.png" alt="Stubbase" class="mb-4 h-7" />
        <p class="max-w-xs text-sm leading-relaxed text-zinc-500">
          Stubbase is a zero-config, instant backend engine. Generate persistent, relational REST
          APIs via JSON or AI to unblock frontend development and deterministic QA testing.
        </p>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.heading}>
            <p class="mb-4 text-xs font-semibold tracking-wide text-zinc-500 uppercase">
              {column.heading}
            </p>
            <ul class="space-y-3">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-zinc-400 transition-colors hover:text-zinc-50"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-zinc-800 pt-8"
    >
      <p class="text-sm text-zinc-500">© 2026 Stubbase. stubbase.dev</p>
      <nav class="flex flex-wrap gap-6" aria-label="Legal">
        <a href="/" class="text-sm text-zinc-400 transition-colors hover:text-zinc-50">Home</a>
        <a href="/pricing" class="text-sm text-zinc-400 transition-colors hover:text-zinc-50">
          Pricing
        </a>
        {
          LEGAL_LINKS.map((link) => (
            <a href={link.href} class="text-sm text-zinc-400 transition-colors hover:text-zinc-50">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
