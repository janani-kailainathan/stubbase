# Loaded by `bun run build:docker` (astro build --mode docker) — the local
# Caddy stack from docker-compose.
PUBLIC_APP_URL=http://app.stubbase.localhost
PUBLIC_CORE_URL=http://api.stubbase.localhost

# One Tap is deliberately unset here: Google requires HTTPS for any JavaScript
# origin outside localhost/127.0.0.1, and this stack is http://*.localhost, so
# the prompt cannot render. Home renders without it.
PUBLIC_GOOGLE_CLIENT_ID=
