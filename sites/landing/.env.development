# Loaded only by the Astro dev server (mode=development) — production and
# `build:docker` builds never see it. Ports are owned by scripts/dev.ts.

# "Log in" / "Go to Dashboard" reach the local dashboard dev server.
PUBLIC_APP_URL=http://localhost:5173
# The Home "Try it live" runner fetches <this>/public/users/1 from the local
# core (cross-origin, allowed by the public plane's `Access-Control-Allow-Origin: *`).
PUBLIC_CORE_URL=http://127.0.0.1:3000
