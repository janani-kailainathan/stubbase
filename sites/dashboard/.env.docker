# Loaded by `bun run build:docker` (vite build --mode docker) — the local
# Caddy stack from docker-compose. CORE_PUBLIC_URL (display) defaults to
# CORE_API_URL when absolute, so it needs no entry here.
VITE_APP_API_URL=http://api.app.stubbase.localhost
VITE_CORE_API_URL=http://api.stubbase.localhost
VITE_LANDING_URL=http://stubbase.localhost
