# Loaded only by the Vite dev server (mode=development) — production and
# `build:docker` builds never see it. Ports are owned by scripts/dev.ts.
#
# VITE_APP_API_URL / VITE_CORE_API_URL are deliberately left unset: in dev they
# fall back to the same-origin /api/app and /api/core proxy paths (vite.config.ts),
# which is what keeps dev CORS-free.

# Link back to the marketing site from the auth pages.
VITE_LANDING_URL=http://localhost:4321
# Display-only base for endpoint docs / curl samples, so they're copy-paste-able
# against the local core instead of showing https://api.stubbase.dev.
VITE_CORE_PUBLIC_URL=http://127.0.0.1:3000
