# Managed by Ansible — do not edit by hand.
ADMIN_SECRET={{ admin_secret }}
{% if dashboard_google_client_id and dashboard_google_secret %}
DASHBOARD_GOOGLE_CLIENT_ID={{ dashboard_google_client_id }}
DASHBOARD_GOOGLE_SECRET={{ dashboard_google_secret }}
{% endif %}
{% if dashboard_github_client_id and dashboard_github_secret %}
DASHBOARD_GITHUB_CLIENT_ID={{ dashboard_github_client_id }}
DASHBOARD_GITHUB_SECRET={{ dashboard_github_secret }}
{% endif %}
{% if dashboard_resend_api_key %}
DASHBOARD_RESEND_API_KEY={{ dashboard_resend_api_key }}
{% endif %}
{% if dashboard_email_from %}
DASHBOARD_EMAIL_FROM={{ dashboard_email_from }}
{% endif %}
