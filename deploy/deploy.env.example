# Production deploy settings for deploy/deploy.yml. Copy to deploy/deploy.env
# (gitignored), fill it in, and keep it private:
#   set -a; source deploy/deploy.env; set +a
#   bun run scripts/build.ts
#   cd deploy && ansible-playbook -i inventory.ini deploy.yml

# Required. Generate once (openssl rand -hex 32) and keep it the same on every
# deploy: it signs project logins and keys reset codes and deleted-account
# links, so a new value signs everyone out and orphans those.
STUBBASE_ADMIN_SECRET=''

# AI Co-Pilot on Gemini Enterprise Agent Platform (formerly Vertex AI).
# Optional: without a project the Co-Pilot answers 503. The key file is a
# service-account JSON key (role: Agent Platform User) on the machine running
# Ansible, which copies it to /etc/stubbase/vertex-sa.json.
STUBBASE_VERTEX_PROJECT_ID=''
STUBBASE_VERTEX_CREDENTIALS_FILE=''
STUBBASE_VERTEX_LOCATION='global'

# Optional: "Sign in with Google" and One Tap. One web OAuth client, with the
# origin https://stubbase.dev and the redirect
# https://api.app.stubbase.dev/auth/google/callback.
STUBBASE_GOOGLE_CLIENT_ID=''
STUBBASE_GOOGLE_SECRET=''
# Read by the landing build (One Tap): the same client id.
PUBLIC_GOOGLE_CLIENT_ID=''

# Optional: "Sign in with GitHub". A production GitHub OAuth app, callback
# https://api.app.stubbase.dev/auth/github/callback.
STUBBASE_GITHUB_CLIENT_ID=''
STUBBASE_GITHUB_SECRET=''

# Stubbase's own email: sign-up codes and password resets. Without the key,
# password sign-up answers 503. The from address's domain must be verified
# in Resend; unset means "Stubbase <no-reply@notify.stubbase.dev>".
STUBBASE_RESEND_API_KEY=''
STUBBASE_EMAIL_FROM=''
