[Unit]
Description=Stubbase Dashboard Backend (auth/projects/billing, port 3001)
After=network-online.target stubbase-core.service
Wants=network-online.target

[Service]
Type=exec
User=stubbase
Group=stubbase
WorkingDirectory=/opt/stubbase/app
ExecStart=/usr/local/bin/bun run server-app.ts
EnvironmentFile=/etc/stubbase/stubbase.env
Environment=PORT=3001
Environment=CORE_API_URL=http://127.0.0.1:3000
Environment=DB_PATH=/var/lib/stubbase/app.sqlite
Restart=always
RestartSec=2

# ── Memory guardrails (sized for the 4GB CX23) ──
# Headroom for concurrent sign-ups (each argon2 hash takes ~19 MiB), the
# Co-Pilot's agent loop and the blocked-domains table; see the core unit
# for how the 4GB is split.
MemoryMax=768M
MemoryHigh=640M

# ── Sandboxing ──
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# The only path the backend may write: its SQLite database (+ WAL/SHM files)
ReadWritePaths=/var/lib/stubbase

[Install]
WantedBy=multi-user.target
