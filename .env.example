# Copy to .env (gitignored) and fill in. docker compose reads .env automatically.
#
# Google AI Studio key for the dashboard's AI Co-Pilot. Leave unset to run the
# stack with AI disabled — the service still boots and the route answers 503.
GOOGLE_AI_API_KEY=

# Model string, with or without the "models/" prefix.
#
# The Co-Pilot is an agent: it answers by calling tools (staging schemas,
# reading logs, deploying), so the model MUST support function calling.
#   models/gemini-3.5-flash-lite — the default; fast, and calls tools reliably
#   models/gemma-*               — no function-calling support: the Co-Pilot
#                                  would describe actions instead of taking them
AI_MODEL_NAME=models/gemini-3.5-flash-lite

# Per-provider-call timeout, ms. One chat turn makes several calls when tools run.
AI_TIMEOUT_MS=120000

# ── Dashboard sign-in with Google / GitHub (optional) ───────────────
#
# Stubbase's *own* OAuth apps — these sign people in to the dashboard. A
# project's end-user OAuth is a separate thing, configured per project in its
# .env editor (AUTH_GOOGLE_* / AUTH_GITHUB_*), and never comes from here.
#
# Leave a pair unset and that button simply never appears on the login page.
# Register these redirect URIs with the provider:
#   docker stack : http://api.app.stubbase.localhost/auth/<provider>/callback
#   bun run dev  : http://localhost:5173/api/app/auth/<provider>/callback
DASHBOARD_GOOGLE_CLIENT_ID=
DASHBOARD_GOOGLE_SECRET=
DASHBOARD_GITHUB_CLIENT_ID=
DASHBOARD_GITHUB_SECRET=
